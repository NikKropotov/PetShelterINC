INSERT INTO `found_pet` VALUES (1,'Палевый','4 года','Мужской','-не уточнено-','2021-05-12 15:20:33.000000','Москва','09.08.2019 нашли собаку около 1 часа ночи по адресу метро Коммунарка, улица Ясная, 5. Лабрадор. На вид около 2-3 лет, зубы хорошие, на шее видны замятины от ошейника. Собака спокойная, ни разу не лаял','yuliaan_dr@mail.ru','Юлия','+7-963-926-63-31','Крупный','Бигги','Найдено','Found_Pets_images/1-Бигги/Бигги-t_biggi_0_5d4e77a9d5089.jpg','Лабрадор',2),(2,'Рыжий','3 года','Мужской','-не уточнено-','2021-05-12 15:56:23.000000','Электросталь, М.о.','Метис алабая, чуть больше года, привит, обработан от паразитов.\r\nМалыш пристраивается в Москву и МО, частный дом (возможно проживание в утеплённом вольере), по договору ответствен','Ksuxamadgirl@mail.ru','Наталья','+7-985-448-59-45','Крупный','Норд','Найдено','Found_Pets_images/2-Норд/Норд-nord_0_5c52c9aaaa3da.jpg','Алабай',NULL),(3,'Коричневый','1 год','Мужской','-не уточнено-','2021-05-12 15:59:43.000000','Москва','Найден кобель хаски в Донском сквере (метро Ленинский проспект, Шаболовская). Подросток, на вид 6-7 месяцев, весит 18 кг, чип и клеймо не найдены. Чистый, знает команды \"сидеть\" и \"дай лапу\".','fox11september@rambler.ru','Олеся','+7-916-248-86-90','Крупный','Подросток хаски','Найдено','Found_Pets_images/3-Подросток хаски/Подросток_хаски-podrostok-khaski_0_5f4ad71640d43.jpg','Хаски',2),(4,'Белый','6 месяцев','Женский','-не уточнено-','2021-05-12 16:01:40.000000','Ростов-на-Дону','Ростов-на-Дону\r\nЗЖМ. Отдадим в хорошие руки. Сучка, щенок. В еде не прихотлива, очень дружелюбная. Вырастет, думаю, чуть меньше овчарки. Отдаём, т.к. завезли пару недель назад в наш СНТ, привязалась к нам. Если на улице оставить - ее отравят, это практикуется(( она белоснежная, уже знает пару команд. По всем вопросам пишите, звоните, очень хочется найти ей хороший дом.','rande8@ya.ru','Елена','+7-961-423-11-89','Средний','Букля','Найдено','Found_Pets_images/4-Букля/Букля-buklya_0_6079d7afcf054.jpeg','Беспородная',1),(5,'Черный','7 лет','Мужской','-не уточнено-','2021-05-12 16:03:39.000000','Москва','','marrycloser@gmail.com','Мария','+7-909-903-52-85','Средний','Неизвестно','Найдено','Found_Pets_images/5-Неизвестно/Неизвестно-neizvestno_0_5e8288de05da6.jpg','Беспородная',2),(6,'Белый','2 года','Женский','-не уточнено-','2021-05-12 16:05:05.000000','Москва','Готова привезти собаку к вам, в пределах Москвы. Татьяна, 89145498503 (смс, звонки, вотсап- предпочтительней). Хозяин, найдись!','tatianabrindas@gmail.com','Татьяна','+7-914-549-85-03','Средний','Малышка','Найдено','Found_Pets_images/6-Малышка/Малышка-malyshka_0_5b98eb1bbac40.jpeg','Беспородная',1),(7,'Палевый','7 месяцев','Женский','-не уточнено-','2021-05-13 17:54:16.000000','Мытищи','Девочка, метис лайки! Около 4х месяцев. Очень ласковая, веселая! Ходит на поводке. С кошками и собаками дружит. Была явно домашней. Потеряли, либо выбросили около деревни Терпигорьево. Ищем мам, пап для этой девчули!','natakirsanova@mail.ru','Наталья','+7-926-197-93-29','Средний','Медея','Найдено','Found_Pets_images/7-Медея/Медея-medeya_0_600e99002bb8c.jpg','Лайка',1),(8,'Палевый','2 года','','-не уточнено-','2021-05-21 13:13:57.388337','Москва','','Ksuxamadgirl@mail.ru','Татьяна','79431234554','Крошечный','Неизвестно','Найдено','none_image.jpg','Неизвестно',1);
