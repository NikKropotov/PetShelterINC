INSERT INTO `lost_pet` VALUES (1,'Проша','Мужской','2 года','Черный','Средний','Французский бульдог','Французский бульдог убежал 2.02.2020 с территории дачи в неизвестном направлении','2021-05-14 21:48:10.000000','Волоколамск , Московская область','greben.lyuba@yahoo.com','Светлана','+7-910-495-61-94','Пропало','Lost_Pets_images/1-Проша/Проша-prosha_0_5e38a9beb9961.jpeg',NULL),(2,'Лёля','Женский','7 лет','Белый','Средний','Бигль','16 июня 2017 в районе д.Красные Орлы – п. Крюково Чеховского района Московской области пропала собака. Кличка ЛЁЛЯ. Сука. Метис русской пегой гончей. 4 года. В холке до колена.\r\nОкрас ярко выраженный трёхцветный, как у бигля или русской гончей : белая грудь, лапы, чёрная спина, рыжие пятна. Экстерьер дворняги. Ушки топориком, хвост баранкой.\r\nНа собаке были 2 ошейника: рыжий со светоотражающей полосой и красный от клещей.\r\nСобака добрая и контактная. Видевшие собаку дети сказали, что её посадили в тёмную машину и увезли против её воли.\r\nПожалуйста, если Вы её видели или что-нибудь слышали о ней, сообщите по телефону\r\n8 909 964-7440\r\nНАШЕДШЕМУ ВОЗНАГРАЖДЕНИЕ 10 тыс.руб..','2021-05-14 21:51:47.000000','Чехов , Московская область','tallys@ya.ru','Наталья','+7-909-964-74-40','Пропало','Lost_Pets_images/2-Лёля/Лёля-ljolya_0_5dfd46f6d8397.jpg',NULL),(3,'Коба','Мужской','16 лет','Рыжий','Небольшой','Шпиц','Крым! Севастополь. Мыс Фиолент, садоводство Эврика. Пропал шпиц, 16 лет. Рыжий. Нет одного зубика спереди, глуховат, хромает слегка, кашлель сердечный. Зовут Коба. На нем только антиблошинный. Телефон для связи +79602554850 Ольга. Вознаграждение гарантировано. Собака живет на таблетках, поэтому если найдёте, свяжитесь сразу','2021-05-14 21:53:33.000000','Севастополь','olgajazz@mail.ru','Ольга','+7-960-255-48-50','Пропало','Lost_Pets_images/3-Коба/Коба-koba_0_5f1f9e34d1bcd.jpg',NULL),(4,'Персик','Женский','1 год','Белый','Крошечный','Ретривер','Нижний Новгород, Сормово. 25 декабря убежал щенок золотистого ретривера , 4 мес, девочка, окрас белый, красный ошейник и красный поводок, на животе клеймо. Будем благодарны ща любую информацию!!! Вознаграждение гарантируем!','2021-05-14 21:55:41.000000','Нижний Новгород , Нижегородская область','tatianaleb@rambler.ru','Татьяна','+7-993-846-72-00','Пропало','Lost_Pets_images/4-Персик/Персик-persik_0_5e091c768d373.jpeg',NULL),(5,'Грейс','Женский','4 года','Белый','Крошечный','Далматин','24.10 пропала собака, м. Ясенево, девочка, кличка Грейс, возраст, примерно, 3 года. Испугалась другую собаку и вывернулась из ошейника. Окрас белого цвета с небольшими черными пятнами, пугливая, к чужим не пойдёт. Если увидете, прошу звонить по телефону 89164746558 Татьяна, 89264929975 Наталья','2021-05-14 21:57:10.000000','Москва','Natalia.Potapova88@yandex.ru','Наталья','+7-926-492-99-75','Пропало','Lost_Pets_images/5-Грейс/Грейс-grejs_0_5db2fb89e4757.jpg',2),(6,'Вильям','Мужской','5 лет','Белый','Небольшой','Джек Рассел Терьер','9 ноября в Карачевском районе города Брянска потерялась собака породы джек рассел терьер, окрас белый с рыжей мордой, уши стоят не по породе, есть клеймо, нашедшему гарантируем вознагражление.','2021-05-14 22:07:35.000000','Брянск , Брянская область','slaviktoriya@yandex.ru','Виктория','+7-903-869-44-51','Пропало','Lost_Pets_images/6-Вильям/Вильям-vilyam_0_5de8fb5add432.jpg',1);
/*!40000 ALTER TABLE `lost_pet` ENABLE KEYS */;
UNLOCK TABLES;

--
-- Table structure for table `pet`
--

DROP TABLE IF EXISTS `pet`;
/*!40101 SET @saved_cs_client     = @@character_set_client */;
/*!40101 SET character_set_client = utf8 */;
CREATE TABLE `pet` (
  `idpet` int(11) NOT NULL AUTO_INCREMENT,
  `pet_name` varchar(100) NOT NULL,
  `pet_status` varchar(15) NOT NULL DEFAULT 'Ищет дом',
  `pet_gender` varchar(10) NOT NULL,
  `pet_age` varchar(20) NOT NULL,
  `pet_vaccination` varchar(10) NOT NULL,
  `pet_sterilization` varchar(15) NOT NULL DEFAULT '-не уточнено-',
  `pet_size` varchar(15) NOT NULL,
  `pet_type` varchar(100) NOT NULL,
  `pet_breed` varchar(60) NOT NULL,
  `pet_wool_length` varchar(10) NOT NULL,
  `pet_wool_color` varchar(50) NOT NULL,
  `pet_weight` varchar(25) NOT NULL,
  `pet_health` varchar(100) NOT NULL,
  `pet_privicies` longtext NOT NULL,
  `pet_temperament` varchar(30) NOT NULL,
  `pet_human_centred` varchar(30) NOT NULL,
  `pet_attitude_children` varchar(30) NOT NULL,
  `pet_attitude_cat` varchar(30) NOT NULL,
  `pet_attitude_other_pets` varchar(30) NOT NULL,
  `pet_keeping` varchar(50) NOT NULL,
  `pet_live_in_apartment` varchar(20) NOT NULL,
  `pet_accustomed_to_a_leash` varchar(20) NOT NULL,
  `pet_training` varchar(20) NOT NULL,
  `pet_location` varchar(45) NOT NULL,
  `petImagePath` varchar(100) NOT NULL,
  `contact_idcontact_id` int(11) NOT NULL,
  `shelter_idshelter_id` int(11) NOT NULL,
  `pet_wool_color_extra` varchar(50) DEFAULT NULL,
  PRIMARY KEY (`idpet`),
  KEY `pet_contact_idcontact_id_a22aa00c_fk_contact_idcontact` (`contact_idcontact_id`),
  KEY `pet_shelter_idshelter_id_d97bf915_fk_shelter_idshelter` (`shelter_idshelter_id`),
  CONSTRAINT `pet_contact_idcontact_id_a22aa00c_fk_contact_idcontact` FOREIGN KEY (`contact_idcontact_id`) REFERENCES `contact` (`idcontact`),
  CONSTRAINT `pet_shelter_idshelter_id_d97bf915_fk_shelter_idshelter` FOREIGN KEY (`shelter_idshelter_id`) REFERENCES `shelter` (`idshelter`)
) ENGINE=InnoDB AUTO_INCREMENT=385 DEFAULT CHARSET=utf8;
/*!40101 SET character_set_client = @saved_cs_client */;

--
-- Dumping data for table `pet`
--

LOCK TABLES `pet` WRITE;
/*!40000 ALTER TABLE `pet` DISABLE KEYS */;
INSERT INTO `pet` VALUES (1,'Оливия','Ищет дом','Женский','3 года','Да','Да','Средний','Семейная','Беспородная','Короткая','Палевый','-не уточнено-','Хорошее','-не уточнено-','Спокойный','Супер-общительный','Доброжелательное','-не уточнено-','-не уточнено-','Квартира | Вольер | Загородный дом','Нет','Да','Да','Муниципальный приют','Pets_images/1-Оливия/Оливия-1.jpg',2,1,NULL),(2,'Челси','Ищет дом','Женский','8 месяцев','Да','Да','Небольшой','Охотничья','Метис','Средняя','Белый','4 кг','Хорошее','-не уточнено-','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира | Загородный дом','Нет','Нет','Нет','Частный приют','Pets_images/2-Челси/Челси-2.jpg',3,2,'Черный'),(3,'Марта','Ищет дом','Женский','6 лет','Да','Да','Средний','Семейная','Беспородная','Короткая','Палевый','-не уточнено-','Хорошее','-не уточнено-','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира | Загородный дом','Да','Да','Нет','Муниципальный приют','Pets_images/3-Марта/Марта-3.jpeg',1,1,NULL),(4,'Тиша','Ищет дом','Мужской','9 лет','Частично','Да','Крупный','Семейная','Беспородная','Средняя','Белый','-не уточнено-','Хорошее','-не уточнено-','Спокойный','Общительный','-не уточнено-','-не уточнено-','Доброжелательное','Квартира | Загородный дом','Нет','Да','-не уточнено-','Муниципальный приют','Pets_images/4-Тиша/Тиша-4.jpeg',4,3,'Черный'),(5,'Артек','Ищет дом','Мужской','7 лет','Да','Да','Небольшой','Семейная','Беспородная','Короткая','Белый','-не уточнено-','Хорошее','-не уточнено-','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира | Загородный дом','-не уточнено-','Да','-не уточнено-','Муниципальный приют','Pets_images/5-Артек/Артек-5.jpg',5,4,'Рыжий'),(6,'Морс','Ищет дом','Мужской','4 года','Да','Да','Средний','Семейная','Беспородная','Средняя','Рыжий','25','Хорошее','-не уточнено-','Активный','Общительный','Доброжелательное','-не уточнено-','Доброжелательное','Квартира | Вольер | Загородный дом','-не уточнено-','-не уточнено-','-не уточнено-','Частный приют','Pets_images/6-Морс/Морс-mors_0_5b447f6158b8f.jpg',2,2,NULL),(7,'Ангелина','Ищет дом','Женский','10 месяцев','Да','Да','Небольшой','Семейная','Лабрадор','Средняя','Белый','17','Хорошее','','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира | Вольер | Загородный дом','Да','Да','Да','Передержка','Pets_images/7-Ангелина/Ангелина-angelina_0_6036273f77e51.jpg',6,2,'Палевый'),(91,'Варя','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Белый','11','Хорошее','Варя , 1 год, привита , чипирована, стерильна.\nВаря своё детство провела среди людей на рынке в городе Воронеж, от куда и прибыла покорять столицу . Варя очень добрая, ласковая и понимающая собака. Хорошо ходит на поводке , дружит с собаками . Ищем ей самый любящей дом .\nОтдаётся по договору ответственного содержания в квартиру или дом (строго не на цепь, вольер или будку)','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_42592/varya_0_60ab8b8ecb791.jpeg',121,117,NULL),(92,'Фанта','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','23','Хорошее','Фанта - источник энергии и дружелюбия!\nАктивная, полная жизни и любви к играм она ищет самую лучшую семью.\nФанта знает, что такое Дружба, Любовь и Преданность!\nСкорее звоните!!!\n1 годик, стерилизована, привита.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_32347/fanta_0_5e982dea72316.jpg',122,118,NULL),(93,'Алиса','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Палевый','10','Хорошее','Девочка. Ещё щенок. Скорее всего помесь овчарки и дворняги. Легко обучаема. За час обучил команде ко мне. Команду нельзя знала до меня. Сейчас обучаю команде сидеть. Агрессии не проявляет. По всей видимости предыдущий хозяин ее бил, а затем выкинул (или потерялась). Но за счёт того что молодая психологическая травма легко корректируется, к палке потихоньку приучаю. К поводку скорее всего приучена, но пока не проверял. Идеальный вариант для дачников и детей.\nНа кошек не бросается. Домашнюю птицу не трогает. Лаять пока не начала.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Загородный дом','Нет','Нет','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31377/alisa_0_5e626715f09ec.jpg',123,119,NULL),(94,'Макс','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Палевый','21','Хорошее','Кому Медвежонка Макса?\nМилый мягкий большой как плюшевая игрушка))) Спокойный, ласковый, послушный. Отличный друг и компаньон в неспешных прогулках. Максу 7 месяцев, вес 18 кг, рост 60см, выше колена, ещё немножко подрастёт)) Живёт в квартире, ведёт себя достойно, не лает. Дружит с детьми, кошками и другими животными) На улице гуляет 3 раза, спокойно ходит на поводке. \nОтдаем по договору с ненавязчивым отслеживанием дальнейшей жизни\n89163601576 Юлия','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_37301/maks_0_5f76d7fce5a42.jpg',124,120,NULL),(95,'Монти','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Серый','23','Хорошее','чаровательный пёс Монти ищет новый дом! Он очень не хочет возвращаться в приют под Новый Год. Пёс только привык к жизни в обществе, как снова стал никому не нужным и его просят забрать. (Причины совершенно не связаны с собакой)\nВозраст: 2-3 года\nРост: 50 см в холке (по колено)\nВес: 25 кг\nМонти очень душевный, ласковый и преданный пес. Спокойный, не требует долгих активностей, предпочтёт поваляться рядом с хозяином дома или прогуляться в парке. Не особо обращает внимание на еду и игрушки, для него самое главное, чтобы человек был рядом. Спокойно ходит на поводке, не тянет. Может стать отличным компаньоном и другом для детей. \nС другими собаками аккуратен, первый не проявляет агрессию, быстро привыкает. \nПривит, кастрирован, чипирован.\nОтдаётся в квартиру или в частный дом, но строго не на цепь. \nЕсли Вы хотите познакомиться с Монти, то скорее звоните:\n89689400257 Елизавета','Спокойный','Супер-общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_29498/monti_0_5e08a1284f7b1.jpg',125,121,NULL),(96,'Белочка','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Длинная','Белый','21','Хорошее','Белочка оставила все позади! Предательство, болезни и беспокойства. Все! Теперь новая жизнь!\nОна приехала из далека, с Москву. Испуганная, печальная и недоверчивая. Она не хотела сидеть на месте и все время куда-то рвалась...\nУ Белочки сильно болел глаз, очень сильно! и именно поэтому она была так беспокойна и необщительна!\nТеперь все Это в прошлом. Нет боли, нет испуга, только невероятная доброжелательность и жажда внимания!\nИногда, те, кто раньше знал Белочку и долго ее не видели, не могут ее узнать, такой внимательной, красивой и раскрепощенной она стала.\nИ теперь, мы ищем добрый дом для чудо Белочки!\nБелоснежной красавице около 3 лет. Глазик один не видит, но для того, кто любит всем сердцем, это не помешает! Белочка хорошо холит на поводке, приучена к выгулу, доброжелательна к людям и собакам и она прекрасна!\nЖдет и мечтает познакомится.','Спокойный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_38024/belochka_0_5f9973994dfee.jpg',126,122,NULL),(97,'Мулан','Ищет дом','Женский','5 месяцев','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Рыжий','9','Хорошее','Зовут Мулан. Метис терьера. Мама некрупная, папаша неизвестен.\nДевочка очень ласковая и нежная, смышленая и понятливая, веселая и жизнерадостная. При этом она в меру активная, без лишней суеты.\nМожно брать в семью с детьми и другими животными.\nОтдаём по договору передачи животного, только взрослым ответственным людям.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42387/mulan_0_60a4d31444a31.jpg',127,123,NULL),(98,'Бали','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','22','Хорошее','Бали ждёт вас.\n\nИ речь не про сказочный остров, а про такого же солнечного, тёплого и доброго пса.\n\nБали 11 месяцев. \nИ он энерджайзер)). \nВ нем неиссякаемый поток энергии, жизнерадостности, позитива, любви и света. \n\nЗаиграет, зацелует, заобнимает любого, будь то взрослый человек, ребёнок или другая собака. Бали со всеми находит общий язык. \n\nОн неконфликтный и уступчивый с другими собаками, терпеливый с детьми (позволяет даже ковыряться в его миске) и приветливый со взрослыми. \n\nКонечно же Бали нуждается в таком же активном человеке или семье. Он ждёт тех, кто будет с ним на одной волне и кому  активные прогулки, игры и тренировки будут доставлять искреннюю радость.\n\nБали здоров, привит, чипирован, имеет паспорт. Приучен к туалету на улице. Он среднего размера, 23 кг. \n\nОтдаётся по договору ответственного содержания с условием ненавязчивого отслеживания судьбы. \n⠀\nЕсли хотите узнать больше, или познакомиться с Бали, звоните/пишите:\n\n8 (916) 729-13-32 Алина \n8 (903) 761-78-05 Дарья','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_37775/bali_0_5f8eac7fcc41e.jpg',128,124,NULL),(99,'Плуто','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Рыжий','17','Хорошее','Плуто невероятный красавец и обояшка, настоящая звезда, метис Гончей. Любит активные долгие прогулки. Ласковый, добрый.\nЗдоров, привит, кастрирован.\nОтдается по Договору в ответсвенные и любящие руки.\nБольше информации о собаке можно найти в соц сетях Instagram и Faсebook по хэштегу #домашний_плуто','Активный','Супер-общительный','Равнодушное','Равнодушное','Равнодушное','Квартира','Нет','Нет','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_28790/pluto_0_5debe6d389a8f.jpg',129,125,NULL),(100,'Лика','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','20','Хорошее','Лика - супер ласковая девочка! Очень послушная и добрая, быстро идет на контакт, умеет ходить на поводке. С другими собаками общается избирательно. Лика - умница, приезжайте с ней погулять!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_18312/lika_0_5c0aaaf7e848f.jpg',130,126,NULL),(101,'Озорная Кики','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Черный','10','Хорошее','Веселая, озорная и любознательная Кики готова наполнить вашу жизнь яркими красками?\n⠀\nОна, как маленький шилопоп активная, энергичная, безумно ласковая и очень любит почесушки за ушком ?‍? ?\n⠀\nКомпактный размер этого чуда прекрасно подойдёт абсолютно всем вне зависимости от габаритов имеющегося жилья?\n⠀\nС ней в вашем доме поселится абсолютно бесплатно радость, уют и тепло❤️☝️\n⠀\nНе бегите от вашего счастья, бегите за нашей пушистой малышкой со всех ног??‍♀️, она ждёт свою семью?‍♀️?\n⠀\n✔️возраст ~ 1 год\n✔️ в холке ~ 50 см.\n✔️ вес ~ 10 кг\n✔️ полностью здорова\n✔️ отлично ходит на шлейке\n✔️ вакцинирована\n✔️ стерилизована\n✔️ чипирована\n⠀\nПристраивается в Москву/МО ответственным людям исключительно в дом/ квартиру/ СТРОГО не на цепь по договору с дальнейшей возможностью отслеживания судьбы☝️','Спокойный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39641/ozornaya-kiki_0_5ff0e6aac3acc.jpeg',131,127,NULL),(102,'Бакс','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','5','Хорошее','Бакс,3.5 мес,весёлый,активный,но явно в будущем серьезный малыш.\nОтдается по договору ненавязчивого отслеживания','Активный','Общительный','Равнодушное','Доброжелательное','Доброжелательное','Квартира','Нет','Нет','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_29168/baks_0_5eb02d5c7def8.jpg',132,128,NULL),(103,'Тиана','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','Тиана — собака добрейшей души. Чуткая, спокойная, размеренная.\n\nСобака, которая создаёт уют своим присутствием и отвлекает от повседневной рутины и скоротечности времени. Таких как Тиана, принято считать собаками — терапевтами. Ласковая, но при этом ненавязчивая. Кроткая, понимающая и трепетная. Она отлично ходит на поводке, ладит со всеми сородичами и способна утихомирить даже самый пылкий нрав. Как нам кажется, она подойдёт в семью с любым составом, так что скорей присматривайтесь к этой чудесной собаке. Тиане около 6 лет, привита, стерилизована и полностью здорова.','Спокойный','Сдержанный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40713/tiana_0_602ae984a7d6f.jpeg',133,129,NULL),(104,'Малина','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Коричневый','30','Хорошее','В добрые руки чудесная девочка Малина. Её малыши подросли и уже не нуждаются в своей маме, поэтому начинаем подыскивать ей любящий дом, где она будет находится под надежной защитой своих людей! Всё-таки девчонке пришлось, наверное, всякого натерпеться от людей, поэтому по приезду в приют она была очень настороженной, да и малыши были совсем крошками, и она за них волновалась. Сейчас Малина совершенно оттаяла, оказалось, что это добрая и ласкучая девулька. Отлично ходит на поводке и на прогулке ведет себя спокойно, поэтому с ней легко сможет справиться человек любого возраста. К другим собакам относится неагрессивно, единственное - не нравятся ей пушистые великаны, на них начинает лаять. А ещё она очень тактичная и лояльная - вкусняшки любит, но никогда настойчиво не полезет за ними в карман, будет тихонечко ждать, деток своих и себя разрешает трогать и гладить! Рада абсолютно всем, встает, ставит лапы на плечи и облизывает, вот такая она нежная девочка! Сообразительная, знает команду \"сидеть\", остальным командам обучить её не составит труда. Ну а о внешней красоте можно много не говорить, она просто КОРОЛЕВА!!! Стерилизована, привита, имеет ветеринарный паспорт, пристраивается бесплатно по договору ответственного содержания.','Спокойный','Общительный','Доброжелательное','Может проявить агрессию','Равнодушное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_32916/malina_0_5fd27e8b5441c.jpeg',134,130,NULL),(105,'Коди','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','18','Хорошее','Ищет дом и любящую семью чудесный!\n\nКоди очень  смышленый парень. Прекрасно ходит на поводке, с ним можно просто наслаждаться прогулкой, он ориентируется на свою компанию и послушно вышагивает рядом. Обучаем. Внимателен. Деликатен. Угощения берет аккуратно. \nГлавный талант: обниматься всегда и везде! Отзывчивый и любвеобильный  Коди привык протягивать лапу дружбы всем и каждому без исключения.  Он станет прекрасным компаньоном для семьи с ребенком. Коди настолько контактный, что впишется абсолютно в любую семью. Главное, чтобы человек был рядом.\nОтдается взрослым людям по договору ответственного содержания в Москву и МО, с возможностью ненавязчиво отслеживать дальнейшую судьбу, строго не на цепь.','Спокойный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Вольер','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40233/kodi_0_600fcd02ac463.jpg',135,131,NULL),(106,'Щенок','Ищет дом','Женский','9 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','5','Хорошее','Кто всегда хотел и хочет завести собаку - действуйте сейчас!!!\n\nПрекрасный щенок, девочка, 2 месяца, ищет себе хозяина, любовь, заботу и верного друга! Ласковая, игривая, здоровая, отменный аппетит. Беспородная.\n(Прошла медосмотр - полностью здорова, проглистогонина 2 раза и сделаны 2 прививки)\n\nПо размеру будет примерно средняя, по колено.\nИз 9-ти щенков осталась одна последняя девочка!\n\nДевочка рано потеряла маму и пока находятся временно на передержке в платном частном приюте в районе Одинцово.\nСмогу осуществить доставку или подвести, если захотите выбрать в приюте ?\n\nПожалуйста по спрашивайте своих друзей, знакомых, соседей, может кто-то хочет завести собаку.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_37064/shchenok_0_5f6c6882c7126.jpg',136,132,NULL),(107,'Джей Ди','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','23','Хорошее','Джей Ди – офигенно классный пёс!\n\nИменно так хочется охарактеризовать Джей Ди. Жизнерадостный, обаятельный, харизматичный мальчик. Очень радуется своему человеку: не может отправиться на прогулку, предварительно не пообнимавшись и не рассказав, как он провёл эту неделю в ожидании опекуна.\n\nДжей Ди прошёл огромный путь от зашуганного и неуверенного подростка до жизнерадостной, доверяющей человеку собаки.\n\nБольше всего любит узнавать новое. С огромным интересом ходит на прогулку в город. Отлично себя чувствует в суете мегаполиса. Крайне удивляется, когда видит своё отражение в витринах: останавливается, любуется. На прогулке обожает поваляться в траве или снегу. И конечно — покупаться. Если водоём недостаточно большой, чтобы намочить всего Джей Ди, он не расстраивается и прикидывается выдрой. Парень крайне сообразительный и уже освоил запрыгивание в машину. В общем, непонятно, что этот шикарный пёс делает в приюте. Ему давно пора домой.\nЗаберите уже красавчика к себе!','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39519/dzhej-di_0_5fe6e20be1571.jpg',137,133,NULL),(108,'Чакки','Ищет дом','Мужской','12 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Черный','16','Хорошее','Что Вы сделаете, если принесёте домой бракованный товар?\nИгрушку, например.\nПринесли, поиграли и вдруг она барахлит. А если поиграть ещё, может и вовсе сломаться. Чинить дорого. Да и зачем такие сложности, если можно купить новую.?\nИ тогда что?\nНу, да - относите бракованную вещь назад.\n⠀\n... А если на месте бракованной игрушки кто-то живой? Не игрушечный ни разу. Тогда... тоже так?\n⠀\nНаш Чакки, милый, добрейший пёс, обрёл дом, о котором мечтал в приюте всю свою жизнь, всего на неделю.?\n⠀\nА потом... Потом сломался.\nОказалось, что Чакки начинает слепнуть. И через 7 месяцев наш такой преданный человеку парень может захотеть увидеть своего хозяина, поднимет мордочку, посмотрит...и промахнётся...?\n⠀\nК сожалению, новая семья Чакки решила, что последнее, на что в своей жизни должен посмотреть их друг - это приютский вольер, решётка и кусочек неба, проглядывающий из-за неё..\n⠀\nА мы не согласны! \n⠀\nХоть этот нежный скромняга отлично ладит с другими собаками (и котиками, кстати тоже!), самое главное для него- общение с человеком. Чакки обожает проситься на ручки, но при этом настолько деликатен, что вам не покажется это наглостью. \nОн - послушный и невероятно обаятельный парень идеальных размеров (всего 45см в холке), поэтому даже в небольшой квартирке ему будет уютно, главное - быть рядом с вами. \n\nСобакам не нужны глаза, чтобы видеть.. Они смотрят сердцем. А оно у Чакки что надо!❤\n\nИ мы очень ХОТИМ УСПЕТЬ познакомить Чакки с его новой семьёй, чтобы он смог насмотреться на них! Чтобы потом, тыкаясь носом в ладони, сворачиваясь у ног, знать, как выглядит тот, кто только что ласково потрепал по спине, почесал за ухом и сказал: \"Чакки наш мальчик! Чакки хороший..\"\n\nИ если этот удивительный парень ВАШ, звоните скорее и приезжайте за ним, он очень вас ждёт:\n\n+7(916)285-85-26 Мария \n+7(903)538-26-67 Анна\n⠀\nА если ваше сердце уже занято, просто помогите нам рассказать о Чакки?.\nПотому что последнее, что нужно видеть-это не решетка вольера. Нужно смотреть на того, кого любишь...\n⠀\n#миниовчарка_чакки #собакикоторыелюбят','Спокойный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_787/chakki_0_55be16bfa1411.jpeg',138,134,NULL),(109,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',139,135,NULL),(110,'Сэм','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Белый','4','Хорошее','Щенок Сэм ждёт мам и пап!\nВозраст 2 месяца. Вес 4 кг.\nБудет средним 15-20 кг. Абсолютно здоров (есть анализы), обработан от блох, клещей и глистов.\nГотовится к прививке. Дружит с кошками.\nТуалет на пелёнку без промахов. Знает команду нельзя.\nОчень умный и послушный, схватывает все на лету.\nСовершенно беспроблемный, целыми днями играет с любимыми игрушками, ночью крепко спит.\nАктивный, но не навязчивый. Очень ручной.\nПроблем с воспитанием не будет, обучается очень легко.\nТерриториально м. Киевская','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_32847/sem_0_5eac667cd73a5.jpg',140,136,NULL),(111,'Маркоша','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','13','Хорошее','Маркоша - идеальный семейный друг и компаньон. Вы любите активный отдых, спорт или просто долгие прогулки? Наверняка да, раз вы подумали о том, чтобы завести собаку. И лучшего компаньона в этом вам просто не найти! Маркоша обожает игры с человеком (догонялки особенно, вы просто удивитесь его изобретательности:) Он активен, азартен и имеет склонность к паркуру (для тех кто не в курсе - препятствие для этого парня не помеха! Очень умён, понимает все с полу слова, учит команды! ','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_25243/markosha_0_5d547122df78e.jpeg',141,137,NULL),(112,'Яробой','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Коричневый','27','Хорошее','В добрый руки пристраивается весёлый и молодой парень Яробой!\nЯробой - плюшевый мальчишка. Во всех смыслах этого слова. Такой мягкий, что хочется его затискать) Очень добрый и контактный. Из команд знает только «сидеть», ну или пока скрывает знание остальных команд))) На прогулке ведёт себя как козлик, жуёт травку и прыгает выше головы) Из отрицательных моментов - пытается прыгать и прикусывать поднятые руки, при этом к опущенным рукам никакого интереса у него нет. Когда начинаешь его ругать за такое недостойное поведение, то сидит, внимательно смотрит и слушает. После окончании лекции по хорошему поведению - встаёт и бежит дальше по своим собачьим делам)) Очень забавный ушан. Носится как угорелый, конечно, в силу возраста и моря энергии. Поводок тянет довольно сильно, но только до поля, потом очень комфортно ходит во время прогулки. К другим собакам любого пола проявляет исключительно дружелюбный интерес! В приюте живёт как с собакодевочками, так и с мальчишками, так что вполне можно брать паренька в семью второй собакой!) Вообщем, Яробой - классный мальчишка, которому просто недостаёт чуточку воспитания...... В остальном прекрасный, молодой, позитивный, энергичный, любопытный и ласковый ребёнок! Яробой кастрирован, привит, полностью здоров, имеет ветеринарный паспорт, отдаётся бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. Если хотите подарить Яробою дом, то звоните нам и приезжайте с ним знакомиться!)','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_42515/yaroboj_0_60a50497d73fb.jpeg',142,138,NULL),(113,'Джерси','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Коричневый','19','Хорошее','Красивая, ласковая ,хороший компаньон.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_38302/dzhersi_0_5fa717c7ab8b8.jpg',143,139,NULL),(114,'Гром','Ищет дом','Мужской','7 лет','Нет','-не уточнено-','Крупный','Охранник','Беспородная','Средняя','Коричневый','31','Хорошее','Красивый брутальный пес.','Активный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Вольер','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_38303/grom_0_5fa718e71f72a.jpg',144,140,NULL),(115,'Лучик','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','22','Хорошее','Наконец-то в Калугу пришло лето! ???\nВот уже несколько дней тепло и нет дождей... ?\n\nСтолько событий произошло в приюте за последнее время, такое большое пополнение... Конечно, мы немного устали... Поэтому решили внести как можно больше солнечного настроения в наши непростые будни и выпустили на прогулку смешного и улыбчивого Лучика! ☀☀☀\nМальчику 1,5 годика, это красивый и уж очень обаятельный пес! ?\n\nЛучик всегда активен и весел, вот и сегодня он улыбался нам, радостно виляя хвостом! Так сказать, разряжал обстановку и заряжал позитивом! ? \n\nЛучик, как и все собаки приюта, очень хочет быть домашним и дарить свою лучезарную улыбку любящей семье! ??\n\nБыть может, Вам не хватает этого солнечного песика? Приезжайте за мальчиком! Такой заряд положительных эмоций каждый день! ?','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_8736/luchik_0_597757ef9ad2c.jpg',145,141,NULL),(116,'Блек','Ищет дом','Мужской','21 год','Нет','-не уточнено-','Крупный','Охранник','Беспородная','Короткая','Черный','30','Хорошее','Красивый парень','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_38305/blek_0_5fa71b0f743e1.jpg',146,142,NULL),(117,'Марго и Стефа','Ищет дом','Женский','8 лет','Нет','-не уточнено-','Крупный','Семейная','Породистая','Средняя','Белый','35','Есть небольшие проблемы','Отдам двух Лабрадоров в добрую и любящую семью!!! Дефочек зовут Стефа и Марго\nСтефа: цвет-чёрный, 8 лет, навязчивая личность, которая не может быть в одиночестве и ходит хвостиком за вами!\nМарго: цвет-палый, 7 лет, характер королевы, которая любит,чтобы ей уделяли внимание, у Марго есть проблемы с задними лапками (ранки, которые она переодически разлизывает), вылечить не составит труда, главное следить за этим.\nСейчас собаки живут в отлеле и ждут новую семью, которая будет любить их так, как не смог сделать это предыдущий хозяин','Активный','Супер-общительный','Доброжелательное','Равнодушное','Может проявить агрессию','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41260/margo-i-stefa_0_604b6aa875097.jpg',147,143,NULL),(118,'Лютик','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Рыжий','16','Хорошее','Метис шпица с лайкой, собака компаньон, очень добрый, любит детей, в еде не привередлив, туалет на улице.','Спокойный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_28138/lyutik_0_5dd125fdb13cc.jpg',148,144,NULL),(119,'Альма','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','16','Хорошее','Альма - домашняя, ласковая и покладистая девочка, немного пугливая, которая видела немного хорошего в жизни. Обожает и очень преданна своим людям, готова исполнять все что от неё хотят, лишь бы заслужил любовь и поощрение. На улице с честью и достоинством может поохранять от незнакомых людей, на всякий случай. Избирательна в отношении сородичей, с кем-то устраивает весёлые игрища, а кого-то не готова пускать на свою территорию. Подойдёт на звучную охрану на участок. Приучена к двухразовому выгулу, живёт на квартирной передержке, ничего не портит, нейтрально относится к своим кошкам. Альма не отчаивается найти самых добрых и заботливых хозяев, чтобы её взгляд наконец-то стал счастливым, а взамен станет самым верным и надёжным компаньоном!','Спокойный','Супер-общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_38983/alma_0_5fc6e63812ab5.jpg',149,145,NULL),(120,'Джой','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','17','Хорошее','Мы знаем несколько истин: смех продлевает жизнь, и оптимисты живут гораздо дольше пессимистов. \n\nХотим вам представить генератор радости и счастья модель \"Джой\" (с дополнительными функциями ) работает на чисто экологическом топливе, легок в использовании. Со дня изготовления Джоя прошло 3 года, в него уже включены некоторые функции: хождение на поводке, ласка, нежность, послушание, бесконфликтность с другими объектами. Также у него большая внутренняя память и при правильном использовании он сможет заполнить ее огромным количеством команд.  Джой хочет найти хозяина, чтобы создавать для него радость и позитив (тем самым продлевая ему жизнь).\nДжой прошел Т.О.: привит от бешенства, кастрирован, полностью исправен,  выдается бесплатно хорошим людям по договору. За заказом звоните по телефону волонтера!','Активный','Общительный','Равнодушное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_22941/dzhoj_0_5ce28df1d6182.jpg',150,146,NULL),(121,'Черри','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','22','Хорошее','Знакомьтесь, это Черри!\n\nЧерри совсем молоденькая девочка, ей примерно 1,5 годf. Черри нашли брошенной щенком подростком вместе со своей мамой в дачном поселке.\n\nКак это обычно бывает, закончен сезон, все уехали, а животные остались.\n\nНаверное, именно эти собаки родились под счастливой звездой. Их заметили, вывезли на передержку, сделали прививки, провели стерилизацию.\n\nМама Черри весной уехала в Голландию, где живет с замечательной новой семьей.\n\nЧерри повезло меньше. Что там было в судьбе этой маленькой собаки, кто ее так обижал, мы уже никогда не узнаем. Но Черри панически боялась всего, найти семью для нее в таком состоянии было не возможно. Поэтому она целый год занималась с Зоопсихологом и добилась отличных результатов. Черри ходит на поводке, активно играет, но только когда чувствует себя в безопасности. К сожалению, гулять с малышкой можно только на поводке, т.к. без поводка она нервничает и от страха может убежать. Зато дома собачка ласкова, любит вкусняшки и игрушки. Откровенно боится новых людей. Чтобы привыкнуть, ей нужно время. Пока она еще трусишка.\n\nЧерри прекрасно формирует привязанность к хозяевам. Она уже очень привязалась к своей «временной хозяйке», поэтому ждать дольше, не стоит. Черри должна привыкать к постоянному дому, к постоянным хозяевам. Присмотритесь к Черри. Возможно, это именно та собака, которую Вы искали.\n\nЧерри – не простая девочка, поэтому ее будущие хозяева должны быть готовы к тому, что доверие Черри нужно заслужить. Но мы верим, что это обязательно произойдет. Ведь не зря же она была спасена.\n\nЧерри находится в Москве. Приезжайте знакомиться.','Спокойный','Сдержанный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_4743/cherri_0_579cbced7c428.jpg',151,147,NULL),(122,'Кэтчер','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Рыжий','35','Хорошее','В добрые руки пристраивается красавец - Кэтчер!!!Этот активный, трёхлетний пёс был вынужден прозябать свою жизнь прикованным к бетонному забору....... Неравнодушные люди, озабоченные несладкой участью несчастного пса, в конце концов убедили хозяина, что это не жизнь для собаки и тот согласился отдать Кэтчера в наш приют. Пёс оказался тонкой душевной организации и отказ от него любимых хозяев он воспринял крайне болезненно. Очень долго находился в стрессе и почти никого не подпускал к себе. Этот всегда настороженный взгляд, недоверие ко всем..... Постоянное озирание по сторонам в поисках тех, кого он любил. Весь его вид кричал об ужасе и непонимании происходящего. У таких как Кэтчер, путь к доверию всегда не быстрый и торопить его нельзя. Просто с определёнными собаками требуется чуть больше времени, чуть больше терпения и сил, но оно того стоит!!!! Сейчас Кэтчер больше так сильно не боится, радостно встречает тех, кто вошёл за это время в круг его доверия, учится играть и получать удовольствие от общения!) Да, пока он не готов доверять всем подряд, закрываясь под маской негатива и враждебности...... Это всё из-за пережитого предательства, таким образом он лишь защищается от внешнего мира. И будущим хозяевам, которые действительно захотят забрать его себе, нужно будет запастись терпением, поездить в приют, наладить взаимоотношения и только потом уже забирать его домой! Но нет ни капли сомнения, что именно такие - изначально «не самые простые» собаки, впоследствии готовы не задумываясь умереть за своих людей!!! Если Вы хотите подарить мальчику дом, то звоните нам и приезжайте с ним знакомиться!) Кэтчер кастрирован, привит, имеет ветеринарный паспорт, отдаётся бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО.','Активный','Сдержанный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_37744/ketcher_0_602cddf08bf61.jpeg',152,148,NULL),(123,'Байкал','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','20','Хорошее','Верный Байкал мечтает о семье!\n\nБайкал очень верный и преданный, у него бездонные глаза, которыми он буквально смотрит в самое сердце. Байкал ласковый пёс и бесконечно добрый. При первом знакомстве он может быть немножко зажат, а вот на втором «свидании» малыш залезет вам на ручки и расцелует)\n\nАх да, важное уточнение, Байкал абсолютно КОМПАКТНЫЙ и НЕБОЛЬШОЙ песик. В холке около 50см, по весу около 20кг. Байкал здоров, привит, кастрирован, отлично ходит на поводке, активно учит команды, другими животными ладит, возраст 1,5 года. \nПо всем вопросам звоните!','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_28988/bajkal_0_5df2175163682.jpg',153,149,NULL),(124,'Тигра','Ищет дом','Женский','12 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','- не уточнено -','Хорошее','Дата рождения: январь 2009. Рост в холке: 52 см. Здорова, привита, стерилизована и чипирована, есть вет.паспорт.\nЕё назвали Тигрой не из-за кровожадности, вовсе нет - просто она обладательница серо-тигристой шелковистой шубки, которую так приятно гладить. Тигра спокойная и уверенная в себе собака, но как только понимает, что ее берут на прогулку - радуется и ласкается как щенок; торопится поскорей покинуть тесный вольер и отбежать подальше от приюта, после чего расслабляется и с наслаждением валяется на траве, подставляя живот для почесывания. Гранит науки жизни немного притупил ее зубки, но только не ум: она хорошо обучается, знает базовые команды, прекрасно носит намордник, может гулять на поводке или рядом без поводка . Тиграша умная и рассудительная собака: внимательно выслушав Ваши доводы и найдя их убедительными, она выполнит все, что Вы от нее хотите. Она не утратила оптимизма и жизнелюбия и надеется обрести любящего хозяина. Приходите познакомиться, загляните в ее янтарные глаза - и она обязательно покорит Ваше сердце!\nЖдёт Вас в приюте \"Красная сосна\" (сайт priut-ks), недалеко от м.ВДНХ. Звоните сейчас и приезжайте знакомиться!','Спокойный','Общительный','Доброжелательное','- не уточнено -','Равнодушное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_5931/tigra_0_586f81283b795.jpg',154,150,NULL),(125,'Рейс','Ищет дом','Мужской','10 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','20','Есть небольшие проблемы','Знакомьтесь, это наш красавец с необычным именем Рейс. Ему около 10 лет и большую часть своей жизни он прожил в приюте, попав туда еще подростком. У Рейса возрастное заболевание и он принимает гормональные препараты.\nТем не менее мы не теряем надежды найти Рейсу настоящий дом, где он будет членом семьи, где его будут любить и никогда не предадут. Послушный, умнейший, беспроблемный пес, чудесно ладит с детьми и другими животными. Всех любит, всем всегда рад. Ходит на поводке идеально, знает команды и с радостью демонстрирует свои умения. Рейс любит быть в центре внимания, он не разочаровался в людях, пережив череду предательств. Он всё еще верит и ждет своего человека!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_33212/rejs_0_5ebe94c81be88.jpg',155,151,NULL),(126,'Диана','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','27','Хорошее','Диана - яркая брюнетка, красивая, статная девочка в белых перчатках. По характеру очень спокойная, уравновешенная, самодостаточная. Очень ориентирована на человека, именно по этой причине в приюте сильно тоскует и очень ждет, что однажды придут и за ней. Диане около 5лет. В холке - около 55 см. Стерилизована. Сейчас живет в приюте. Если Вы решили взять собаку - приезжайте знакомиться с Дианой! Звоните. Территориально - м.\"Выхино.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30778/diana_0_5e47fd75d797b.jpg',156,152,NULL),(127,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',157,153,NULL),(128,'Слайк','Ищет дом','Мужской','10 лет','Нет','-не уточнено-','Крупный','Семейная','Породистая','Средняя','Рыжий','36','Есть небольшие проблемы','Чудесная компанейская собака. Которая прижимается к ногам, как годовалый ребенок к матери. Размер внушительный, но сколько в нем доброты и нежности... Эта нежная собака вполне может за себя постоять, но только в крайнем случае, все остальное время, она будет искать глазами любимые и родные ладошки своей семьи. \nОТЛИЧНЫЙ компаньон для всей семьи! Обожает детей любого возраста! С сородичами немного сложно, с кобелями доминирует, к сукам выборочно, с кошками не знаем.','Спокойный','Общительный','Доброжелательное','- не уточнено -','Может проявить агрессию','Квартира','- не уточнено -','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_20599/slajk_0_5d25a057cfdce.jpg',158,154,NULL),(129,'Зорро','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','23','Хорошее','Супер герой Зорро ищет своих Маму и Папу! Очень общительный, активный, дружелюбный мальчик, 2 года. Наш супер герой спасет Вас от депрессии и хандры, поднимет настроение в любой непонятной ситуации:) Очень любит людей и других собак, игривый и смешной мальчик! Зорро  - герой, поэтому смелости ему не занимать, но даже герои боятся - и в эти моменты Зорро забирается на ручки - а разве Вы так не делаете?:) А еще он очень любвеобильный - обожает целоваться и обниматься! Приезжайте знакомиться с нашим Зорро! Вы влюбитесь в него с первого взгляда, а он - в Вас!','Активный','Супер-общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_16335/zorro_0_5b885a36d8188.jpg',159,155,NULL),(130,'Мира','Ищет дом','Женский','8 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','20','Хорошее','Мира - ваш антидепрессант!\nПозвольте познакомить вас с Мирой. Девочке всего 7 месяцев и она мечтает стать домашней. Дети не должны жить в приютах. Им нужна забота, любовь и свой человек. Мира как и все дети игривая, беззаботная, милая, любопытная и очень трогательная девочка. С ней вы никогда не заскучаете. Она, очевидно, не карманная собака, но все собачники знают, что чем собака больше, тем больше вам достанется любви :) Разве может что-то сравниться с вечерними шерстяными обнимашками, с утренними тыками и поцелуями мокрого носа, с тем как виляет её хвост, когда вы приходите домой, круче любого пропеллера ;) Собака откроет вам мир, который вы не замечали без неё, это истинная правда. Так что заметьте Миру, спасите жизнь и подарите себе любовь!','Активный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41377/mira_0_605245007948c.jpg',160,156,NULL),(131,'Чара','Ищет дом','Женский','3 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','13','Хорошее','Чара ждёт свою семью.\nВозраст примерно 1,5 года.\nСтерилизована, привита.\nРазмер ниже колена - 35-40 см.\nВес около 13 кг.\nИдеальный вариант для квартиры.\nЛасковая, игривая, дружелюбная к людям и животным. На прогулке любит валяться в траве, нежиться на солнышке. Живет в приюте.\nПриезжайте знакомиться .\nВозьми Собаку Из Приюта .\nКуратор Юлия','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_27844/chara_0_5dc41198e582d.jpg',161,157,NULL),(132,'Рома','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','18','Хорошее','Рома, девочка, 7 месяцев. Удивительно красивая Собака - Заяц! Рома - любопытный Нос и Мыслитель!\nУмная, сознательная собака, отлично поддается дрессировке. \nОбладательница обаятельных веснушек и уникального очарования!\nРома привита, стерилизована. Живет в приюте вместе со своей сестренкой Усамой - егозой и обнимашкой!\nПриезжайте, пожалуйста, к ним познакомиться!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_32343/roma_0_5e98267792610.jpeg',162,158,NULL),(133,'Мишель','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крупный','Охранник','Породистая','Средняя','Белый','49','Хорошее','Среднеазиатская овчарка в добрые руки. Не агрессивная , контактная, здорова, привита, имеет ветпаспорт. Можно в семью с детьми и в пару к другой собаке. Может жить как в доме, так и в вольере. Наличие хорошего забора обязательно.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Вольер','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35720/mishel_0_5f2e9ced1f969.jpeg',163,159,NULL),(134,'Джек','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','7','Хорошее','Джек весёлый прикольный малыш. Позитивный, игривый, ласковый. Ему 3 месяца, вес 7кг . Очень красивый  мальчишка с  рыжим рисунком.\nВырастет по колено . Есть его сестрички. \nПришлю видео на Вотсап\nОтдаём по договору надёжным людям \nЕсть щенки других окрасов и возрастов \nЗвоните!!!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_27495/tarzan_0_5ecd25200ace6.jpg',164,160,NULL),(135,'Руни','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','15','Хорошее','Руни около 2-х лет, он очень нежный. Кастрирован и привит. Не агрессивен, ни к кому. Думаем, что с кошкой подружится.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_33390/runi_0_5ec5609b3f89b.jpeg',165,161,NULL),(136,'Мухтар','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Рыжий','28','Хорошее','Солнечный красавчик Мухтар в поисках дома!!!\n⠀⠀Ему дан срок две недели и если за это время хозяин не найдётся, то Мухтар вернётся на улицу, где и продолжит свои скитания.\n   У него мудрый и абсолютно человеческий взгляд.  А взглянув в его глаза можно увидеть всю боль и тяготы скитаний всей его жизни.\nЕму пять лет и в этом возрасте шансов обрести любящих хозяев не так уж и много...\nОн здоров,  привит,  сделаны все обработки,  есть ветпаспорт. Вес ~ 28 кг,  рост в холке ~ 58см. Очень добрый и ласковый пацан,  ориентирован на человека.\n⠀⠀Прекрасно ходит на поводке,  приучен к выгулу два раза в день.\n⠀⠀Ищем для него верную и преданную семью и дом!!!\n⠀\n⠀⠀Приезжайте знакомиться с Рыжиком он ждёт Вас и очень хочет домой!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_32309/mukhtar_0_5e97075b79380.jpeg',166,162,NULL),(137,'Нутелла','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','- не уточнено -','Хорошее','Нутелла маленькая волчица, которая до сих пор учится доверять людям. И с каждым днём, ей это даётся все легче и легче. Нути молодая, весьма активная собака, с нотками ласки и нежности, которую она проявляет лишь к своему человеку, как признак высшего доверия. Чтобы она впустила вас в свое сердце, необходимо потратить немного времени: пара прогулок в лесу, мясные угощения - и Нути вся ваша. Нутелла и правда сладкая, как шоколадка, ведь она дарит столько незабываемых эмоций, что совершенно не хочется оставлять ее одну. Встречает друзей она виляющим хвостом и радостными танцами, прощается – крепкими собачьими объятиями. Нути готова поехать домой, где будет дарить своим людям море улыбок и океан любви.','Спокойный','Сдержанный','- не уточнено -','- не уточнено -','Равнодушное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39843/nutella_0_5ffc97ad7c0df.jpg',167,163,NULL),(138,'Варя','Ищет дом','Женский','8 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','13','Хорошее','Варя славная, нежная, тонконогая, очень ласковая, в последнее время стала немного робкой и кокетливой. Такая девочка-девочка)). И кокетка, и ласкушка, и игруля и самая красивая собака, которая доставит столько радостей своей семье! Очень любит детей, обожает, ластится. Смешно играет с игрушками, носит их очень необычно, не в пасти, а кончиками зубов. Она не навязчива, если понимает, что человек занят-тоже займётся своими делами. Внимательна и любознательна, ей нравится учиться собачьим премудростям, она старается.\n\nПриезжайте знакомится! После знакомства привезем в ваш дом!\n\nЗдорова, привита. 8 месяцев.\n\nТуалетные дела исключительно на улице.','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42170/varya_0_6086d962e2c6e.jpg',168,164,NULL),(139,'Скалли','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','23','Хорошее','Молодая и активная Скалли в поисках семьи!\nВозраст около 2 лет.\nЗдорова .\nСтерилизована .\nВес около 23 кг .\nВ холке 55 см .\nСкалли прекрасно подойдёт в молодую и активную семью!\nВ семью со взрослыми детьми, ведь ей нужны напарники по играм!\nСкалли отлично ладит с сородичами мужского пола, а вот с девочками не очень .\nТерриториально Бронницы','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Может проявить агрессию','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_33694/skalli_0_5ed521f89e8a6.jpg',169,165,NULL),(140,'Лили','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Коричневый','14','Хорошее','Предлагается к пристройству КРОШКА ЛИЛИ. Девчушке всего 2 года, она привита по возрасту, абсолютно здорова и свободна от паразитов.\nЛили стерилизована и поэтому уедет в семью без проблем с нежелательным потомством. Девочка отлично ходит на поводке, что является огромным плюсом! \nСобачка обожает! Просто обожает детей: может играть и играть часами, всячески угождая маленькому человеку!\nЛИЛИ весьма миролюбива и обязательно подружится с другой живностью вашего дома. А ещё, мы очень любим ловить мышей. Мы как маленькие лисички прыгаем за ними и поднимаем настроение всем вокруг!\n Несмотря на свою молодость, ЛИЛИ очень воспитанная и послушная собака , поэтому подойдёт компаньоном человеку, любящему спокойный и размеренный образ жизни или в семью, которая любит частые и долгие прогулки.\n\nЕсли Вам понравилась наша девочка, тогда звоните и приезжайте знакомится !','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_21569/lili_2_5d2eb755b3a64.jpg',170,166,NULL),(141,'Веста','Ищет дом','Женский','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','13','Хорошее','Москва и Московская область! Веста - фанат людей. Для неё человек - это рок-звезда! Она не стесняется выражать свой восторг и охотно, по поводу и без, признаётся в любви своему кумиру. Это собака - идеальный психолог, она повысит самооценку любому: возраст, пол, размер, вес, социальный статус, объем груди или кошелька для неё не имеют значения. Для неё Вы - идеал! Веста обожает детей и дружелюбна с собаками. Она немного презирает кошек, наверное, за то, что они, порой, ведут себя высокомерно с людьми. Поэтому Весте подойдёт любая компания за исключением пугливых кошек.\nЭто здоровая, жизнерадостная собака. Очень любит поесть! Этим можно воспользоваться, чтобы обучить её разным трюкам. Охранной собаки из нашей красотки, конечно, не выйдет, но свою территорию Веста чувствует, и с радостью будет служить \"звоночком\" в случае непрошенного вторжения. Это очень социальное существо, которому нужно внимание и общение. Ей будет хорошо в большой семье, где она никогда не останется в одиночестве. Веста мечтает найти любимого человека и посвятить ему свою жизнь!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_25026/vesta_0_5d4a7b45c4043.jpg',171,167,NULL),(142,'ЮМ','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Крупный','Семейная','Метис','Средняя','Рыжий','30','Хорошее','ЮМ\nРеальный красавец!\nМолодой, около 1,5 лет, рост 65 см, но при этом невероятно грациозный и красивый. Двигается изящно и из-за этого совсем не кажется крупным.\nНевероятно ориентирован на человека. В человеке готов раствориться.\nНежный, ласковый и добрый пес. \nС собаками дружелюбен, любит играть.\nНе конфликтный, но всегда готов постоять за себя и за хозяина.\nЕсли найдет дом и любящих хозяев, еще больше раскроется и станет реально бомбической собакой.\nЮм может жить и в квартире (очень комфортный пес), и за городом.\nЧипирован, привит, кастрирован.\nЗдоров.\nОтдается по договору с отслеживанием дальнейшей судьбы.\nМосква и область.\nКуратор Елена 89035337865','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_37742/yum_0_603e5f336006b.jpg',172,168,NULL),(143,'Ясения ( Яся)','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','20','Хорошее','Яся невероятно красивая, терьерного вида собачуля! Фото и видео не передает весь шарм и красоту брюнеточки. Яся, необыкновенная девочка, тянется к человеку, ей необходим человек, как воздух. Яся млодая девочка, привита, стрелизована, туалет строго на улице, любит прогулки и игры.  Яся прекрасная собачуля, ей срочно нужен свой человек!\nЛадит с другими собаками и кошками. ОБРАТИТЕ ВНИМАНИЕ!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40660/yaseniya-yasya_0_6026d2ec1fc96.jpg',173,169,NULL),(144,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',174,170,NULL),(145,'Верта','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крупный','Семейная','Метис','Средняя','Черный','16','Хорошее','Отдам собаку в добрые руки. По сложившимся жизненным обстоятельствам не могу ухаживать. Собака добрая, весёлая.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_42126/verta_0_6083b0527cc44.jpeg',175,171,NULL),(146,'Веста','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Коричневый','23','Хорошее','Веста - это метис Лайки и Акита-ину .\nСамая нежная и семейная. Подойдёт для активной семьи. Очень умная и воспитанная. Ей важно, чтоб кто-то её любил.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_31911/vesta_0_5e809033101ab.jpeg',176,172,NULL),(147,'Яшка','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Черный','16','Хорошее','Яша\nВозраст ~ 5 лет\nРазмер - по колено (40-45 см в холке)\nДобрый, активный и невероятно харизматичный мальчик очень ищет свою семью. Контактный, социализированный пёс, прекрасно ладит даже с абсолютно незнакомыми людьми. Замечательно дружит и уживается с собаками обоих полов, всегда не против поиграть, составить компанию. Яша очень уважает лакомства, за вкусняшку готов и попрыгать, и побегать, и мордашку умилительную состроить. Приезжайте на знакомство с чудесным мальчиком!\nПристраивается в дом или квартиру по Москве и МО, по договору ответственного содержания.\n✅ Яша — здоров, кастрирован, привит, обработан от паразитов, имеет вет. паспорт.\n\nПриезжайте в гости, знакомиться ➡️ Московская область, г. Химки, Большой Машкинский приют.','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40854/yashka_0_603372b251187.jpg',177,173,NULL),(148,'Бой','Ищет дом','Мужской','11 месяцев','Нет','-не уточнено-','Крупный','Семейная','Породистая','Средняя','Палевый','52','Хорошее','Молодой кобель Алабая Байкал ищет дом. Возраст до года, очень игривый , ласковый , не агрессивный, привит , имеет ветпаспорт, любит детей , дружит с другими собаками. Отдаётся в Московскую и ближайшие области , наличие вольера и хорошего забора обязательно','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Вольер','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41837/boj_0_60735b7004941.jpeg',178,174,NULL),(149,'Козлик','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Черный','22','Хорошее','Мудрые глазки смородинки у любителя подскакивать как козлёнок, выражая радость','Спокойный','Сдержанный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30344/kozlik_0_5e369425d85b2.jpeg',179,175,NULL),(150,'Габи','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Палевый','- не уточнено -','Хорошее','Необычайной красоты собака. Статная, умная, сильная.. Она знает себе цену. В то же время Габи очень нежная, добрая и ранимая девочка, очень уютная такая, домашняя собака. Это верный и мудрый друг. Отличный охранник! Все знает и умеет, совершенно готова к переезду. Габи лидер в собачьей среде, а человек лидер для нее бесприкословно.','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30974/gabi_0_5e50135f425c4.jpg',180,176,NULL),(151,'Комета','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Длинная','Белый','28','Хорошее','Комета. Ласковая лизунья и красотка.  Девочка нашла временное пристанище в приюте ГАВ. Но ей очень одиноко, она слишком социализированная и дружелюбная для постоянного сидения в вольере. Ей примерно 2-3 года. Стерилизована, привита. Не факт, что подойдет для охраны, слишком дружелюбна. Собака средних размеров, подойдет для дома и квартиры, очень сообразительная, подвижная.  Если вы хотите познакомиться с Кометой, пожалуйста, звоните +7 985 130 6103 – скоординируем встречу!','Активный','Общительный','- не уточнено -','- не уточнено -','Равнодушное','Квартира','- не уточнено -','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_40194/kometa_0_600c52e6a8e35.jpg',181,177,NULL),(152,'Беляш','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Белый','21','Хорошее','Беляш, 2 года. Ласковый до невозможности парень! Просто клад, а не пёс!\nБеляш здоров, привит и кастрирован.\nОчень дружелюбный как к человеку , так и к сородичам.\nПрекрасно ездит в машине, знает поводок.\nОчень хочется, чтобы этому прекрасному парню повезло!\nХотя больше всё-таки повезет его будущим хозяевам!\nТерриториально можно приехать и познакомиться с Беляшом в ближайшем Подмосковье.\nОтдаваться Беляш будет самым добрым и ответственным людям, с возможностью ненавязчивого отслеживания судьбы.\nВ дом привозим СТРОГО сами!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41461/belyash_0_6057620e106e2.jpg',182,178,NULL),(153,'Локки','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','16','Хорошее','Локки только исполнилось 6 месяцев. Но уже сейчас видно, что он вырастит очень красивым псом среднего размера со своей харизмой.  Локки здоров, привит, обработан от внешних и внутренних паразитов, есть вет. паспорт.  Смышлёный и игривый пёс, ориентирован на человека, дружелюбен к детям, другим собакам и котам. Малыш отлично освоил прогулки на поводке и поездки в машине, выгул на улице и жизнь в квартире. Он прекрасно уживётся в любой семье, с детьми и другими питомцами. Локки очень любознателен, очень любит гулять и играть с другими собаками. Он прекрасно впишется в семью с активной жизненной позицией.\nСейчас Локки находится на передержке в Щелковском районе во временной семье.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_27660/lokki_0_5dbc08c4df3ff.jpg',183,179,NULL),(154,'Гайка','Ищет дом','Женский','2 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Средняя','Палевый','41','Хорошее','Гайка - дружелюбный метис с впечатляющими размерами)\nИмеет устрашающий вид, но в душе \"одуванчик\" и самый что ни на есть ребенок.\nВысота в холке около 55 см, вес - около 40 кг.\nОбожает больших и маленьких людей, в компании с человеком примет участие в любой заварушке :).\nТерпит двухразовый выгул.\nДевочке около 2-х лет, привита,стерилизована, чипирована и полностью готова к переезду к любящим хозяевам.\nОтдается преимущественно на участок.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Вольер','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_34296/gajka_0_5f5a237801ab2.jpg',184,180,NULL),(155,'Зося','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','25','Хорошее','Зося молодая и очень (очень!) умная собака, очень послушная, старательная, компанейская и ласковая. Ей около 2 лет, стерилизована и привита. Приучена к дому и прогулкам. Добрая и общительная. Рост около 45 см, некрупная, стройная. Идеальная! Приезжайте, пожалуйста, познакомиться, погулять и пообниматься с Зосей!','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_16362/kompanejskaya-zosya_0_5b89ccb189aa6.jpg',185,181,NULL),(156,'Даллас','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Черный','34','Хорошее','В добрые руки великолепный красавчик - Даллас!Пару месяцев назад мальчика нашли запертым на закрытой площадке, где он просидел несколько часов. Как оказалось таким образом от него избавились бывшие хозяева, никак не позаботившись о его дальнейшей судьбе. И только благодаря неравнодушным людям, которые не прошли мимо - Даллас добрался в наш приют, где на данный момент находится в ожидании своей новой семьи и ответственных хозяев! Даллас невероятно красивый и статный парень, знающий себе цену! Прекрасно, атлетически сложен, с крепким костяком. На прогулке ведёт себя хорошо, не дёргает и не тянет поводок, знает базовые команды и за небольшое поощрение в виде лакомства, которые он обожает, продемонстрирует все свои умения. Доверие этого парня нужно завоевать! Из-за нехватки внимания в приюте и должного воспитания, склонен проявлять характер и «прощупывать» проводника на границы дозволенного, поэтому Далласу нужен человек с опытом содержания серьёзных пород, который в случае чего сможет поставить его на место и уделить Далласу достаточно времени на кинологические занятия и должное воспитание!\nДаллас совсем ещё молодой пёс и все присутствующие нюансы нежелательного поведения достаточно быстро корректируются и убираются дома при правильном подходе хозяев и здоровой атмосфере в новой семье. Присутствует зооагрессия, поэтому Даллас ищет дом без других животных. В семью с маленькими детьми тоже не подойдёт по причине нехватки должного воспитания. Кастрирован, привит, имеет ветеринарный паспорт, отдается бесплатно по договору ответственного содержания, только в опытные руки, людям старше 25 лет, без жилищных и материальных проблем, в Москву или МО. Звоните нам и приезжайте знакомится с этим красавцем!','Активный','Общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_38460/dallas_1_5fdb523e65899.jpeg',186,182,NULL),(157,'Дина','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','16','Хорошее','Очень ласковая, умная общительная, позитивная, дружелюбная девочка уже больше года живет в приюте. Дина молоденькая - ей 2,5-3 года, стерилизована, здорова. Отлично ладит с другими собаками и очень любит детей. Рост небольшой - см 40-45 в холке. Умеет ходить на поводке, послушная. Просто мечта, а не собака!!!!\nПоможем Диночке репостами /лайками обрести свою семью!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_39698/dina_0_5ff4e37d218ed.jpg',187,183,NULL),(158,'Байкал','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Коричневый','30','Хорошее','Очень ушастый, очень добрый, очень большой пёс!) Байкал такой же красивый как одноимённое озеро! Статный, видный, послушный, доверчивый компаньон! Полгода назад попал в приют Печатники. Очень любит обниматься! Иногда бывает неуклюжим и от этого смешным.) Обладает короткой шерстью, с которой не бывает проблем! Байкал достаточно молод, ему три четыре года, а может и того меньше, здоров, спокоен, терпелив! Кастрирован, привит, чипирован. Байкал чудесный пёс, вы не пожалеете, что подарили ему дом и любовь!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Загородный дом','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_42295/bajkal_0_6091a5d361c42.jpg',188,184,NULL),(159,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',189,185,NULL),(160,'Хан','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','23','Хорошее','Хан, крупный красивый пёс. Характер покладистый. Хорошо ладит с другими животными. С устойчивой психикой, на нападки собратьев не реагирует. Туалет терпит до выгула. Знает что такое ездить в машине. Крепкий желудок.','Спокойный','Общительный','Равнодушное','Равнодушное','Равнодушное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_25580/khan_0_5e005d9cb0853.jpg',190,186,NULL),(161,'Басма','Ищет дом','Мужской','9 месяцев','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','13','Хорошее','Басма - невероятно обаятельный щенок, похож на метиса лабрадора. Очень сообразительный малыш, любит учится, уже умеет давать лапу, сидеть и делать \"зайку\")\nВырастет крупным (до 55см в холке), пристраивается в квартиру или дом, строго не в вольер и не на цепь, с ненавязчивым отслеживанием дальнейшей судьбы собаки. Находится в приюте Бирюлево.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_38259/basma_0_5fd753d048fdb.jpg',191,187,NULL),(162,'Корсар','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Палевый','14','Хорошее','Москва и МО (г. Подольск).\n?Приглядитесь к этому чудесному малышу , ему очень нужен дом! Посмотрите в эти глазки пуговки, возможно это Ваше кареглазое счастье и Вы ищите именно его! Подарите ему дом и тепло своего Сердца, а он обязательно ответит любовью и преданностью. Корсару всего 1,5-2 года, вес 14 кг, активен, дружелюбен с кошками и собаками.\nНиже колена\nПуглив, в квартире ведёт себя отлично, туалет два раза в день. Обработан от всех паразитов, по анализам здоров, привит.\nОтдаётся по договору, с ненавязчивым отслеживанием, в квартиру или частный дом.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_27031/korsar_0_5da43d87ac627.jpg',192,188,NULL),(163,'Луна','Ищет дом','Женский','9 месяцев','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','7','Хорошее','Привет, меня зовут Луна.\nЯ слышала , как обо мне спрашивали, но узнали, что я беспородная и не захотели знакомиться. А ведь я так стараюсь, чтобы меня полюбили, больше всех-всех чемпионов собачьих выставок. Я за один день научилась командам \"сидеть\" и \"ко мне\", даже понимаю, что вещи людей нельзя грызть, даже если хочется. \nЕще я очень сильно люблю детей, только они не обращают на меня внимания, может быть у вас есть дети? Я обещаю их любить и защищать. \nНеужели меня никто не возьмет к себе только потому, что во мне нет породы? Моя порода - друг, такой верный, что на прогулке я никуда от вас не убегу даже без поводка и буду рядом всю свою не очень долгую жизнь. Отчего же никто не хочет сделать меня своей домашней собакой? Так это уютно звучит... это моя самая большая мечта. \nЯ очень сильно надеюсь, что в таком большом мире найдётся для меня такая же большая любвь.','Спокойный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Загородный дом','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_38687/luna_0_5fb7e444554f2.jpeg',193,189,NULL),(164,'Лана','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','6','Хорошее','Лана, 6 месяцев. Очаровательная малышка с красивым кремовым окрасом, ласковая, жизнелюбивая с маленьким моторчиком в сердечке. Ланочка - щенок с интеллектом, легко обучаема и очень внимательна к людям. Маленькая, но уже послушная, прислушивается к командам, любит игрушки, учится ходить на поводке и постигает правила порядка в доме. Это пушистое облачко подарит вам самые лучшие годы совместной жизни. Она абсолютно здорова, привита, обработана и имеет уже свой собственный паспорт. Дружит со всеми членами семьи : и с кошками, и с детишками и с другими собачками.\nЖивет на квартирной передержке. Пристраивается по договору ответственного содержания и стерилизации по возрасту.\nТерриториально Люберцы.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_28984/lana_0_5df1eede55857.jpg',194,190,NULL),(165,'Лора','Ищет дом','Женский','3 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Палевый','29','Хорошее','Ласковая, жизнерадостная доверчивая девочка 1,5 года, 55 см в холке, ищет ответственных родителей, обещает быть послушным ребенком. Не конфликтная,  любит всех без исключения. Приучена к поводку.\n Стерилизована, привита. Ветпаспорт','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_23537/lora_0_5cfffb8c0b3c6.png',195,191,NULL),(166,'Сергуня','Ищет дом','Мужской','8 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Серый','32','Хорошее','Сергуня - чудесный Мужчина в самом расцвете сил. Сергуня живет в приюте давно, его долго никто не выводил из клетки. И только месяц назад с ним начали заниматься. Несмотря на долгий срок неволи Сергуня  быстро начал выходить гулять, очень старается понравиться. Он очень хочет общаться с Человеком и очень тянется к нему. Но, к сожалению, прошлые травмы дают о себе знать. Пока Он очень осторожен с новыми людьми - немного боится прикосновений, переживает, но каждый раз делает все большие Успехи. С Сергуней сейчас активно занимаются - Он быстро обучается и уже готов с Вами познакомиться, и, наконец, обрести тот самый долгожданный Дом! Сергуня заново обретает Веру в людей! Пожалуйста, дайте ему поверить до конца и полюбить именно Вас! Он чудесный Мальчик, просто невероятный, но пока ему страшно. Но, именно Вы можете дать ему Шанс открыться, Радоваться Вам, Любить Вас всем сердцем и Душой, наполнить жизнь Сергуни такими же яркими красками, как его разноцветный ошейник! Приезжайте, пожалуйста, к Сергуне!','Спокойный','Сдержанный','Равнодушное','Равнодушное','Равнодушное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_16247/sergunya_0_5b840da03baef.jpg',196,192,NULL),(167,'Ларсик','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Средняя','Коричневый','41','Хорошее','Ларсик в добрые руки. Классный пёс','Активный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35358/larsik_0_5f1d9807922ef.jpeg',197,193,NULL),(168,'Норрис','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','30','Хорошее','Жгучий брюнет Норрис хочет домой!\n\nНоррис очень позитивный и веселый пёс. Его энергии хватит на всю семью, он готов бегать, играть, веселиться и радоваться жизни со всеми. Норрис наслаждается каждой минутой и помогает не отчаиваться каждому, кто его видит.\n\nНоррис активный пёс, ему требуются долгие, активные прогулки и конечно море любви! Он обожает обниматься и с радостью подставляет бочка для почесушек)\n\nНоррису примерно 4 года, он здоров, привит, кастрирован, хорошо ходит на поводке, но может немножко тянуть, когда слишком чем-то заинтересуется.\nСкорее звоните и приезжайте знакомиться!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_28196/norris_0_5dd55e3d3a0ea.jpg',198,194,NULL),(169,'Лорд','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','35','Хорошее','Лорд, срочно ищет дом, примерно 4 года, здоров, кастрирован. Собака друг, компаньон. К сородичам лоялен, с кошками дружит. В еде не привередлив. Пристраивается в частный дом или квартиру.','Спокойный','Общительный','Равнодушное','Доброжелательное','Равнодушное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_27134/lord_0_5da7615711319.jpg',199,195,NULL),(170,'Рэй','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Черный','28','Хорошее','Отличный друг, славный компаньон и просто хороший мальчик ищет своего самого лучшего человека!\nСовсем еще молодой кобель, чуть старше года, ростом выше колена, весит на данный момент 28,5 кг. Внешне чем-то напоминает босерона или ротвейлера.\nСпокойный, послушный и ласковый пёс. Любит почесушки, вкусняшки и поваляться у человека в ногах. Ненавязчивый, готов просто лежать рядом и наблюдать.\nСпокойно воспринимает манипуляции с собой: дает мыть уши, чистить зубы. Лапы давать пока стесняется, ложится, прячет под собой. Но не огрызается, если их мыть или стричь когти.\nХорошо ходит на поводке, только с энтузиазмом реагирует на кошек. Без поводка ходит рядом, подходит на подзыв.\nЗнает команды: сидеть, дай лапу, стой (при переходе улицы). Умеет ездить в машине на заднем сидении или в ногах пассажира.\nЛадит с другими собаками. На кошек реагирует с большим интересом, может попытаться погнаться, но человека слушает и сильно не рвется.\nОчень ориентирован на человека, поэтому быстро понимает, что от него хотят и хорошо воспитывается.\nНа данный момент собак находится в Центре помощи бездомным животным \"Любимец\" в Туле:\nТула, ул. Набережная, 3 (Криволучье), тел. 8 (920) 277-00-02\nПриезжайте знакомиться с замечательным Рэем! :)','Спокойный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_34603/rej_0_5f16d90a00163.jpg',200,196,NULL),(171,'Тайна','Ищет дом','Женский','4 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Рыжий','26','Хорошее','Тайна, в противовес своему имени, очень открытая и дружелюбная собака. Активная, красивая, общительная, забавная, умная и просто неповторимая. Тая из тех собак, кто \"за любой кипиш, кроме голодовки\". Бегать - \"ЗА\", играть - \"ЗА\", ласкаться и лежать на спинке, требуя нежности, тоже- \"ЗА\" (ну, а с голодовкой Вы поняли). Несмотря на совсем юный возраст, Тайна очень сообразительная и умная, за один заход выучила команды \"сидеть\" и\" дай лапу\" (что в условиях приюта очень непросто) и готова покорять новые вершины. Такое необычное имя досталось ей неспроста, как нам кажется, Тайна знает пару очень важных секретов, которыми поделится только с любимым человеком. Например, \"как любить искренне и всей душой\", \"как всю жизнь быть верным другом\", \"как одним взглядом растопить даже самое холодное сердце\", \"как два раза в день выходить на прогулку и держать себя в форме\" и многое другое. Если Вы хотите это знать, если хотите найти настоящего друга, хотите любить и быть любимым, то просто приезжайте и забирайте Тайну домой, она сделает Вас счастливым.\n\nТайна здорова, привита, стерилизована, возраст 4,5 года.','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40481/tajna_0_601fea2c8d8fd.jpeg',201,197,NULL),(172,'Лиса','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','22','Хорошее','Лиса-собака улыбка,обнимака и пузочесака!Лиса   ждет и кроме приюта незнала другой жизни.\nОчень общительная,позитивная,солнечная девочка.Любит гулять,тянется к человеку,адекватна с сородичами.Лисе около 3 лет,в холке 57см,стерилизованна.Любит обниматься,все аремя старается быть рядом с человеком быть в его поле зрения.Ласковая Рыжая Лиса.Только при знакомстве с ней поймете ,всю ее энергию и любовь.','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_32901/lisa_0_5eaee5758f751.jpg',202,198,NULL),(173,'Лукаша','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','30','Хорошее','Лукаша - нежная, очаровательная девочка, около 5 лет. Лукаша очень любит общаться с людьми, ласковая, доброжелательная, открытая, игривая! Лукаша обладает нереально мягкой шерсткой и очаровательной улыбкой! Лукаша очень любит чесаться и обниматься! Мы не понимаем, почему такая нереальная собака до сих пор без Хозяина... объяснение одно - она ждет своего Человека! У которого можно будет выпросить вкусняшку и лизнуть его за это в щечку, радоваться, когда он приходит и тихонечко сопеть рядышком у ног... Приезжайте, пожалуйста, знакомиться к Лукаше и Вы точно увидите, что Вы - тот Самый Человек для нее, а она - именно Ваша Собака!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_16444/nezhnaya-lukasha_0_5b8efd293e19a.jpg',203,199,NULL),(174,'Небольшая Терра','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Рыжий','17','Хорошее','Очаровательная Терра ищет любящую семью!!! Девочка нежная, добрая, спокойная. Яркая внешность , скромный нрав, некрупный размер. Хорошо ходит на поводке, культурно ведёт дома. \nЕй около двух лет, рост 47см, ниже колена, похожа на метиса пшеничного терьера.\nОтдаём по договору надёжным людям \nЗвоните!!!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_28128/nebolshaya-alisa_0_5ecd8dbf937a0.jpg',204,200,NULL),(175,'Амалия','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','17','Хорошее','Глядя на славную лисью мордашку Амалии в голове возникает только один вопрос: «Ну кто посмел такую обидеть?». Однако судьба не была к ней благосклонна. Она никогда никому не расскажет, что с ней происходило раньше, не пожалуется и не будет плакать, но все можно прочитать в ее глазах. Сейчас Амалия старается снова поверить людям и уже делает огромные успехи, однако для полного счастья собачке не хватает любящих хозяев... Мы искренне верим, что она дождется, потому что ее имя по одной из версий означает «стремление» и «ожидание». Девочка в самом расцвете, ей всего 5 лет. Настоящая красотка с лисьим окрасом, милейшими ушками и едва заметной улыбкой. Это очень нежная, трепетная и ласковая собачка. Ее истории из тех, что трогают до слез. С первых минут в приюте собака была в стрессе, ко всем относилась настороженно, не признавала поводок, забивалась в угол. А теперь эта девочка даже умеет обниматься! Конечно, ее доверие нужно заслужить, но Амалия с радостью откроется вам, как только почувствует, что рядом с ней хороший человек.К игрушкам она относится равнодушно, но очень любит, когда ее ласкают и гладят, хоть и пытается не подавать виду. Она совсем недавно заново научилась доверять людям и еще продолжает учиться. Амалии как воздух необходима спокойная обстановка, а не жизнь в вольере с другими собаками, чтобы она наконец смогла расслабиться и почувствовать себя в безопасности.Девочка стерилизована, привита и полностью здорова!Подарите Амалии новую жизнь! Дайте шанс поверить, что люди способны на любовь и искреннюю заботу. Она в долгу не останется и будет для вас самым верным другом. Присмотритесь к нашей девочке. Вдруг она ждет именно вас!Звоните!','Спокойный','Сдержанный','Равнодушное','Равнодушное','Равнодушное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_22937/amaliya_0_601593b30458b.jpg',205,201,NULL),(176,'Анита','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','22','Хорошее','Ищем новый дом кареглазой красавице! Общительная, ласковая, доверчивая девочка. Дружелюбно настроена ко всем вокруг. Ни капли вредности, ни капли агрессивности. Солнечная собачка! Подойдет в семью с детьми, а также второй собакой в дом. Аните около 5-6лет. В холке - около 50 см. Стерилизована. Звоните! Территориально - м.\"Выхино\".','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30785/anita_0_5e48064f97fa6.jpg',206,202,NULL),(177,'Дик','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Рыжий','25','Хорошее','...Люди успели во-время, так как он уже практически не двигался, свернулся калачиком, и уже засыпал навсегда, поздним вечером в 20-ти градусный мороз...Но ему не дали заснуть мертвым сном, растолкали и затащили в подьезд. А затем, пёс оказался на временной домашней передержке у своей спасительницы. К сожалению, девушка, приютившая спасенного, не может оставить его у себя насовсем. Поэтому мы ОЧЕНЬ ИЩЕМ  надежный дом и любящих хозяев!\nСпасенный оказался добрым и веселым молодым парнем. Высокий, в холке 65 см, с красивейшим тигровым окрасом, где огненно-рыжий цвет переливается с черным. Явно был домашним: шерсть чистая,отличные белые зубы, прятаться от холода не умеет, засыпал от усталости где придется...Удалось узнать, что скитается уже какое-то время. Агрессии нет совсем, прекрасно ладит с людьми, отлично играет с детьми 10-12 лет, с кошками нейтрально. Дома ничего не рушит, выгул терпит, приключений не ищет. Ходить на поводке пока не очень умеет, возможно жил на частном секторе, и собакой не занимались. Посетили ветклинику: по осмотру врача, 1-1,5 лет, здоров. От глистов и паразитов обработан.\n\n❗ВНИМАНИЕ❗ Наш спасенный почти не лает и охранных качеств не проявляет! А значит, на должность охранника НЕ ПОДХОДИТ!\nЗато с радостью будет дружить, доверять, и составит душевную компанию в прогулках и играх в семье с детьми и активным образом жизни! Очень ориентирован на человека, любит детей!\nОтдается в дар взрослым людям, после личного знакомства с собакой, по договору ответственного содержания, с периодическими фото- и видео-приветами из дома. В квартиру или дом, строго не на цепь.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_40785/dik_0_602e5fbe2224f.jpg',207,203,NULL),(178,'Данай','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','Данай – молодой, сильный и энергичный пёс. По характеру весельчак – вся жизнь игра! Ему только дай волю побегать, будет носиться пока язык на плечо не повиснет) При этом прыгать и скакать вы будете вместе с ним, поэтому физическая активность вам обеспечена.\n\nС Данаем нужно заниматься, обучать командам, что у него отлично получается. Он вырос, но еще совсем щенок, что видно по его взгляду и любопытству. Поэтому его энергию нужно направлять в правильное русло. С такой собакой точно скучно не будет! Когда он бежит за мячиком - очень смешно фырчит, а если мячик спрятать за спиной, то вы станете для него великим фокусником и магом, который демонстрирует великие чудеса появления и исчезновения мяча! А значит - он в вашей власти и вы можете чесать и трепать его мощную шею сколько угодно. Но за вкусняшку он будет особенно благодарен.\n\nОчень дружелюбный пес, найдет общий язык со всеми хвостатыми.\nОтлично ладит с детьми.\n\nКастрирован, привит, здоров, отлично ходит на поводке.\nДанай отдается по договору ответственного содержания в Москву и МО.\nСтрого не в будку и не на цепь.\nПриезжайте в приют “Солнцево”, чтобы познакомиться с Данаем и забрать его в свою семью.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_42243/danaj_0_608c14821ee76.jpg',208,204,NULL),(179,'Ёлка','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Породистая','Средняя','Черный','28','Хорошее','В добрые руки пристраивается очень милая девочка Ёлка! Возраст - 5 лет. \nВстречайте Новый Год правильно, выбирайте правильную ёлку, нашу Ёлку!)) Эта девочка - сосредоточение любви, ласки и доброты. Только посмотрите с какой нежностью эта девочка смотрит на человека❤️ Сказать, что она любит людей - это не сказать ничего! Она просто нас всех обожает и боготворит. Спешите сделать счастливыми себя и девочку - забирайте красотку домой! А ещё Ёлочка совершенно неконфликтная собака и может найти общий язык с собакой любого пола и равнодушно относится к кошкам! Стерилизована, привита, имеет ветеринарный паспорт, отдаётся бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. Если Вы готовы подарить девочке дом, то звоните нам и мы ответим на любые Ваши вопросы о девочке!)','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_39292/jolka_0_5fd78910a9955.jpeg',209,205,NULL),(180,'Граф','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Рыжий','33','Хорошее','ГРАФ\nГраф активный, любознательный, игривый пес.\nВозраст около 2-х лет, в холке 55 см, весом 38 кг.\nСильный и уверенный в себе.\nОтличный друг и защитник.\nС чувством собственного достоинства.\nС собаками старается быть лидером.\nК кошкам равнодушен.\nГрафу нужен требовательный хозяин, который будет для него старшим товарищем и другом.\n\nКуратор: Елена\nОтдается строго по договору с возможностью отслеживания дальнейшую судьбу, в Москву или МО, квартиру или загородный дом','Активный','Сдержанный','Доброжелательное','Равнодушное','Может проявить агрессию','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_33951/graf_0_603bfa34e94c1.jpg',210,206,NULL),(181,'Неймар','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Коричневый','29','Хорошее','В добрые руки пристраивается энергичный и молодой Неймар! \nНеймар - это найденыш из Ногинска и пусть мы ничего не знаем о его прошлом, но мы видим, что он очень славный, и совершенно безобидный паренёк, который станет отличным другом для любой семьи!) Неймар очень подвижный и активный парень, поэтому будущие хозяева должны быть готовы к длительным активным прогулкам и занятиям с мальчишкой, как самостоятельно, так и с кинологом, чтобы развивать его не только физически, но и умственно. Да и занятия с Неймаром - это одно удовольствие, он очень старается и пытается выполнить всё, что от него требует человек. Вообще Неймар очень любит находиться в контакте с человеком, всегда радостно подбегает на подзыв, игрушку-канатик приносит и кладёт рядом с человеком, чтобы дальше продолжить игру. Обожает играть, хотя, что с него взять, молодость у мальчишки бьёт ключом))) Очень тяжело Неймару в приюте без полноценного активного выгула, поэтому когда выходит на прогулку тянет и может прихватывать поводок или хватать за одежду, но всё это от переизбытка энергии и чувств. После 30 минутной прогулки уже начинает гулять довольно сносно. А ещё Неймарчик дружелюбно относится к другим собакам, поэтому его можно брать вторым питомцем в семью! Неймар кастрирован, привит,  имеет ветеринарный паспорт, отдаётся бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. Если Вы хотите подарить Неймару дом, то звоните нам и приезжайте с ним знакомиться)','Активный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_41674/nejmar_0_6065da395502f.jpeg',211,207,NULL),(182,'Арчи','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','29','Хорошее','Активный парень. Очень ласковый. Умеет зодить на поводке. Спокойно ездит в машине. Ориентирован на человека, любит детей и равнодушен к кошкам.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_11893/archi_1_5a61ae50bb82d.jpg',212,208,NULL),(183,'Леди','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Рыжий','18','Хорошее','После развода с женой остались вдвоем с собакой. Я сутками мотаюсь по работе, в том числе в другие города. Собаня ждёт, скулит и чахнет в четырех стенах. Пристраивал на передержку, но обращались с ней не очень, похудела и стала более нервной. Сейчас ест нормально, но на собаку катастрофически не хватает времени. В ближайшем будущем планируются регулярные поездки за границу, поэтому стараюсь пристроить в хорошие руки. Собака игривая, добрая, энергичная, всегда чудит и поднимает настроение.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31594/ledi_0_5e6bd3350e041.jpg',213,209,NULL),(184,'Ария','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','16','Хорошее','Ария — невероятная нежная лиричная натура, необычна не только своим тигровым окрасом, но и глубиной души. В опере жизни у Арии главное место занимает человек. Она обожает получать ласку и дарить ее. Хвост Арии всегда двигается в такт самой задорной мелодии, которой нет конца. Наша Ария бесконечна, прекрасна и пронзительна, поверьте, она никого не оставит равнодушным. Она умеет привлекать к себе внимание, и заставлять взор остановиться именно на ней.\n\nАрии около 5 лет, она небольшого размера, привита, стерилизована. Отлично ладит со своими сородичами, полностью здорова и готова отправиться домой','Спокойный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40477/ariya_0_601fe62b109c1.jpeg',214,210,NULL),(185,'Пэнни','Ищет дом','Женский','8 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','- не уточнено -','Хорошее','Привет! Я так хочу каждый день открывать что-то интересное для нас с тобой!\nОй, даже не представилась! Пэнни, 3-4 года, рост 55см. Я стройная и стерилизованная. Собака бесплатно (то есть я) – это самое правильное решение! Я так хочу дружить и дарить вам свою любовь!\nЯ активная и легко стану компаньоном в любом деле! Люблю играть и дурачиться. Хорошо хожу на поводке и без него. Могу жить в квартире. А если у вас дом за городом, это тоже хорошо!\nЯ не навязчивая, а очень даже самостоятельная! Я же все понимаю.\nВозьмите меня в свою семью! И мы будем открывать что-то новое и интересное вместе!','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_1051/penni_0_55c34fe3b8c92.jpeg',215,211,NULL),(186,'Джульетта','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','13','Хорошее','Ищет дом Джульетта!!! Оранжевая, длинноногая, статная, со смешной маленькой бородкой!!! \nДжуля молода и активна, любит играть и бегать с другими собаками. Но забывает обо всём, если рядом человек! Она садится напротив, подает вам лапу и заглядывает в глаза так, что хочется её обнять и рассказать обо всех своих горестях! Она обнимет вас в ответ, лизнет в лицо и будет оставаться с вами столько, сколько вы захотите! \nДжульетта очень нежная и трогательная девочка. С нею можно разговаривать по душам и обниматься часами! \nДжуле чуть больше года, примерно 55-57 см в холке, она привита и стерилизована. Осваивает поводок. Дружелюбна к другим собакам. Она очень ждёт своего человека, который никогда не предаст. \nЕсли вам нужна душевная подруга на долгие годы – звоните и приезжайте знакомиться! Джуля находится на передержке в Калужской области. \n8 920 092 94 33 Елена, \n8 910 914 32 42 Ирина.','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Вольер','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_22925/dzhuletta_0_5ce256fb55dd9.jpg',216,212,NULL),(187,'Барни','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','28','Хорошее','Барни- взрослый состоявшийся пес, умный и с сильным характером. Он лидер среди собак, но человек для него главный ориентир. Он выборочно признает людей, но признав, откроется вам и подарит много эмоций, нежности и драйва. У Барни очень живой ум, он с удовольствием учится командам, проходит дрессировочную площадку. Это активный пес, он любит побегать и поиграть. Ярко выражены охранные качества.\nБарни настоящий пёс! Собака, такая, которую многие себе представляют в мечтах. Своих любит до безумия, к чужим не ластится, показывая всю ценность хозяина. Умный и невозможно обаятельный.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_29810/barni_0_5fd65fbd63e28.jpg',217,213,NULL),(188,'Ася','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','21','Хорошее','Знакомьтесь, Ася!!!\nИстория Аси : \nЛетом 2020 г нам поступило сообщение, что недалеко от Обнинска, в поле, выбросили суку с новорождёнными щенками. Приехав на место, мы ужаснулись : поле, рядом дорога и худющая собака с мольбой и вопросом в глазах \" вы же не оставите меня тут на смерть ?\", а рядом её крошечные щенки. Собака была вся в клещах, голодная. \nТак Ася и её малыши оказались в приюте. \nАсе года 2, сделаны все прививки, стерилизована, среднего размера (по колено). \nРост в холке 55 см \nВес 20 кг \nАся ласковая, добрая, обучаемая собака. \nСможет жить в квартире или в доме(в самом доме).','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_39068/asya_0_608509c56748b.jpg',218,214,NULL),(189,'Дарси','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','25','Хорошее','Дарси. Кобель 5 лет. Добрый. Без агрессии. Кастрирован. Привит. Здоров. Приучен к жизни в квартире. Гуляет спокойно на поводке. С другими животными дружит.','Спокойный','Сдержанный','Равнодушное','Доброжелательное','Доброжелательное','Вольер','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_33373/darsi_0_5ec419ea86764.jpg',219,215,NULL),(190,'Альма','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Охранник','Беспородная','Короткая','Черный','9','Хорошее','Нашел на улице.\nОчень активная. Уже обучили некоторым командам.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Нет','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_26700/alma_0_5d96148243966.jpg',220,216,NULL),(191,'Марфуша','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','- не уточнено -','Хорошее','Москва, МО!\nЗнакомьтесь с классной собакой: задорной девчушкой Марфушей! Это действительно золотая собака, в самом прекрасном её проявлении. Она идеально подойдет в молодую, активную семью. \n\nМарфуша настоящий оптимист, очень добрая и ласковая малышка. Эта маленькая егоза, как озорной ребёнок за любой весёлый кипишь. Марфа дружелюбна к собакам, котикам и детям. Очень ориентирована на человека, послушная, как бы не была увлечена игрой, всегда слышит человека. Марфушка - настоящее сокровище! Возраст девочки 1 год, вес 15 кг. Здорова, привита и стерилизована. Марфушенька знает поводок, терпит выгул и знает набор базовых команд. \n\nДайте шанс счастливой жизни встретиться с вами и Марфушенькой. Она всеми лапками тянется к новым людям и готова к переезду. \n\nЕсли хотите познакомиться с Марфой, звоните:  +7 985 785 00 18 Яна \nГотовый компаньон на долгие годы!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Вольер','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_39031/marfusha_0_5fca5ce1aa823.jpeg',221,217,NULL),(192,'Василиса','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Палевый','18','Хорошее','Василиса словно грациозная лань. У нее изящная фигурка, длинные тонкие лапы, короткая шерсть и бездонные глаза. Она эмоциональная, сообразительная девочка, все мысли и чувства которой мигом читаются в огромных умных глазах. Она кроткая, деликатная, ни при каких обстоятельствах не позволяет себе проявлять агрессию или хотя бы раздражение.  Василиса не будет навязывать свое общество. При этом с радостью и доверием откроет огромное сердце человеку, который проявит к ней доброту и уважение. \nВасилиса оказалась на улице, после чего попала в приют. Это тяжелое испытание для такого нежного существа. Возвращаясь после прогулки, Василисе каждый раз приходится преодолевать себя, возвращаясь в клетку. Прежних хозяев не нашли. Ищем новых, самых добрых и ответственных.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Равнодушное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41939/vasilisa_1_60796ed903e9c.jpg',222,218,NULL),(193,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',223,219,NULL),(194,'Джастин','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','20','Хорошее','Это наш Джастин, ему около года. Совсем молодой небольшой мальчишка. Помесь собачки с овечкой))). У него уникальная курчавая шерсть на спине. Джастин очень комфортный, добрый, ласковый. Легко обучается, послушный. Трогательный и нежный, настоящая семейная собака! С другими животными и конечно с детьми на пятёрку! Здоров, привит','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_13394/dzhastin_0_5aba40374c07d.jpg',224,220,NULL),(195,'Марфа','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Коричневый','14','Хорошее','Обаятельная Марфа ждёт свою семью!\nМарфуша настоящий оптимист, очень добрая и ласковая малышка. Эта маленькая егоза, как озорной ребёнок за любой весёлый кипишь. Марфа дружелюбна к собакам, котикам и детям. Очень ориентирована на человека, послушная, как бы не была увлечена игрой, всегда слышит человека. \nМарфушка - настоящее сокровище!\n.\n•возраст 7-8 месяцев \n•вес 11 кг\n•здорова, привита, стерилизована\n•знает поводок • терпит выгул','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_36507/marfa_0_5f564f2686a2c.jpeg',225,221,NULL),(196,'Босс','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Длинная','Рыжий','12','Хорошее','Рыжий коротколапик, метис спаниеля Босс в дар.\nРыжий красавчик Босс ищет дом.\nБосс маленький пушистый коротколапик, похож на метиса спаниеля.\nМолодой, возраст 1,5 года.\nРост в холке 35 см, вес 12 кг.\nЗдоров, привит, кастрирован.\nБосс ласковый, спокойный, домашний и общительный.\nХорошо ходит на поводке.\nДружит с другими собаками.\nВ дар.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_39484/boss_0_5fe5035f73e05.jpg',226,222,NULL),(197,'Булочка','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Серый','18','Хорошее','А вы хотели бы завести вторую собаку? Если да – то Булочка идеальный вариант второй собаки, которая очень уважительно относится к мудрым взрослым псам, ведь с ними так интересно разговаривать обо всем на свете.\nНо Булочка и сама знает много и столько же умеет! Команды – ко мне, нельзя, фу, сидеть, ждать – она выполняет легко и с удовольствием. Но самое главное – она уже приучена к двухразовому выгулу!\nБу не самая доверчивая девушка, но прогрессирует с невероятной скоростью, потому что она уже хочет быть чьей-то “любимой Булочкой” и “нежной Бу”. \nБулочке около 2-х лет, она проживает на кинологической передержке. Отдается по договору с ненавязчивым отслеживанием дальнейшей судьбы.\nБу ждет звонков и будет рада личной встрече.','Спокойный','Сдержанный','Равнодушное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_36447/bulochka_0_5f533914ab2e0.jpg',227,223,NULL),(198,'Граф','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Длинная','Палевый','20','Хорошее','Знакомьтесь, это Граф. Статный и невероятно красивый 2-летний мокрый нос! Полная кличка #доблестный_Граффиас ✨\nЕго назвали в честь звёздочки в созвездии Скорпиона, потому ярче этого парня никого не найти! В его глазах - целый мир, он очень добрый, спокойный и ласковый пес? Граф очень душевная собака. Долгие объятия - это про него. Он станет поддержкой и опорой своему будущему хозяину, будет дарить ему любовь и охранять от всех невзгод. Малыш знает команды, хорошо гуляет на поводке, здоров и кастрирован. Любит поиграть с другими собаками! Открыт к знакомствам с потенциальными родителями?\n\nОтличный вариант для квартиры или дома! Ростом чуть-чуть выше колена, то есть совсем кроха? Полностью готов ехать домой!','Спокойный','Общительный','Равнодушное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_36411/graf_0_5f5117cb9e387.jpeg',228,224,NULL),(199,'Норд','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Породистая','Средняя','Серый','22','Хорошее','Ищет дом и любящих хозяев Хаска Норд. Возраст 10 мес. Веселый , активный , ласковый ребёнок. Со всеми дружит, всех любит. Здоров , привит, кастрирован , хорошо гуляет на поводке , знает машину. Хаски ездовые собаки, поэтому нуждается в активном выгуле. Пристраивается людям, старше 25 лет, не имеющих проблем с жильём , Москва или МО.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40546/nord_0_6022c820b7d50.jpeg',229,225,NULL),(200,'Викки','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','20','Хорошее','Викки - скромная, ласковая и смышленая собачка. Доброжелательна с другими животными - собаками и кошками. Викки 1,5 года, здорова, привита, стерилизована, имеет ветпаспорт. Пристраивается в Москву и Московскую область.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_17105/triksi_0_5c6beb7cea75c.jpg',230,226,NULL),(201,'Дик','Ищет дом','Мужской','7 лет','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Рыжий','45','Хорошее','Карело-финскую лайку  в добрые руки: кобель 7 лет. Уличное содержание. Ест всё.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Может проявить агрессию','Загородный дом','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_36262/dik_0_5f47bb4f39c8a.jpg',231,227,NULL),(202,'Ася','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Рыжий','5','Хорошее','Замечательна лопоухая чудачка по имени Ася ищет дом и любящих родителей. \nАсе сделаны все прививки, сейчас ей 5 месяца, есть паспорт. В данный момент приучаем к выгулу.\nУ Аси очень тонкая душевная организация, она как нежный цветочек, очень ласковая и нежная, ориентирована на человека.\nАся крайне бережливая к своим вещам и игрушечкам, поиграет, а потом все складывает на своей лежаночке чтобы ничего не потерялось. \nСобачка изящная, будет небольшой, на мордочке появляются забавные усики и бородка, ушастая и лопоухая, а глаза чайного цвета, заглядывают прямо в душу. \nСобака очень добрая и доверчивая, ищем ей достойных родителей, которые относятся к собаке как равному члену семьи. \nКуратор \nОльга','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_31707/asya_0_5e73c87f066c7.jpg',232,228,NULL),(203,'Богдан','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','17','Хорошее','Наш герой-юноша! Партийная кличка-БОГДАН!\nСкромняга и джентльмен. Практически настоящий офицер!\nНеспешен, рассудителен, на новом месте будет застенчив и ооочень деликатен! Он привыкает к людям и обстоятельствам постепенно, но как только освоится, станет Вам надежным и верным другом!\nЛичность весомая. Будет среднего размера!\nПристраивается в квартиру или частный дом.\nТехнические детали:\nВозраст 10 месяцев.\nВес около 17 кг.\nЗдоров.\nПривит.\nВ холке 45 см.\nПриучен к поводку, к жизни в квартире, знает некоторые команды.\nМожно в частный дом, но строго не на цепь и не в будку!\nТерриториально м. Владыкино, в новый дом доставим по Москве и Мо.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31539/bogdan_0_5e6a1281d7df6.jpg',233,229,NULL),(204,'Клео','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Белый','- не уточнено -','Хорошее','Клео полтора года и при знакомстве с ним трудно поверить, что он обитатель приюта. Он изящен, задумчив и аристократичен. У него необычный окрас и взгляд, полный благородства. Может долго разглядывать интересную травинку или смотреть вдаль, размышляя о своём, собачьем. Но вот проходит миг, и он со всех лап мчится тебя догонять, затевает игры с другими собаками, подставляет мордочку для ласк и нетерпеливо садится при шорохе пакета с угощением.\nКлео знает команду \"сидеть\", отлично идёт рядом на поводке и ничего не имеет против намордника. \nКастрирован, привит, чипирован, имеет вет.паспорт.\nКлео создан для теплого дома и любящей семьи - приходите к нему в гости в приют \"Красная сосна\" и вы сами в этом убедитесь!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_28680/kleo_0_5de77a01a3a76.jpg',234,230,NULL),(205,'Умка','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','10','Хорошее','Привет, меня зовут Умка. Мне 3 месяца. Я красавица. Когда вырасту – буду вам по колено. А ещё я умная, ласковая, смелая, люблю кататься на машине и играть с детьми. И, кстати, не смотря на мой юный возраст, я уже хороший сторож! \nС самого начала жизнь была не очень благосклонна ко мне. Однажды со мной случилось что-то очень страшное. Лучше и не вспоминать. Но потом вдруг звёзды выстроились в каком-то ином порядке. И меня спасли! Неравнодушные люди, почти что дети. Они нашли меня раненую на улице, привезли в клинику, вылечили. И теперь я у них. Правда, временно… \nПоэтому обращаюсь к своим будущим маме и папе. Я – здесь! Я жду вас!  \n8 909 964 7440 Наталья','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_32190/umka_0_5e90f1b9322d0.jpg',235,231,NULL),(206,'Добрыня','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Средняя','Рыжий','32','Хорошее','ДОБРЫНЯ ПЁС \nдобрый брутал возраст до 12 месяцев\nобрезаны ножницами на живую уши, бывшие \"хозяева\" покупали щенка алабая , а вырос .. ДОБРЫНЯ с пушистым хвостом )) и его просто выгнали на улицу ..он очень человекоориентирован -конечно попал в отлов ,в приют- откуда я его смогла вытащить (именно так!) буквально через месяц и поместить в условия , достойные каждой собаки -в человеческие условия !Пёс кастрирован , привит по всем правилам . Живёт в своей личной комнате (не вольер ) на своём личном диванчике . Отлично ладит с другими животными на передержке ( совместные прогулки ), очень добрый к людям (своим / которых считает уже своими ). Очень яркая харизматичная собака !Необычный окрас - ЯРКИЙ, как у амурского тигра . Еще немного неуклюжий (Добрыне еще нет года ), но стать уже видна . Вес 30+\nСкромный ,но очень игривый (если предлагают игру )\nСлава Богу -ЗДОРОВ!Ест сухой корм качественный (не Чаппи и не Педигри)\nТуалет на улице.\nНе пустобрёх))\nСолидный Брутал Добрыня ответственным людям \nМосква и МО (ближнее )\nвручается такое сокровище по договору с ненавязчивым отслеживанием дальнейшей судьбы \nНе на цепь\nно в тёплой будке и с хорошим питанием вполне !\nможно писать в вацап -отвечу максимально быстро','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Загородный дом','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_30630/dobrynya_0_5e42ea75a2e5d.jpg',236,232,NULL),(207,'Уильям','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','21','Хорошее','Уильям собака для тех,кто любит активный образ жизни.С ним необходимо гулять и заниматься.Он как энерджайзер. Кастрирован.Ориентирован на человека.Отдается строго по договору ответственного содержания и строго не на цепь. Содержание вольерное.','Активный','Супер-общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Вольер','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_19201/uilyam_0_5d230e9d6affc.jpg',237,233,NULL),(208,'Топси','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Белый','16','Хорошее','Наша Топси – замечательная, трогательная малышка. Ей около трех лет. Она немного трусишка, но очень быстро, с помощью любви, ласки и вкусняшек, она научится доверять своему человеку.\nУ Топсички печальная судьба. В прошлом году ее забрала к себе молодая пара и, видимо, не расчитали свои силы, имея уже маленького ребенка и кота. У ребят просто не оказалось времени и сил на прогулки, на общение, иначе как еще объяснить то, что вернули малышку обратно в приют фактически без претензий: мебель и вещи собака не портила, двухразовый туалет строго на улице, с членами семьи была дружелюбна. Топси вернулась в приют в печальном состоянии, очень худая и в стрессе.\nНо время идет. Она оправилась. Набрала вес. И снова, как и раньше, носится на редких прогулках, обожает валяться в снегу.\nТопси отлично ходит на поводке, здорова, привита, стерилизована. Очень ласкова с людьми и дружелюбна к другим животным. А какая красотка!!))\nВсе что надо этой малышке для счастья – чтобы пришел ее единственный и неповторимый человек и забрал ее домой. Туда, где у нее будет не общий, а свой маленький уголок, где ей в первое время будет не так страшно и тревожно. И когда она поймет, что здесь ее любят, что она нужна, она со всей силой своей собачьей преданной души вернет сторицей своему человеку любви и обожания.\nТопси здорова, привита, стерилизована.','Спокойный','Сдержанный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_29793/topsi_0_6026d60227a23.jpg',238,234,NULL),(209,'Ася','Ищет дом','Женский','2 месяца','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','6','Хорошее','Ася - маленькая принцесса, она тихая и скромная по сравнению со своими братьями и сестрами. Очень льнёт к человеку за вниманием и лаской, но делает это очень корректно, или садится рядом и смотрит на человека, пока её не заметят, или подходит и ложится вплотную.\nАся заметно меньше своих однопомётников,она немного стеснительна в незнакомой обстановке, но очень быстро привыкает и начинает всё с любопытством исследовать. Как и полагает щенку её возраста - достаточно активна и игрива, но всего в меру.\nСейчас из-за более наглых братиков, Асе достаётся очень мало человеческого внимания, она очень нуждается в любви и заботе своих людей, своей семьи.\nОбратите внимание на малышку, ей пора домой!\n \nРодилась ~ 10.03.21. Привита по возрасту, обработана от паразитов.\n \nПристраивается в квартиру или дом (проживание в доме) по Москве и МО, по договору ответственного содержания, с ненавязчивым отслеживании судьбы.\nПОзнакомиться можно - д. Шемякино','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42436/asya_0_609eae57ac47c.jpg',239,235,NULL),(210,'Реджи','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крошечный','Семейная','Метис','Длинная','Коричневый','7','Хорошее','Славная девочка Реджи в поиске дома! 1,3 года\nРеджи,возраст 1,3 года, вес 7 кг. Малышка несколько дней бомжевала на автозаправке в 100 км от населенного пункта.\nОчевидно,что бывшедомашняя. За человеком ходит хвостиком. С другими собаками отлично, но себя в обиду не даст. С детьми, кошками отлично ладит. Легко составит компанию и в подвижных играх, и в обнимашках на диване.\nСтерилизована, сделаны все прививки, имеет вет. паспорт.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_39899/redzhi_0_5ffec4a856f18.jpeg',240,236,NULL),(211,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',241,237,NULL),(212,'Нива','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','16','Хорошее','Замечательная девчушка – Нива в поисках семьи\n7 месяцев, привита, от паразитов обработана, имеет ветпаспорт, приучена к поводку, при своевременном выгуле в туалет терпит, рост 52 см в холке, вес 16 кг, в ближайшее время будет стерилизована.\nНива – небольшая, изящная собачка, игривая, подвижная. Она подойдет людям с активной жизненной позицией, любящим движение, свежий воздух и Собак! \nПристраивается исключительно для домашнего содержания взрослым ответственным людям, по договору с ненавязчивым отслеживанием судьбы. Предварительное знакомство приветствуется. \n#нива#взятьщенка#щеноквдар#вдобрыеруки#возьмисобаку#вдар#Ногинск#Электрогорск#Павловскийпосад#Ореховозуево#Электросталь','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_34619/niva_0_5efe2fd6cfe5b.jpg',242,238,NULL),(213,'Лайма','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Серый','17','Хорошее','Лайма со всеми приветливая и дружелюбная.Хорошо ладит с другими собаками, не доминант. Любит играть и с таким же удовольствием поваляться на диване. Хорошо гуляет на поводке, схватывает быстро команды. Лайма здорова, стерилизована, привита, обработана. Очень ждёт любящего хозяина!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_33858/lajma_2_5edce40dca59b.jpg',243,239,NULL),(214,'Ночка','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','26','Хорошее','Ночка-ЧЕРНАЯ КРАСАВИЦА, метиска с лайкой, охотница, очень любит детей, ориентирована на человека, отлично ходит на поводке, приучена к 3- разовому выгулу,любит долгие и активные прогулки.Ей 2,5 года, привита, чипирована, стерилизована, имеет вет.паспорт. Отдается ТОЛЬКО НАДЕЖНЫМ И ОТВЕТСТВЕННЫМ, АКТИВНЫМ ЛЮДЯМ, БЕЗ АЛЛЕРГИИ НА ЖИВОТНЫХ!!!! по договору с ненавязчивым отслеживанием  судьбы, как в квартиру так и частный дом СТРОГО НЕ НА ЦЕПЬ.','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_32512/nochka_0_5e9dd0c3dc10e.jpg',244,240,NULL),(215,'София','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Белый','9','Хорошее','София- метис корги. Очень веселая и озорная','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_24044/sofiya_0_5d17bac6a2db1.jpg',245,241,NULL),(216,'Мышка','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Коричневый','15','Хорошее','Мышка ищет дом!\nСовсем небольшая собачка, 14кг и ниже колена, ей примерно 2 года \n\nОна попала в муниципальный приют больше года назад, но так как Мышка совсем не умеет защищаться, в приюте ей сложно.. первые время она вообще не выходила из вольера. Потом у неё появился опекун, которая постепенно стала завоёвывать её доверие и учить гулять в парке \n\nСейчас Мышка, совсем другая собака. Она достаточно хорошо гуляет на поводке и шлейке. Ей, даже нравится) \n\nКонечно, дома она превратится в полностью домашнюю собаку: будет встречать и провожать своего человека, исследовать новые места на прогулках и ловить восхищенные взгляды окружающих (Мышка в единственном экземпляре!) \n\nПо характеру, она довольно скромная и тихая девочка, без какой либо агрессии \n\nОна здорова, привита, обработана от паразитов, чипирована и стерилизована','Спокойный','Сдержанный','Равнодушное','Равнодушное','Равнодушное','Вольер','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_38154/myshka_0_5f9fbea29d61d.jpg',246,242,NULL),(217,'Киану','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Черный','25','Хорошее','Киану - неисправимый оптимист и сканун-нонкомформист, статный и харизматичный, как внешне, так и в своём поведении.\nВ приюте Киану не так давно и его позитивный взгляд на жизнь безусловно помогает ему смотреть на многие нюансы пребывания в приюте проще. \nКиану открыт к общению с людьми, это пес держит нос по ветру и никогда не скучает, потому что главное – жить в кайф!\nС ним у Вас не получится сидеть на месте и прокрастинировать, так что подумайте, готовы ли Вы изменить свою жизнь к лучшему?\nЭтот жизнерадостный пес добавит в Вашу жизнь огоньку и радости бытия!\n\nКиану ~2 года, привит, обработан, кастрирован, приучен к поводку.\n\nКиану пристраивается в добрые ответственные руки, с ненавязчивым отслеживанием его дальнейшей судьбы в квартиру или дом, не на цепь.\n\nДля знакомства с этим необычайным хвостом скорее звоните куратору.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_28421/kianu_1_5ddd3ed1e08ec.png',247,243,NULL),(218,'Лютик','Ищет дом','Мужской','5 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','3','Хорошее','Лютик был выкинут на улицу вместе с восемью братиками и сестричками.В холке будет средним.Активный и игривый щенок.Доставка по г.Москва и Московской области','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40620/lyutik_0_602567c7c076f.jpg',248,244,NULL),(219,'Щенок Фунтик','Ищет дом','Мужской','4 месяца','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','6','Хорошее','Кому фунт счастья? Мальчик Фунтик принесет его Вам! Он очень человекоориентированный парень. Легко содержать, потому уже сейчас он делает большие дела на улице, а дома только пописы на пеленочку.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40394/shchenok-funtik_0_60190522119c9.jpg',249,245,NULL),(220,'Фиксик','Ищет дом','Мужской','9 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Черный','6','Хорошее','Фиксик – стиляга и весельчак, который всем своим видом заряжает любовью к простым вещам. Один из самых маленьких по размеру собак приюта, Фикс такой невесомый и ненавязчивый, что его активность на прогулках едва ощутима человеку на другом конце поводка. Он настоящий джентльмен: обходителен с дамами, а с кобелями абсолютно нейтрален. Есть большая вероятность того, что и с кошками он запросто подружится. Сейчас сложно поверить, что еще год назад Фиксик не умел гулять и был обделен вниманием человека. Но только загляните в его глаза – такие наивные и открытые миру, это трогательное создание нуждается в защите и большой любви. Проделав долгий путь, он так спешит наконец стать счастливым и сделать счастливым Вас.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_37847/fiksik_0_5f91c2c1f00a6.jpg',250,246,NULL),(221,'Хан','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Крупный','Охранник','Породистая','Средняя','Белый','50','Хорошее','Отдадим собаку породы Алабай в хорошие руки. Родители покупали себе, но в связи с болезнью папы, больше не можем ухаживать за собакой.','Активный','Сдержанный','Равнодушное','Может проявить агрессию','Может проявить агрессию','Вольер','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_34639/khan_0_5f0063bc856bf.jpg',251,247,NULL),(222,'Аргос','Ищет дом','Мужской','6 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','5','Хорошее','«Ему имя - Аргос»\nЭтого маленького воина зовут - Аргос. Его имя означает «сияющий» и это правда, вы его важный вид заметите издалека. Даже в таком юном возрасте он уже показывает свой характер и можно уверенно говорить, что в прошлой жизни он явно был предводителем войска. Он всегда уверенно стоит на земле и смотрит в даль. По одному его взгляду видно, что он уверен в своих силах и никогда не отступит, настоящее поведение воина! Но под таким серьезном видом скрывается и другая личность малыша. Он очень любит внимание человека и ориентируется на него.  \nОн никогда не даст вам впасть в одиночество, ведь как только он увидит ваше грустное лицо, он тут же подбежит с виляющим хвостиком и начнет тыкать носиком, как будто бы говоря: «Ты как? Ты чего такой грустный? Давай я тебе подниму настроение» Он ещё и отличный попутчик, он составит вам компанию на любой маршрут, пройдет с вами через огонь и воду. Аргосу очень нужен человек, который мог бы уделить ему внимание и будьте уверены, вы получите в ответ вдвое больше внимания и любви!','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41712/argos_0_606c45467bbdb.jpeg',252,248,NULL),(223,'Монтгомери','Ищет дом','Мужской','9 лет','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Рыжий','27','Хорошее','Монтгомери за свои семь лет успел немало натерпеться. Как с этим скромным и покладистым кобелём обращались в приюте, мы не знаем. Но корм он поедает очень быстро, оглядываясь по сторонам. И не решается подставить незнакомцам голову для поглаживания, отворачивается и отводит глаза.\nИз приюта Монтгомери был отдан в Полтавскую область, в частный дом, где просидел на цепи несколько лет, зимой и летом. Его кормили, не били, но не более того. Потом решились отдать под опеку BoxerCo, и боксёр переехал в Москву.\n\nА ведь когда то Монти был квартирным псом, чьим-то домашним любимцем. Он примерно ведёт себя в квартире, ездит в лифте, как будто и не жил на улице! Помнит и выполняет все основные команды, гуляет на поводке, соблюдает чистоту дома. \nНе трогает кошек, дружит с собаками. Он отчаянно хочет остаться среди людей, в тёплом доме, послушно выдерживает даже неприятные медицинские манипуляции, терпеливо и без попыток агрессии. Радуется, как щенок, когда на него обращают внимание, и готов играть часами.\nМонти здоров и привит. Монти можно доверять, он надёжный и умный пёс. Ему не хватает только постоянной семьи, где для дружелюбного боксёра найдётся местечко в сердцах домочадцев.\nПристраивается бесплатно, не для разведения. Желательно не слишком далеко от Москвы, чтоб не терялся из поля зрения BoxerCo.\nЕсли есть сомнения в своих возможностях, BoxerCo окажет всяческую помощь: корма, ветеринария, консультации. Главное - доброе сердце.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_16750/montgomeri_0_5bc794fc6f712.jpg',253,249,NULL),(224,'Принцесса','Ищет дом','Женский','3 года','Да','-не уточнено-','Средний','Семейная','Беспородная','Длинная','Белый','25','Хорошее','Москва и МО! Мы просим капельку вашего внимания для одной очень необычной собаки по кличке Принцесса. Мы очень хотим, чтобы эту собаку заметил ее человек, ее хозяин… Ведь не зря же она проделала такой огромный путь от смерти на волоске до роскошной и красивой собаки, полностью готовой к дому. Все, что напоминает в ней о тех днях, когда мы боролись за ее жизнь, — это негнущаяся лапа…Ее и инвалидом то назвать язык не поворачивается… Можно сказать, что она самая обычная собака, которая обожает внимание, любит ласку, любит бегать, прыгать, абсолютно не требует никакого дополнительного ухода. Она такая, как все собаки: ласковая, безумно контактная и очень добрая. Она расцветает от присутствия человека. Она верит человеку безоговорочно… Ей очень нужно домой… Конечно, многие скажут, что сейчас и здоровые собаки никому не нужны, что говорить об инвалидах… Но, пожалуйста, не лишайте Принцессу шанса обрести дом, просто потому что она не такая… Мы сделали все, что смогли для нее … Но подарить дом, семью – это только в ваших силах… Мы ищем для нее, очень давно ищем людей, которые не побрезгуют принять Принцессу в семью, будут с гордостью называть ее своей собакой и гулять по аллеям города… \n\nПринцессе 3 года, она привита, стерилизована, хорошо ходит на поводке и приучена к выгулу. Ладит с кошками. Подойдет в семью с детьми. Находится на передержке в Москве. Отдается по договору с ненавязчивым отслеживанием судьбы. Звоните, задавайте вопросы и приезжайте знакомиться с Принцессой! Номер для связи: 7-903-285-80-30, Анастасия','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_28741/printsessa_0_5dea25752146f.jpg',254,250,NULL),(225,'Хлоя','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','16','Хорошее','Хлоя очень любознательная и умная девочка.\nЛасковая, нежная, контактная с другими животными.\nЛюбит игры на свежем воздухе и хорошую компанию.\n5 месяцев, привита.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_28786/khloya_0_5debc60c16374.jpg',255,251,NULL),(226,'Киара','Ищет дом','Женский','4 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','Киара молодая собака, мечтающая познать все собачьи радости. Она с радостью гуляла бы часами или сидела дома у телевизора, жила бы с большой семьей или была бы собакой одного хозяина, впрочем, всё ей не так важно, как любовь... Любовь человека, который заберет ее из приюта и покажет настоящую жизнь домашней собаки.\n\nКиаре около 4,5 лет, она активная, статная и очень дружелюбная собака. С радостью учится новым вещам и познает мир. Киара - настоящая личность с необыкновенным характер и глазами, полными любви и понимания.\n\nЗабирайте Киару домой, и у вас никогда не будет недостатка в любви!','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Может проявить агрессию','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40709/kiara_0_602ade7b31ab6.jpeg',256,252,NULL),(227,'Хьюго','Ищет дом','Мужской','22 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','11','Хорошее','Активный парень','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_38306/khyugo_0_5fa71c584056b.jpg',257,253,NULL),(228,'Амур','Ищет дом','Мужской','2 месяца','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Черный','7','Хорошее','Родился ~ 10.03.21\nСтатный красавчик с внешностью а-ля овчарка)\nАмур замечательно ладит со всеми! Люди, маленькие дети, кошки, собратья. Любит играть и бегать с другими щеночками, но ещё больше он любит - проводить время с человеком. Абсолютно компанейский малыш, куда человек - туда и он, и не важно зовут его поиграть в мячик или поваляться спокойно на травке, главное за компанию!\nАмур очень ждёт свою семью, чтобы подарить ей всю свою нерастраченную любовь.\nЩенок привит по возрасту, обработан от паразитов.\n \nПристраивается в квартиру или дом (проживание в доме) по Москве и МО, по договору ответственного содержания, с ненавязчивым отслеживании судьбы.\n\nСкорее влюбляйтесь и забирайте супер-ласкового мальчишку!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42434/amur_0_609ea7a64f3e9.jpg',258,254,NULL),(229,'Палаша','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крупный','Охранник','Метис','Короткая','Палевый','10','Хорошее','Отдам щенка в добрые рука. Девочка, 6 месяцев.Будет крупная. Текущий вес 10 кг. Высота в холке 45 см. \nУмная, контактная, любит детей. Обучаемая, подает лапу.\nЕсть ветпаспорт, обработана против клещей и паразитов.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Вольер','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31759/palasha_0_5e7761b1aa431.jpg',259,255,NULL),(230,'Соло','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','- не уточнено -','Хорошее','Если этот мальчик не сразу привлечет ваше внимание, то только потому, что скромно сидит в сторонке. Но секундой позже вы обязательно его заметите. Потому что не заметить его нельзя. Волей-неволей взгляд сам упадет на шелковистую шерстку всех оттенков рыжего, белоснежную манишку, лукавую улыбку, а главное - эти чудесные, добрые и понимающие глаза. В остальном же наш Соло - жизнерадостный подросток, недоверчивый и ершистый, но веселый и любопытный.\n\nИстинный дворянин. Молод. Красив. Характер нордический, стойкий. С другими дворянами открыт, общителен, дружелюбен. В агрессии к людям не замечен. Великолепный спортсмен. На прогулках проявил себя как замечательный спринтер. Беспощаден к аппетитным консервам и другим угощениям','Спокойный','Сдержанный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_38814/solo_0_5fbe8eda4928d.jpg',260,256,NULL),(231,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',261,257,NULL),(232,'Рэд','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Белый','20','Хорошее','Давайте вспомним, как раньше, еще во времена СССР, мы дружили домами, как сосед был лучшим другом на многие года, помните? Ну было же?:) Вот и у нашего Рэда: общительность и дружелюбие – это главное качество! Обычно все происходит так: «Ой, а мы с Вами раньше нигде не встречались? Больно лицо мне Ваше знакомо!» Именно так  встречает всех приходящих в приют наш Рэд. \nКаким он будет, когда Вы захотите подарить дом и семью Реду?\nТрудолюбивым и ответственным! Он будет всегда стремится угодить всем членам семьи. Но в тоже время, в силу молодого и юного возраста ласковый, как маленький котенок и Рэд останется до зрелого возраста все тем же мальчишкой, с которым вы познакомились когда то, много лет назад. И будет до старости тем верным другом соседом, с которыми вас связывают только верность и только дружба.\nНу вы понимаете, что если Вы любите пассивный отдых на диване, Рэд не сможет так долго составлять здесь компанию, его подвижность не позволяет существовать  долго в замкнутом пространстве, а для поддержания его замечательного, доброго и веселого характера ему нужна семья с более-менее активной жизненной позицией. А так как знания он схватывает просто на лету, то чтобы он ни делал, ему важно ваше одобрение и из шустрого Реда, вы получите компаньона со множеством знаний команд! Он любит работать, учить, выполнять команды и  с удовольствием примет участие  во многих соревнованиях.\nНо совсем не значит, что Рэд может заскучать, если ваше время будет занято и мальчишке придется ждать, тихо посапываю в углу, нет-нет! Рэд, словно не взрослеющий щенок, предоставит себя самому себе, и на придумывает игры и развлечения, главное: не забудьте оставить ему «лото» или его любимую игрушку \nА вообще с Рэдом можно с легкостью и в автобус запрыгнуть и на личном автомобиле  проехаться с ветерком, его стройность и компактность, не смотря на длинные лапы, позволяет расположиться без каких либо усилий для него и «соседей». А так: мальчишка одним словом, с которым и в футбол можно погонять, и окно где разбить, соседей весело погонять на выгульной площадке, высоко перепрыгивая, как барьер\nКакой задорный у нас Рэд! Но вы можете смело знакомить его со своими уже имеющимися животными, тут главное, чтобы товарищи были и не важно, кошка, хомячок, собрат, было б с кем общаться в удовольствие! Маленькие дети? Справимся!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_9884/red_0_59db46cf447ad.jpg',262,258,NULL),(233,'Шаня','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','20','Хорошее','Шаня очень давно в приюте, и, наверное, только ее кроткий нрав может служить объяснением, почему она еще не стала домашней. Собаку с более спокойным и тихим характером еще поискать. Если вам нужен ласковый и нежный друг - то это Шаня. Она очень хорошо гуляет на поводке, не ссорится ни с собаками, ни с людьми. Очень любит угощения и обнимашки. Ей 6 лет, она здорова, привита и стерилизована. Подарите Шане дом и свою любовь!','Спокойный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41166/shanya_0_6045e159398c3.jpg',263,259,NULL),(234,'Алиса','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','7','Хорошее','Недалеко от ж.д. переезда д. Потаповское  были подобраны пять щенков. Очень истощены и голодны . Сейчас на передержке отъедаются и каждый ждет своего человека. Алиса - девочка. Самая маленькая и худая в найденном помете. Немного застенчива, но ласковая, Это будет «мамин хвостик», который должен находится всегда рядом с хозяином.  За себя может постоять.  Сейчас ей месяца 3-4. Вырастет средней, до 15-20 кг. Пристраивается в дом, в квартиру или в вольер. Строго не на цепь. Обработана от паразитов, на днях будет сделана прививка.','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_31400/alisa_0_5e62bf43970b3.jpg',264,260,NULL),(235,'Рыжий и Жуля','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Коричневый','31','Хорошее','Отдам в хорошие, добрые, заботливые руки любимых собак, оставшихся одних - Рыжего и Жулю. \nХозяйки собак больше нет, забрать к себе не можем (съемная квартира), а бросать на произвол судьбы не позволяет сердце.\nОба животных с паспортами.\n\nОбе собаки не портят мебель. не гадят дома, не агрессивны к другим животным (и собакам и котам). но при этом являются великолепными сторожами, всегда гуляли и жили вдвоём.\n\nРыжий: Мальчик, 6 лет, кастрирован, привит, любит гулять и играть на свежем воздухе! Любит различные палки и апортировки\n\nЖуля: Девочка, 6,5 лет, стерилизована, привита, очень любит находиться с хозяевами (спать рядом с ними на полу) и различные лакомства.\n\nСобаки привыкли друг к другу, поэтому хотелось бы отдать их вдвоем, но готовы отдать их и по отдельности, т.к. если они останутся без нового дома в эту зиму - они рискуют ее не пережить.\n\nЕсли вы знаете контакты надежных добрых хозяев или добросовестного приюта - напишите пожалуйста. Животные не должны остаться одни.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_39625/ryzhij-i-zhulya_0_5ff096bd9ea96.jpg',265,261,NULL),(236,'Сухум','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Коричневый','22','Хорошее','Ищет дом и заботливую семью очаровательный «оленёнок» - Сухум!\nСухум в весьма плачевном состоянии приехал к нам в начале ноября из Абхазии, где он несколько месяцев как мог выживал на улице, гонимый всеми вокруг. Сейчас мальчик немного оправился и вполне готов к поискам своего нового дома, где ему смогут подарить любовь и заботу! Вот такой невероятно обаятельный ребёнок-оленёнок! Активный, прыгучий \"шилопоп\", всё ему вокруг интересно, как сделает все необходимые \"делишки\" на выгуле - поводок натягивает, но критично не тянет, на собак агрессии не проявляет, скорее они вызывают у него интерес. Соседствует в одном вольере с девочкой. Команды совсем не знает, но это, конечно, поправимо!) Зато он очень любит обнимашки-целовашки!? Вкусняшки из рук берёт аккуратно, но пока жадно. А ещё его ушки на макушке придают ему совершенно мимимишный вид!) Готов постоянно прижиматься к ногам, прям ребятёночек, который хочет, чтобы его пригрели и полюбили!❤️ Сухум кастрирован, привит, имеет ветеринарный паспорт, отдается бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. ‼️На данный момент Сухум проходит курс по лечению дирофилярий, в остальном мальчишка полностью здоров. Возможно, Вы влюбитесь в этого милого парня и захотите его поддержать в лечении уже в домашних условиях, ведь дома и стены помогают! Организационную и финансовую сторону лечения мы готовы взять на себя. Если хотите подарить Сухуму дом, то звоните нам и приезжайте с ним знакомиться!)','Активный','Общительный','Доброжелательное','Может проявить агрессию','Равнодушное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_39518/sukhum_0_5fe6c51e4e61f.jpeg',266,262,NULL),(237,'Артиша','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','20','Хорошее','Трепетная девочка Артиша ищет дом!\nАртиша - девочка  серо-рыжего окраса , ласковая и дружелюбная . \nАртиша адаптирована к проживанию в квартире,  остается дома одна, ничего не портит. Приучена к  2-х разовому выгулу и к поводку. Хорошо ездит в машине.  Дружит с другими собаками и кошками.  Но Артиша  жуткая трусишка, незнакомых людей она боится. Нужно время , чтобы она привыкла и стала доверять новому человеку. А когда это случится  - залюбит \"до смерти\" .\nВозраст - 2  года. Рост - 50-55 см в холке. Здорова, привита, стерилизована.\nВ настоящее время Артиша находится на домашней передержке (Щелковское ш.) .  Собака отдается по договору ответственного содержания и последующей отслеживания судьбы.\nЗвоните и приезжайте знакомиться с  Артишей!!!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_20491/artisha_0_5e281dded4582.jpg',267,263,NULL),(238,'Гаечка','Ищет дом','Женский','2 года','Да','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','29','Хорошее','ГАЕЧКА. Непростая история необыкновенно доброй собаки. Поселок Уваровское Калужской области. Несметное количество голодных собачьих хвостов. Впалые бока, рёбра наперечет. Когда скитается и голодает крупная собака, это может продолжаться очень долго, до последних 15кг., которые она в силах будет поднять на дрожащих ногах...\nВ момент нашей встречи ГАЕЧКА держала в лапах батон белого хлеба, жадно отхватывала куски ... Никаких историй откуда, каким образом она там оказалась... Некому рассказывать. Некому кормить, хотя бы изредка. Наверное, в прошлом были боль, обиды от человека. НО ничего этого ГАЕЧКА не помнит. Чистое доверие. АБСОЛЮТНОЕ. Как бывает только у собак.\nИстово льнет к человеку. Самая ароматная еда не заставит ее отнять голову от Вашей руки...\nГАЕЧКА живет в приюте. Это вынужденная мера, пока мы не можем предложить ей большего. Непросто складываются отношения с другими собаками. ГАЕЧКА добродушна и дружелюбна со всеми, но присутствие человека это меняет. Она категорически не хочет делить внимание ни с кем. Именно поэтому мы ищем для нее семью и дом, где ГАЕЧКА будет единственной собакой, залюбленной дочей. Зацелованной плюшей, няней для детей... Исключительная собака... добрейшая... Не ее вина, что внимание и прикосновение человека для нее бесценнны...\nГАЕЧКА привита, стерилизована. Рост около 60см в холке, вес 27,6 кг.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_40950/gaechka_0_6037f1ecb0451.jpg',268,264,NULL),(239,'Уголь','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','30','Хорошее','Отдаём нашего красавца в самые добрые руки. 3 года, кастрирован, прививки все сделаны. Есть ветпаспорт. Уголек очень любит и защищает детей, а у нас их четверо, добрый и умный пес, отлично охранял наш дом. Спокойно терпит 2-х разовый выгул, но в идеале он сторожевой пёс и лучше бы ему жить в частном доме или в деревне. При этом пёс очень ласковый! Съест своё и ваше. Можно использовать, как пылесос))) \nПредставьте рядом с собой идеально верного друга и защитника – и это он. У 2 наших детей проявилась сильная аллергия, поэтому приходится искать нового хозяина, врачи говорят, что будет только хуже. Звоните и пишите. Отвечу на все вопросы. В подарок отдадим пакет его любимого корма Pro Plan)). Отдаём в реально хорошие руки? Пёс нам дорог.','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_29179/ugol_0_5dfa8eb42c9ae.jpg',269,265,NULL),(240,'Джонни','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','20','Хорошее','1. Кличка –Джонни 2. Порода – метис 3. Возраст – около 2 лет 4. Рост - 45 см по холке 5. Вес – 21 кг 6. Место расположение – Новая Москва, родился на стройке. 7. Состояние здоровья – отличное 8. Клещи, блохи, глисты - обработан от паразитов 9. Пока не кастрирован 10. Случаев, что метит углы, не было зафиксировано. 11. Предпочтение по еде – сухой корм и консервы/мясо. Если, конечно, у него будет выбор, то из двух мисок выберет ту, что с мясом. 12. Людей любит, особенно детей. 13. По характеру – всегда подставляет свою мордаху и любит, чтобы почесали, погладили его спинку . Спокойный, временами игривый, воспитанный, понимающий. 14. Езда в машине – опыт был 2 раза. Первый раз волнительно, второй – любознательно. 15. К другим собакам относится спокойно, пока они не нарушают его личное пространство. Может рыкнуть 16. Реакция на простые команды. Обучаем. О его судьбе можно следить в Инстаграм dobrayk_jonny','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_39436/dzhonni_0_5fe105d8ecf37.jpg',270,266,NULL),(241,'Рикки','Ищет дом','Мужской','4 месяца','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','3','Хорошее','Малыш Рикки ищет дом.\nЕму 2,5 месяца, от паразитов обработан, есть ветпаспорт.\nСейчас живет на передержке.\nРикки очень ласковый, в меру активный.\nМама малыша, небольшая собачка,чуть ниже колена в холке, гладкошёрстная.\nПристраивается по Договору Ответственного Содержания, с ненавязчивым отслеживанием судьбы (фото,видеоприветы).\nК Вам домой малыша мы привезём сами.\nТерриториально м.Академическая','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_40543/rikki_0_6022b8d8b94dd.jpg',271,267,NULL),(242,'Найда','Ищет дом','Женский','3 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Рыжий','16','Хорошее','Отдам в добрые руки.Добрая,ласковая,приучина к улице,окрас метис,не большая.Брали в приют.Но потом обнаружили что у супруги аллергия.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_28315/najda_0_5dda49ec7c045.jpg',272,268,NULL),(243,'Руди','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Рыжий','46','Хорошее','Ищет свою семью замечательный яркий красавчик!\nРуди большой, молодой и очень активный пёс.\nЕму 2,5 года.\nОн здоров, привит, кастрирован. \nРост в холке 70 см., вес 46кг.\nЕст сухой корм, приучен к поводку и выгулу. \nНе агрессивен к сородичам и кошкам.\nЛюбит (и нуждается) в длительных и активных играх с сумасшедшими забегами!\nИщет семью, которая готова посвящать время воспитанию и прогулкам. Если в семье есть дети, великолепно, Руди будет рад.\nРуди может содержаться как в квартире, так и в вольере с выгулом (не на цепь!).','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_26031/rudi_0_5d78ac8581761.jpg',273,269,NULL),(244,'Бони','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','13','Хорошее','Знакомьтесь, это Бони. И ей чуть больше года. Здорова, стерилизована. И она оооооочень любит травку- есть,лизать, рыть, валяться, кувыркаться! Гулять с ней одно удовольствие. Хотите попробовать? Забирайте домой!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_10255/boni_0_59f0f082895c0.jpg',274,270,NULL),(245,'Рута','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','23','Хорошее','Если бы собакам давали Оскар за самый шилопопый и оптимистичный характер, то статуэтку бы получила Рута !Чудовищно непосредственна, неприлично обаятельна, бескомпромисно жизнелюбива... От этой энергичной красотки просто не отвести взгляд! \n \nКак и всякая молодёжь, Рута спешит жить! Быстрее всех бегать, выше прыгать, сильно обниматься. А если уж облизывать своего спутницей в щеку, то так, чтобы даже веснушки оттереть :) \n \nРута хорошо ладит с другими собаками. Приглашает поиграть компанейских и обходит стороной неприветливых. С кошками не проверяли, но что-то подсказывает: и с ними станет дружить. \n \nНа фото она серьёзная, но это она подумала, что снимают на паспорт :) В жизни – это весёлая и полная энтузиазма непоседа. \n \nУ Руты хорошо работает соображалка, и она ориентирована на человека и его указания. Дома при систематических занятиях она легко выучить и команды, и азы хорошего поведения. Но в приюте не ло обучения, так что пока Рута тянет на поводке. \n \nРуте не больше года, она здорова, привита и стерилизована.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39873/ruta_0_5ffd9e8823dce.jpg',275,271,NULL),(246,'Лиска','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Коричневый','12','Хорошее','Нежная и ласковая девочка.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40867/liska_0_6033c1abbc531.jpg',276,272,NULL),(247,'Дюшес','Ищет дом','Мужской','8 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','23','Хорошее','Живет у нас в приюте настоящий джентельмен, вечно молодой, обаятельный, благородный пес Дюшес!\n\nВполне возможно раньше мальчик был домашним, потому что он воспитанный, послушный и очень верный! Дюшес ласковый, добрый и умный красавец!\n\nОн прекрасно поладит со всеми членами семьи и к каждому найдет подход. С другими собаками ведет себя избирательно, с конкурентами-мальчиками не очень дружит.\nДюшес отлично гуляет на поводке и преданно заглядывает в глаза, с радостью играет в игрушки)\n\nМальчику 7 лет, он здоров, привит, кастрирован.\nИ очень ищет семью!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Может проявить агрессию','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_24274/dyushes_0_5d231708f1f44.jpg',277,273,NULL),(248,'Стёпа','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Белый','17','Хорошее','Стёпа мальчик скромный, к своим ласковый, хорошо гуляет на поводке, к кошкам и другим собакам дружелюбен, привит, рост по колено.\nОтдаём по договору надёжным людям \nЕсть щенки других окрасов и возрастов\nЗвоните!!!','Спокойный','Сдержанный','Равнодушное','Равнодушное','Доброжелательное','Загородный дом','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_24041/stjopa_2_5d17a109e49ca.jpg',278,274,NULL),(249,'Чак','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','12','Хорошее','ЧАК\nОчень красивый и послушный пес.\nРост 35 см\nВес 17 кг\nСобака отдается хозяину который знает собак, понимает их психологию. Тому, кто готов стать для Чака настоящим другом и авторитетом. Тому, кто своим спокойным характером сможет завоевать его доверие, без жестокости и без попыток сломать характер собаки!\nМы подружились и для нас Чак - невероятно послушный и деликатный пес.\nКоманды выполняет бесприкословно!\nИ если даже к нему подойдет собака с определенной целью подраться, два слова: Чак, нельзя! и он спокойно развернется и подойдет к хозяину.\nА еще Чак очень воспитан. Он настоящий джентльмен. Если ему поставить миску и к ней подойдет собака-девочка и начнет есть, Чак спокойно уступит и будет ждать.\nАбсолютно неконфликтный.\nНепревзойденный охранник.\nЕсли поймет, что надо защитить хозяина - не раздумывая это сделает.\nИ ему будет все равно какого размера перед ним собака. Смелый, знающий себе цену.\nОтдается строго по договору с отслеживанием судьбы.\nМосква и область. Не вольер.','Активный','Сдержанный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_33946/chak_0_60a10bd6447ee.jpg',279,275,NULL),(250,'Аргос','Ищет дом','Мужской','6 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','5','Хорошее','«Ему имя - Аргос»\nЭтого маленького воина зовут - Аргос. Его имя означает «сияющий» и это правда, вы его важный вид заметите издалека. Даже в таком юном возрасте он уже показывает свой характер и можно уверенно говорить, что в прошлой жизни он явно был предводителем войска. Он всегда уверенно стоит на земле и смотрит в даль. По одному его взгляду видно, что он уверен в своих силах и никогда не отступит, настоящее поведение воина! Но под таким серьезном видом скрывается и другая личность малыша. Он очень любит внимание человека и ориентируется на него.  \nОн никогда не даст вам впасть в одиночество, ведь как только он увидит ваше грустное лицо, он тут же подбежит с виляющим хвостиком и начнет тыкать носиком, как будто бы говоря: «Ты как? Ты чего такой грустный? Давай я тебе подниму настроение» Он ещё и отличный попутчик, он составит вам компанию на любой маршрут, пройдет с вами через огонь и воду. Аргосу очень нужен человек, который мог бы уделить ему внимание и будьте уверены, вы получите в ответ вдвое больше внимания и любви!','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41712/argos_0_606c45467bbdb.jpeg',280,276,NULL),(251,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',281,277,NULL),(252,'Джони','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Черный','12','Хорошее','Очень плохо,когда детки растут без домашнего тепла и любви. ?\nТак и Джони...\nЕдинственная его радость, что он не погиб крохой на улице и попал на передержку. \nА так бы хотелось увидеть его ДОМА, на мягком диванчике: довольного и счастливого.? \nДжони совсем небольшой- 40 см в холке. Здоров и привит. Очень общительный и весёлый подросток, легко обучается, а главное будет вам предан до конца своих дней!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_26273/dzhoni_0_5d82b3c9aef2a.jpg',282,278,NULL),(253,'щенок','Ищет дом','Женский','3 месяца','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Рыжий','2','Хорошее','Отдам в добрые руки щенков - осталась одна девочка от мамы карелки и папы норвежской лайки. Родились 14 января. Ушки торчат, хвосты крючком, в туалет ходят на пеленку, едят сами - готовы к выдаче. Милые, жизнерадостные собачки - залижут до смерти Мвма - породистая карелка. Умница, легко обучаема, артистка, хороший сторож, и верный друг, любит активные игры - дочка-копия мамы Есть возможность доставки','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41098/shchenok_0_6040bd82b7149.jpg',283,279,NULL),(254,'Лесли','Ищет дом','Женский','3 года','Нет','-не уточнено-','Крошечный','Семейная','Беспородная','Короткая','Палевый','5','Хорошее','Очаровательная Лесли ищет добрые ручки!\n\nЛесли молодая девочка, ей 3-4 года, она совсем небольшого размера, но с очень большим и добрым сердцем! Она светленькая, очень симпатичная, с умной узкой мордочкой и красивыми глазками. Смышленая, ориентирована на дружбу с человеком и очень нуждается в уютном доме. Она пропала в отлов, а маленьким собачкам особенно тяжело в неволе. Вокруг крупные конкуренты на еду и место в будке. А к тому же Лесли оказалась беременной и вскоре родила. Все волонтёры сразу же полюбили эту снисходительную блондинку , подкармливали и заботились о ее малышах, Лесли была прекрасной матерью, но выжил лишь один щенок - чудесная девочка Патрисия, такая же беленькая и элегантная как ее Мама. Было трогательно и воодушевляюще наблюдать как одна кроха учит жизни другую кроху: как кушать, как прятаться, как играть и прыгать. Я вывезла Лесли и Пати из центра отлова, тк у щенков там практически нет шансов на выживание. А выдержать ещё одну утрату Лесли было бы просто невозможно.... теперь доча Лесли уже подросла и маму можно пристраивать в добрые ручки. Девочка Лесли очень умная, обаятельная, добрая, общительная, красивая и очень ласковая. Спасите маленькую жизнь, ведь в зиму держать такую кроху в открытом вольере невозможно.\nРост в холке 25 см. Вес - 5 кг.\nСделаны все прививки,имеет вет.паспорт,стерилизована.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35269/lesli_0_5f1955c4d67bc.jpeg',284,280,NULL),(255,'Грэй','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','26','Хорошее','Очень ласковый и нежный зверь )) любит обниматься и \"делать глазки\". Общительный, жизнерадостный. \nБыл спасен с улицы подростком от гоняющей его своры собак. В настоящее время живет на домашней передержке с детьми , кошками и др. собаками. Со всеми дружелюбен.  Зимой жил в доме , приучен терпеть. Лето  - во дворе и открытый вольер.\nСпокойно ходит на поводке, слушается. Огромное желание угодить.\nПривит, обработан, кастрирован.\nПодойдет и в дом (терпит, сидит на месте) и в вольер.\nВозможна помощь в доставке\n8-915-0940788 Наталья','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_41753/grej_0_606d8a3b99b03.jpg',285,281,NULL),(256,'Таша','Ищет дом','Женский','4 года','Да','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','16','Есть небольшие проблемы','Таша #таша_бродяги_калуга ?❤????\nНу невероятная собака! Постоянно хочется ее тискать и целовать, а эта прелестница все знает и улыбается в ответ?\n\nТак хочется найти ей Маму, которая ее поймет и будет любить и баловать?\nТаше около 3х лет. Стерилизована и привита. С другими животными хорошо уживается. Характер есть, харизма невероятная. Мамочки только нет. Заберите ее из приюта!!!\nТаша будет охранять ваш дом и греть вашу душу?\nТел для связи 8 960 524 57 57 Эльвира','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_26945/tasha_0_5d9f71ba198a3.jpg',286,282,NULL),(257,'Макс','Ищет дом','Мужской','7 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','20','Хорошее','Отдам в дар собаку. Возраст до 3-х лет, мальчик, метис северных ездовых пород, кличка Макс. Преимущество отдается проживающим в частном доме с надежным забором, исключающим побег с участка. К квартире и к жизни в доме не приучен, но при желании все в руках будущих хозяев. Мальчик здоров, привит. Пристраивается не на охрану, не на цепь. Будет вам отличной собакой-компаньоном. Пристраивается в Москву и Московскую область с обязательным условием отслеживания дальнейшей судьбы. Территориально собака находится на породной передержке в г. Истра, Московская область. Приезжайте на смотрины!','Активный','Супер-общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_5870/maks_0_5864fec26db18.jpg',287,283,NULL),(258,'Стеша','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Коричневый','25','Хорошее','Cтеша - никому ненужная красота...\n\nСмотря на нее, даже не верится, что эта собака так задержалась в приюте. Стеша прямо настоящая девочка-девочка. Аккуратная, очень красивая, с подведенными глазками, очень похожая на типаж лабрадора или ретривера.\n\nСобака - загадка. То она скромно лежит в углу, а вот вдруг носится и плескается в речке так, что брызги летят в разные стороны.\nСтеша ладит со всеми, она не агрессивная и добрая.\n\nКакой она была бы дома? Пугливой, нежной, скромной, а может наоборот, так раскрылась бы в домашней обстановке и всех-всех нас удивила. Одно можно сказать точно. Человека, который захочет найти к ней подход и полюбит ее, Стеша навсегда поставит на первое место в своем сердце и пойдет за ним хоть куда.\nСтеша быстро адаптируется, и сложно назвать ее дичком, если она доверяет человеку, то она с радостью подставляет пузико почесать ее или тыкается мордочкой. Но заслужить доверие Стеши очень сложно... Чтобы узнать её получше, придется какое-то время поездить к ней.\nСтеше всего 4 года и не хочется, что она так и состарилась в приюте.\nОбычно, когда люди ходят по вольерам, выбирая собак, Стеша прячется в зимнике.\n\nМожет это именно Ваша собака сейчас грустит в приюте и хочет на мягкий лежачок? Может это именно вы будете с гордостью ходить с ней по улицам, а все прохожие будут восклицать: Ну что за собака! Ну что за красавица!','Спокойный','Сдержанный','Равнодушное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_29406/stesha_0_5fb55e008c527.jpg',288,284,NULL),(259,'Дик','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','28','Хорошее','МОСКВА ,МО. Дик - метис в дар. Привит, чипирован, здоров. Ласковый, дружелюбный молодой парень Дик ждёт своё счастье. В самые хорошие заботливые руки! Будку-цепь не предлагать.Рассматривается частный сектор или квартира.Если в частном секторе-проживание в доме в холодную погоду, пес гладкошерстный. Песик родился летом 2016 года. Дружелюбный к сородичам, детям, кошкам. Спокойный, но не откажется поиграть. Хорошо гуляет на поводке. Очень ласковый и позитивный мальчик. Нордик любит прогулки, общение, внимание. Проявляет охранные качества ,,звоночка,,\nПознакомиться с Нордиком можно в Балашихе. Приезжайте, Дик очарует с первого взгляда!','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_20911/dik_0_5c87f2d2aef97.jpg',289,285,NULL),(260,'Агата','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','22','Хорошее','Знакомьтесь, Агата! Молодая, красивая, послушная девочка. Очень дружелюбная абсолютно со всеми. Нежная, ласковая, скромная. С другими собаками дружит. На поводке не тянет. Очень ориентирована на человека. Звоните, приезжайте знакомиться с этим чудесным подростком! Ей очень нужен свой дом и своя семья. Агате около 3-х лет. В холке - около 50 см. Стерилизована. Сейчас живет в приюте. Звоните, приезжайте знакомиться с Агатой. Территориально - м.\"Выхино\".','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30788/agata_0_5e480d552e35f.jpg',290,286,NULL),(261,'Карамелька','Ищет дом','Женский','5 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','6','Хорошее','Два малыша - мальчик и девочка, ищут дом. Активные и дружелюбные. Щенки хорошо общаются с кошками. Хорошо играют с детьми. Щенкам 3 месяца. Обработаны, ожидают прививку. Отдадим взрослым ответственным людям (не в съемную квартиру).','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_40182/karamelka_0_600c0be949683.jpg',291,287,NULL),(262,'Молли','Ищет дом','Женский','10 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Серый','20','Хорошее','Кому сорвиголову и принцессу в одном флаконе!! Налетай!!! Молли-чудесная девочка с внешностью маленького волчонка! Молли около 6-7 лет, в холке около 50 см. Очень веселая, подвижная, озорная. Ладит с другими собаками. Обожает общаться с людьми, когда ее гладят и хвалят. Никогда не тянет одеяло на себя -ждет, когда ее приласкают. Знает поводок, здорова, стерилизована. Девочка очень дружна со своим другом Джеком, и конечно, мы были бы рады пристроить их в добрые руки парой, но, если этого не случится, мы будем рады и за нее одну. Молли достойна настоящей семьи и с нетерпением ждет, когда хозяин найдет ее. Если вы узнали свою девочку, звоните!','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_4913/molli_0_57c1caba77ad0.jpg',292,288,NULL),(263,'Бьорн','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Белый','29','Хорошее','Бьорн добрейший и умнейший пёс. Был найден в районе Бутово пол года назад. Очень социальный, к выгулу и поводку приучен. Прекрасно ладит с другими собаками и кошками, обожает детей. Просто собака нянька)) Характером очень похож на лабрадора.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_21266/born_0_5c975fbe458b1.jpeg',293,289,NULL),(264,'Джус','Ищет дом','Мужской','4 месяца','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Серый','10','Хорошее','Малыш Джус ищет дом. \nДжус появился на свет 10 декабря. \nЕго мама - сибирская хаски была найдена на улице уже в положении. \nПапа остался неизвестен.\n\nДжус родился самый первый. И как полагается старшим - самый большой, активный, смелый и заметный щенок.\nОн обожает игры с сородичами и человеком, любит игрушки и другие щенячьи забавы.\n\nЛасковый, весёлый малыш, из которого при правильном подходе вырастит верный друг.\n\nМы ищем для Джуса любящую и заботливую семью, готовую уделять достаточно внимания воспитанию ребенка. \nОтдаётся только ответственным людям в квартиру или дом, но строго не на цепь. \n\nДжус обработан от паразитов и привит первой вакциной.\nВырастет 25-30 кг.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41068/dzhus_0_603f594422d99.jpeg',294,290,NULL),(265,'Герда','Ищет дом','Женский','2 года','Нет','-не уточнено-','Крошечный','Семейная','Метис','Короткая','Черный','12','Хорошее','Красавица Герда ищет самых лучших и ответственных родителей! Герда от природы очень активная и любознательная)). \nЭнеpгичнaя, лacкoвая, oчень контактная. Любитeль активныx игр и дoлгиx пpогулoк. Абсолютнo нeутoмимa! Пoдарит моpe пoзитива и никогда нe дacт зacкучать.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_33306/gerda_0_5ec195ad269ba.jpg',295,291,NULL),(266,'Хэнк','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','24','Хорошее','Нашему Хэнку 1,5 года. Начнем знакомиться?\nМолодой импозантный красавец, в котором явно прослеживается помесь с хаски. Статный, рост выше среднего. Пружинистый бег, потенциально выносливый и готовый к долгим прогулкам.\nОчень умный, спокойный.\nЯркий темперамент и энергичность Хэнка удачно уравновешены хорошо устойчивой психикой.\nЛюбит играть в большой компании собак, бегать за палочкой, кольцом. В такие моменты забывается и становится похож на вчерашнего щенка-подростка. \nНо выделяется отличной реакцией на замечания, понятливостью. \nПрекрасно ходит на поводке, не тянет, верно держится рядом.\nХорошо терпит до выгула, в вольере все чисто и сухо.\n\nМосква или МО, только взрослым людям.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_36084/khenk_0_6037d5afee9e4.jpg',296,292,NULL),(267,'бася','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Охранник','Метис','Средняя','Белый','26','Хорошее','Сабака очень хорошея даже жалко отдавать помесь алабая тратерера просто живёт в квартире а ето не дело помогите у кого есть частный сектор','Спокойный','Общительный','Доброжелательное','Доброжелательное','Может проявить агрессию','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_35105/basya_0_5f1345a27ed40.jpg',297,293,NULL),(268,'Чип','Ищет дом','Мужской','5 лет','Да','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','- не уточнено -','Хорошее','Мальчик был найден избитым, раненым, потерял глазик. Выходили, залечили раны…\nСейчас ничто не мешает Чипу любить людей, обниматься, улыбаться и радоваться жизни. Очень ласковый, легко обучается. Год рождения 2016. Размер ниже колена, вес 17 кг. \nЧипулик приучен к двухразовому выгулу. Хорошо гуляет на поводке. Кастрирован, привит. С некоторыми кобелями конфликтен, но не критично. Дружит с кошками. Спит с ними))\nГлаз прооперирован, спец. уход не требуется. \nПриезжайте знакомиться. Мы в Балашихе, рядом с Москвой. Чип не оставит вас равнодушным.\nПриютившим Чипа всегда окажу консультативную помощь.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_41050/chip_0_603e4e18895c3.jpg',298,294,NULL),(269,'Филипп','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','32','Хорошее','Фил одиноко бродил по улице. Красивый , очень тянулся к детям. Поиски хозяина не к чему не привели, хотя он явно бывшедомашний. Фил очень любит людей, с позитивным характером и задорным блеском в глазах. Я очень хочу , чтобы такая прекрасная собака стала домашней и любимой .','Активный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_38764/filipp_0_5fbbfedbbb4fa.jpeg',299,295,NULL),(270,'Йоши','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','18','Хорошее','Пёс,примерно 6-7 месяцев,точно не известно так как был подобран на улице, вес около 18 кг. Находится территориально в СНТ Рассвет, возле г.Куровское. Здоров,активен, проглистован, через 10 дней планируем отвести его на первую прививку. Характер-жизнерадостный энерджайзер. Быстро привыкает к новым людям, очень радуется вниманию. Из особенностей-растет бородка на нижней челюсти. Пробовали гулять с поводком от СНТ до Куровского, по дороге ни на кого не лаял, но поводок тянул. В самом СНТ гуляет без поводка, он очень ориентирован на человека, не упускает из виду, бежит рядом, далеко не убегает. К собакам относится с интересом, без агрессии, начинает с ними играть. Пытаемся учить команде сидеть, и контролю внимания. Сейчас живет на участке, в будке, на привязи. Лает если на участок заходят посторонние. Ищем хозяев, которые будут им заниматься.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Вольер','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_36811/joshi_0_5f61d5f8523c0.jpg',300,296,NULL),(271,'Уголек','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Черный','17','Хорошее','На фото - Уголек. Очень дружелюбный и талантливый щенок. Бездомный. Но он уверен, что мир населен хорошими людьми!  И его обязательно полюбят\".\nВ предновогоднюю пору мы особенно остро верим в чудо! Прямо до слез! А вот оно, чем не чудо? Наверное, это такой кайф - после длительного одиночества, холода и скитаний вдруг раз - и обрести новую жизнь, в которой тебя любят, обнимают и кормят. А ты, такой гордый - ждёшь хозяина. Это, наверное, особый собачий кайф - ждать хозяина.\nЖдать - и дождаться...','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_39178/ugolek_0_5fd8e421d827d.jpg',301,297,NULL),(272,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',302,298,NULL),(273,'ЛилиЛулу','Ищет дом','Женский','3 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Коричневый','15','Хорошее','Лили и Лулу - две прелестные сестренки, уже давно с надеждой ожидающие свой шанс стать домашними...\nДевочкам около 2 лет, обе ласковые, спокойные, нежные и абсолютно миролюбивые. Хорошо ходят на поводке, всегда гуляют вместе, привязаны друг к другу. Любят и ценят человеческое внимание и ласку, прекрасно с сородичами и детьми.\nИщем обеим девочкам семью, которая подарит малышкам радость быть нужными и любимыми. Желательно пристройство вместе, хотя рассмотрим и по-отдельности. Рост в холке 35-40 см, стерилизованы, привиты и чипированы.\nЛили и Лулу ждут Своего Человека!\nМожно в частный дом, но строго не на цепь и не в будку!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_27566/lililulu_0_5db6ee6b32cc8.jpg',303,299,NULL),(274,'Рыжулькин','Ищет дом','Мужской','7 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','35','Хорошее','?Мистер Джинджер - самый обаятельный и привлекательный рыжик с янтарными глазами ищет дом!\n\nЭтот солнечный пушистик олицетворение уюта и гармонии, Рыжик отлично подойдёт семье, у которой не было опыта содержания собак и семье с детьми: станет ребятишкам прекрасной няней и будет их оберегать.\n\n?Рыжик хорошо воспитан, позитивен, ходит на поводке, хорошо переносит машину, дружелюбен с другими собаками и заряжает добром всё вокруг?\n\n✅Возраст ~6 лет, привит, кастрирован, есть вет.паспорт.\n\n✅Рыжик пристраивается по договору с возможностью быть в курсе его дальнейшей судьбы?, в Москву или МО, в квартиру или частный дом (с проживанием внутри дома).\n\nЗвоните!','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_26697/ryzhulkin_2_5d96094a3c90a.jpg',304,300,NULL),(275,'Граф','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Рыжий','40','Хорошее','Новый дом ищет Граф!\nКрупный, статный, флегматичный. Возраст около 2 лет. Характер сильный, подойдет людям, имеющим опыт содержания собак. В семью без маленьких детей и собак-доминантов. Рост 60-65 см в холке, вес около 40 кг.\nЗдоров, привит, кастрирован. Знает команды, ест сухой корм.\nЖивет на передержке близ Бронниц (Московская область). \nПристраивается в квартиру или частный дом с обязательным содержанием в тепле.','Спокойный','Общительный','Равнодушное','Равнодушное','Равнодушное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_30657/graf_0_5e43e68538536.jpeg',305,301,NULL),(276,'Дарина','Ищет дом','Женский','2 года','Нет','-не уточнено-','Крупный','Семейная','Породистая','Короткая','Коричневый','51','Хорошее','Добрая и ласковая с людьми - она будет прекрасно охранять участок. Замечательная нянька детям. Любит попрыгать и повеселиться. Молодая и озорная. При этом никогда не откажется поваляться на спине и почесать пузико','Активный','Общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Вольер','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_38513/darina_0_5faee48026c59.jpg',306,302,NULL),(277,'Стеша','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','21','Есть небольшие проблемы','СТЕША\nМолодая, добрая, активная, общительная небольшая.\nСтеше около 5 лет \n - стерилизована, \n- привита\n- чипирована\nБыла пристроена в семью подростком, жила с маленьким ребёнком, в квартире с кошками, дружелюбна со всеми.\n Так получилось, что Стеша снова в поисках нового дома, своей новой любящей и заботливой семьи.\nСейчас живет на передержке, в доме, в комнате с другой собакой, не конфликтна. Есть опыт проживания в квартире, в городе. Приучена к выгулу, социализирована, знает что такое поездки в машине.\nПо здоровью: потребность в приеме лекарств ( ферменты ) и лечебный корм.\nОчень ищем любящих мам/пап для Стеши\nПодробности можно узнать созвонившись.\nПриезжайте знакомиться. м. Филатов Луг\nОтдаётся по договору об ответственном содержании, с возможностью ненавязчивого отслеживания дальнейшей судьбы.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_28893/stesha_0_6059939c28dc6.jpg',307,303,NULL),(278,'Корж','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','22','Хорошее','Корж мальчик совсем молодой, его возраст 1-1,5 года. Малыш не оставляет неравнодушным никого, он обладает необычайной харизмой. Он очень добрый и игривый, очень активный и безумно обожает ласку, обнимашки мальчик безумно обожает. Совершенно лишён агрессии, не реагирует даже на агрессивен от других собак, дружелюбен со всеми хвостиками. Вы не ошибётесь в своём выборе, если дадите ему шанс. Вы всегда можете приехать познакомиться и погулять с малышом.','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39788/korzh_0_5ffa1899ca7c1.jpeg',308,304,NULL),(279,'Степан','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Крупный','Охранник','Метис','Средняя','Палевый','50','Хорошее','Отдадим в добрые руки доброго и очаровательного мальчика по имени Степан. Хозяйка этого прекрасного мальчика бабушка 72 года, живет одна и сама с ним уже не справляется, не позволяют возраст и здоровье, в последнее время плохо себя чувствует. Степан очень умный и послушный, подойдет для охраны частной недвижимости. Привит, кастрирован, кушает всё, очень добрый к своим людям и собакам, надёжный защитник. Возраст 5 лет, вес около 50 кг, хорошо идёт на поводке, знает команды. Будет великолепным другом и охранником Вашего дома и семьи!','Спокойный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Загородный дом','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_41415/stepan_0_6054a8dc8dc6e.jpeg',309,305,NULL),(280,'Тихон','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','28','Хорошее','Тихон живёт у нас в настоящее время в квартире, где ему тесно и очень некомфортно. До этого 1,5 года жил на даче. К сожалению там за ним больше не кому было присматривать и мы его забрали в квартиру. \nОчень спокойный пёс, приучен к командам, гуляем с утра и вечером и он обязательно делает свои дела. Очень умный пес, с характером, и в тоже время залижет до умопомрачения.','Спокойный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Загородный дом','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_35559/tikhon_0_5f268c2d96168.jpg',310,306,NULL),(281,'Сноу','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Длинная','Белый','18','Хорошее','Сноу - типичный подросток! Бесконечное желание засовывать свой нос во все возможные места, неутомимая энергия и желание устроить чего-нибудь такое, чтобы потом за это еще ничего не было - это вот про него! Если в вашей жизни не хватало только вечного двигателя, то на эту роль Сноу подойдет без проблем. Одновременно прыгать, вилять хвостом, приветствовать воооон ту собаку и испугаться вот этой упавшей ветки? Это только часть опций оперативной памяти на секунду времени. А еще Сноу очень красивый и мяяяягенький! Малышу около 10 месяцев, он кастрирован, привит, чипирован, имеет паспорт и готов отправиться домой.\nОтдается по договору ответственного содержания с отслеживанием судьбы.','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_25395/snou_0_5f22d85594000.jpg',311,307,NULL),(282,'Чумруша','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Породистая','Средняя','Белый','15','Хорошее','Ты молодой и активный? Любишь долгие прогулки на свежем воздухе и активный образ жизни?) не любишь долго находится на одном месте? Мечтаешь о друге, который бы разделил твои интересы?) Тогда специально для вас, любителей активного образа жизни, наш компактный вариант собаки, ведь ее 15 кг идеальны для квартиры! Энерджайзер, подобранный на дороге у леса и спасённый от клещей и пироплазмоза!Барышня хороша собой, молода (чуть меньше года), стройна, гибка и грациозна! Еще пока не стерилизована (в договоре есть пункт об обязательной стерилизации). С такой подругой Вам точно не будет скучно! Она принесёт в ваш дом любовь и веселье, а Вы научите ее правильным манерам, так как малышка легко обучаема и впитывает все, как губка!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31282/chumrusha_0_5e5cd558c64bd.jpg',312,308,NULL),(283,'Лоня','Ищет дом','Женский','10 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','4','Хорошее','Чудесная малышка Лоня ждёт свою семью!\nВозраст около 2,5 месяцев.\nАктивная, смышленая, среди своих сверстников проявляла лидерские задатки.\nИгривая и добрая.\nПриучина к поводку, в туалет ходят на улицу, обработна от глистов.\nЛоня очень хочет скорее стать домашней и любимой!\nЗвоните, приезжайте знакомиться!\nОтдаётся строго совершеннолетним людям, с ненавязчивым отслеживанием жизни малышки!\nТерриториально Звенигород, в новый дом доставим!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35583/lonya_0_5f27ce9bcc056.jpg',313,309,NULL),(284,'Кай','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Белый','39','Хорошее','Кай ?☺️\nВозраст около 5-6 лет\nВоспитанный, приучен к поводку. Спокойный мальчик, метис- алабай. Прекрасный стораж вашего спокойствия и отличный друг!\nЖдёт свою семью, возможно это именно.','Спокойный','Сдержанный','Равнодушное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_37222/kaj_0_5f7419359da5a.jpg',314,310,NULL),(285,'Стеша','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Серый','20','Хорошее','Москва и МО❗❗❗\nПристраивается девочка - Стеша!\nЕй почти годик. Стеша длинноногая красотка, чуть выше колена.\nПривита✅\nСтерилизована и имеет ветеринарный паспорт.\nОна подойдёт в частный дом, а также для квартиры. Ходим на поводке , но немного тянем. Стеша очень робкая, нежная человекоориентированная собака. Ей рчень важно находится рядом с человеком.Поэтому в доме она будет ходить за вами по пятам, но при этом не надоедать. Тихонечко ляжет рядом с вами и все. Она не скулит и не лает, когда вас нет дома. Не портит мебель и обувь. Приучена к выгулу на улицу, дома может сходить на пеленку по маленькому. Дружелюбна с кошками и с другими собаками. Очень любит детей. Агрессии не проявляет. Стеша отличный компаньон. Она будет предана вам и для нее очень важно, чтобы ее не предавали.\n Знает команды: \n1. Дай лапу \n2. сидеть. \nТаких собак берут для души♥\nКушаем сушку, а также каши с консервами.\n Если хотите познакомится , звоните.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_33294/stesha_0_5f43ed46f1594.jpg',315,311,NULL),(286,'Рокси','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Палевый','20','Хорошее','Прелестное юное создание прибилось к нашим дачам.\n\nЧто мы имеем: \n\nДевчушка, максимум год от роду, назвали Рокси, белоснежные зубы, поведение щенка. Ласковая добродушная дурилка. \n\nПонятное дело, летом она сытая и довольная. Но лето кончится, начнётся ад. \n\nЧерез неделю мы силами дачников ее стерилизуем. А дальше нужен постоянный дом. Территориально - Завидово. Граница Московской и Тверской области.','Активный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_35631/roksi_0_5f2a64b60439c.jpeg',316,312,NULL),(287,'Рейс','Ищет дом','Мужской','10 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','20','Есть небольшие проблемы','Знакомьтесь, это наш красавец с необычным именем Рейс. Ему около 10 лет и большую часть своей жизни он прожил в приюте, попав туда еще подростком. У Рейса возрастное заболевание и он принимает гормональные препараты.\nТем не менее мы не теряем надежды найти Рейсу настоящий дом, где он будет членом семьи, где его будут любить и никогда не предадут. Послушный, умнейший, беспроблемный пес, чудесно ладит с детьми и другими животными. Всех любит, всем всегда рад. Ходит на поводке идеально, знает команды и с радостью демонстрирует свои умения. Рейс любит быть в центре внимания, он не разочаровался в людях, пережив череду предательств. Он всё еще верит и ждет своего человека!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_33212/rejs_0_5ebe94c81be88.jpg',317,313,NULL),(288,'Аля','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','19','Хорошее','АЛЯ, возраст около 2,5 лет.\nВот это характер, мы Вам скажем) Бомба, огонь и пушка☀️ Аля без устали жарит в погонях типа #догонименяпервый #оставьмнесвойхвост #толькопопробуйотними и так далее) Даст фору любому темпераментному подростку)\nИ, если включит режим «пли», не уйдёт без победы!\n\nПрисмотритесь внимательно, ведь это настоящая красавица. Шерсть с отливом - не фильтр?\nИстория, которая приключилась с Алей обычна. Посёлок, прибившаяся к людям собака. Дружелюбная, умная, терпеливая девочка. Играющая с детьми, ласковая и доверчивая. Жители снт разделились на тех, кто сдаёт деньги на прокорм «штатных» бездомышей, и тех, кто категорически недоволен. Так собака оказалась в приюте. Совсем скоро Аля познакомилась со всеми собратьями. Выбрала друзей.\n\nАЛЯ очень и очень ориентирована на человека, ищет внимания. Уже при первом знакомстве открыта и спокойна.\n\nВсе время, что мы наблюдаем АЛЮ, не оставляет ощущение, что собака бывшедомашняя.\n\n❄️Аля здорова, привита и стерилизована\n❄️Отлично ходит на поводке\n❄️Приучена к выгулу\n\nИщем для Али семью, где она будет единственной собакой. Москва и МО.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_39622/alya_0_5ff04a240abcf.jpg',318,314,NULL),(289,'Ральф','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Рыжий','10','Хорошее','Очаровательный и смышленый малыш с замечательным характером и добрыми глазами,  очень общительный и контактный - хорошо ладит с людьми, детьми, другими собаками и кошками. Характер обещает быть спокойным, проявляются черты будущего охранника и защитника. Очень умный, реагирует на голос, ограничительные команды. Приучен к пеленке, привыкает к выгулу. Умеет ходить на поводке. Абсолютно здоров, обработан от блох и паразитов,  привит. Есть сухой корм и натуралку (приучение на Ваше усмотрение). Толко начинает откликаться на кличку. Очень ждет своих хозяев!','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_35353/ralf_0_5f1d3def60986.jpeg',319,315,NULL),(290,'Бекки','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Длинная','Рыжий','22','Хорошее','Собака из приюта','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40432/bekki_0_601ba9e0e556f.jpeg',320,316,NULL),(291,'Санта','Ищет дом','Мужской','5 месяцев','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Белый','3','Хорошее','Друзья! Для счастливого завершения нашей истории о приютских щенках остался маленький, но важный шаг. 8 домашних колобков теперь любимы и зацелованны, радуют нас своими успехами и детскими открытиями. Но у нас остался один непристроенный щенок Санта. Прекрасный щенок, с забавными повадками, бесконечными ушами, совсем ручной и самый человекоориентированный.\nСанта получил свою первую прививку, освоил пелёнку и совсем не понимает почему он так старался расти и изучать все квартирные премудрости, а за ним так никто и не пришёл. Он очень сладкий, очень рвётся жить и на ручки) Если вы ищете друга, то Санта вас не подведёт. Он то самое верное сердечко-для дружбы, для любви, для совместных походов в лес. Хозяин, найдись ???','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Равнодушное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_40348/santa_0_601570c73ec69.jpg',321,317,NULL),(292,'Синди','Ищет дом','Женский','1 год','Да','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','12','Нет','Щенок Синди! Просто красавица! Веселая, часто смешная, актриса! Умеет состроить рожицу, улыбаться, грустить и просто веселиться! Девочка без комплексов! Контактная, игривая, дружелюбная. Человекоориентированная, Добрая. Очень достойная собачка!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_36785/sindi_0_5f60d066e4c42.jpg',322,318,NULL),(293,'Хьюго','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Средняя','Палевый','31','Хорошее','Хьюго бессмысленно показывать на фото, и вы поймете почему, увидев его в движении! Уходит щенячья неуклюжесть, на смену приходит грациозность! Не просто грациозность в привычном понимании этого слова, а та грациозность, которой обладает крупный, мускулистый, молодой пес! \n\nЕму бы бороздить просторы леса, поля или парка вместе с хозяином! Дать выход своей силе в прогулках и занятиях, а не сидеть в тесном вольере. Так молод, красив... Такой потенциал у собаки, но Хьюго приютский?\n\nЗдесь не будет у него многочасовых прогулок и спортивных занятий. Максимум это прогулки по выходным по территории приюта и возможность побегать в ряду в будни. Молодость - прекрасное время! И мы очень не хотим, чтобы свою молодость Хьюго провел в приюте! Поэтому как можно скорее ищем дом этому красавчику! \n\nХьюго подойдет в любую семью, но нам бы очень хотелось найти для него людей, которые бы занимались собакой: прогулки?, дрессировка, интеллектуальные нагрузки! \n\nПривит, кастрирован, ходит на поводке, 60 см в холке, выше колена. Парень сперва стеснительный, но через некоторое время становится ручным котенком.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_27294/khyugo_0_5dabf3951b721.jpg',323,319,NULL),(294,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',324,320,NULL),(295,'Бейли','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','20','Хорошее','Бейли малышом в мороз выкинули на помойку. Помог ему случай, его спасли. Сейчас он находится на временной домашней передержке с 2 кисами и старшим песиком.\nБейли ждёт встречи с хозяином!\n✅Мальчику 1-1,5 года.\nКудрявый волчонок крупного размера, обожающий веселиться, играть, жаждущий ласки, внимания и любви.\nВ своём возрасте он уже четко знает основные команды. Любит их продемонстрировать и получать поощрения вкусняшкой или добрым словом.\n✅Обладает эффектным внешним видом и притягивает к себе восхищенные взгляды прохожих. Он просто звезда на прогулке!\n✅Здоров. Обработан от паразитов. Привит. Кастрирован.\nПриучен к выгулу.\nБейли неприхотлив в еде. ЯБЛОКИ - это его отдельная любовь.\n✅Ладит с детьми.\nДружелюбен с другими собакам.\nСвою территорию знает и умеет охранять.\nКошки вызывают у него интерес и охоту с ними поиграть, но они странные, и не всегда отвечают взаимностью.\nС ним можно приехать и познакомиться, погулять вместе!\nРебёнок очень надеется на чудо и ваши смс и звонки! Давайте вместе поможем обрести ему дом !\nТерриториально Томилино.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_31507/bejli_0_5e68eb6c400bf.jpg',325,321,NULL),(296,'Найда','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Коричневый','- не уточнено -','Хорошее','Симпатичная девочка Найда, похожая на немецкую овчарку (метис с лабрадором), очень дружелюбная. Отдаём в добрые руки потому, что некому стало ею заниматься, дрессировать. В квартире ей тесно, на даче ей было бы в самый раз. Все прививки сделаны. Москва, м. Семеновская.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','- не уточнено -','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_33658/najda_0_5ed35aa522a75.jpg',326,322,NULL),(297,'Рыжик','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','15','Хорошее','Дружелюбный,очень добрый,умный, ласковый, жизнерадостный пёс в добрые руки!','Активный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_27486/ryzhik_0_5db2eb860e099.jpg',327,323,NULL),(298,'Семиона','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','24','Хорошее','Озорная, добрая, весёлая, улыбчивая, обнимательная, умная - это всё про нашу золотистую принцессу Семиону. Сема, как внешними признаками, так и характером напоминает риджбека.\nСвободолюбивая, где-то упертая, но бесконечно преданная своему человеку.\nПри встрече с ней, вы получите бурю положительных эмоций и воспоминаний.\nДа, у неё маленькое сердечко, но любви от этого не становится меньше.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40771/semiona_0_602d78e3caca7.jpg',328,324,NULL),(299,'Сгуша','Ищет дом','Женский','2 месяца','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','4','Хорошее','Девочка, родилась ~22/03/2021 \nОбработана от паразитов, привита нобивак паппи - по возрасту. \nДостаточно спокойная для щенка девчонка, в незнакомой обстановке сначала присматривается, осторожничает, зато через некоторое время, как понимает, что ничего страшного нет - суёт свой любопытный носик просто везде, в каждый закуток). \nЛасковая, активная, смышлёная - всё, как и полагается щенку. Малышка с детства росла с человеком, поэтому, прекрасно социализирована, это будет верный и преданный друг для всей семьи.\n\nПристраивается в квартиру или дом (проживание в доме) по Москве и МО, по договору ответственного содержания, с ненавязчивым отслеживании судьбы.','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42414/sgusha_0_609c556b3f6e9.jpg',329,325,NULL),(300,'Алиса','Ищет дом','Женский','7 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','11','Хорошее','Алиса около 4 месяцев, была подброшена с 5 щенками к воротам СНТ, пока живет у нас в будке на участке.\nКушает кашу с шейками, любит морковку и мандарины. Очень ласковая, умная, коммуникабельная, здоровая, выносливая. С радостью гуляет, ходила пару раз в поход. \nБудем вам отличной подругой и напарницей для активного отдыха.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Загородный дом','Нет','Нет','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_40225/alisa_0_600f17ed04ee4.jpeg',330,326,NULL),(301,'Вольфик','Ищет дом','Мужской','4 месяца','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Серый','9','Хорошее','Вы не поверите, но жители одного СНТ в Тульской области хотели потравить этого чудесного пса крысиным ядом! Хорошо, добрые люди вступились за него. Вольфик ищет свою семью! Он классный и сообразительный малыш! Очень внимательный и общительный, ласковый и тусовочный. Всех любит и обожает. Вырастет в пса. В вашего и любимого. Ориентировочно размером с овчарку. Это будет полноразмерный пес.\n.\nВольфику 2,5-3 месяца. Он привит первой прививкой и обработан от паразитов: от блох и глистов. Ест качественный сухой корм для щенков, здоров, бодр и весел ?, дома только нет у него и собственного хозяина!\n.\nПриезжайте знакомиться с Вольфиком, он не оставит вас равнодушным! Я расскажу про него и поддержу в воспитании ребенка!\n.\n8-929-570-10-35 Катя (Москва и МО)','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_41395/volfik_0_60538fe70acfc.jpg',331,327,NULL),(302,'Буся','Ищет дом','Женский','6 месяцев','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','2','Хорошее','Прекрасная девочка с чудесными очень преданными глазками ищет дом. Очень спокойная и ласковая, станет вашим надежным спутником. Ей почти потора месяца,ждем первую прививку. Щенок здоров. Вырастит в среднюю собаку. Есть корни северной пастушьей собаки (лапландский вальхунд).','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_38329/busya_0_5fa814d422b65.jpg',332,328,NULL),(303,'Бублик','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Серый','22','Хорошее','Бублик молодой парень. Активный, дружелюбный, замечательно ладит с людьми. \nПрибился к стае собак в сентябре 2018, скорее всего до этого был домашним. Обучен некоторым командам, приучен к выгулу, туалет строго на улице.  \nВ стае отношения не сложились, нападали на него . Было много ран за это время, приходилось лечить антибиотиками. Было принято решение отдать Бублика на передержку,  т.к  в стае ему не выжить. \nС апреля он находится на платной передержке, но это временное жилище, а ему просто необходима семья. Он замечательный пёс, приезжайте знакомиться.. и я уверена, что он не оставит вас равнодушными!','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_24165/bublik_0_5d1cb7564f626.jpeg',333,329,NULL),(304,'Ника','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','18','Хорошее','Малышка Ника ищет дом','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_36122/nika_0_5f705a58374b9.jpeg',334,330,NULL),(305,'Мелисса','Ищет дом','Женский','2 месяца','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','5','Хорошее','Зовут Мелисса. Здорова, обработана от паразитов. Внешне Мелисса - сама нежность. Кремовая, плюшевая, сероглазая. Когда вырастет, будет среднего размера. По характеру малышка веселая, активная и бесстрашная.\nОтдается по договору передачи животного взрослым ответственным людям.','Активный','Супер-общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','- не уточнено -','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_42474/melissa_0_60a2c08ee1259.jpg',335,331,NULL),(306,'Йота','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Палевый','29','Хорошее','В добрые руки «золотая» красавица - Йота! Возраст - 5 лет. Что-то никак не заметят в нашем приюте эту красивую малышку, что очень печально! Ей пришлось пройти много испытаний в своей жизни, но при этом она осталась невероятно нежной и ласковой с людьми! И так хочется, чтобы эта прекрасная собака поскорее оказалась окружена любовью и заботой в кругу своей семьи, которая по настоящему станет для неё родной! Как показала практика, в быту это солнышко совершенно комфортная собака - она знает команды и не прочь пообщаться с детками школьного возраста. Отлично гуляет на поводке, послушная умница, приучена к двухразовому выгулу. Единственный немного удручающий нюанс, что с себе подобными и с котами Йоточка, к сожалению, дружить не готова, поэтому ищем ей дом без других животных. Обратите внимание на эту чудесную детку!!! Вы не пожалеете, взяв Йоту в свою семью, ведь Вы обретете не просто собаку, а самого верного и преданного друга!!! Стерилизована, привита, имеет ветеринарный паспорт, пристраивается бесплатно по договору ответственного содержания людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. Мамы и папы, где же вы?! Звоните нам и приезжайте скорей за этой красотой!!!','Активный','Общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_37696/jota_0_5f8718aa3176f.jpeg',336,332,NULL),(307,'Мальта','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','32','Хорошее','Четырёхлапый ураган в пятнах\n⠀\nМальта скорее подойдёт для активной семьи, которая будет готова уделять много внимания её воспитанию и не жалеть времени для прогулок. Причём, прогулок как с активными играми, так и с занятиями на «торможение». Ибо в собаке море необузданной энергии. Семья, безусловно, должна быть любящей, ответственной и терпимой к проказам Мальты. Терпимой и, прежде всего, готовой к ним.\n\n⠀\n\nСемья Мальте подойдет с опытом кинологической подготовки, либо готовая пойти вместе с Мальтой в \"школу\" для лучшего изучения и понимания друг друга. \n\n«Вожак стаи» должен иметь внутренний стержень для эффективного сосуществования с Мальтой. Человек мягкий, не готовый воспитывать собаку, не готовый вовремя отдёрнуть поводок, не умеющий говорить «нет» для Мальты не подойдёт.\n\n⠀\n\nКомфортнее всего ей будет в частном доме с возможностью свободного передвижения по двору (при условии, что собака не будет иметь ни малейшего шанса улизнуть: сделать подкоп и т.д.). Но это не значит, что Мальту нельзя взять в квартиру. Если её регулярно нагружать воспитательными процессами, регулярными занятиями, развивающими играми и длительными, эффективными прогулками, положительный результат не заставит себя ждать. И дома (в квартире) Мальта будет отдыхать, набираясь сил в ожидании новых утомляющих открытий.','Активный','Общительный','- не уточнено -','Может проявить агрессию','Может проявить агрессию','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_33822/malta_0_5edbd8d071f46.jpg',337,333,NULL),(308,'Соня','Ищет дом','Женский','3 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Коричневый','22','Хорошее','Соня собака с обычным окрасом и тяжелой судьбой, но она всё ещё верит, что на свете есть человек, который её полюбит и подарит дом.\nСоня небольшого размера и вполне может подойти в квартиру. Может уживаться с другими хвостиками, у неё кроткий нрав.\nНемного боязлива, но как только привыкает к обстановке, то меняется на глазах.\nСтерилизована, привита, обработана.\nОтдаётся по договору ненавязчивого отслеживания судьбы людям старше 25 лет.\nДоставка.','Спокойный','Сдержанный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_24473/sonya_0_5d2d940ae336c.jpg',338,334,NULL),(309,'Ева','Ищет дом','Женский','2 месяца','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Палевый','7','Хорошее','Чудесная девочка, мама - маламут, отец - подлец. Привита. Отдается по Договору. Готова к переезду. Строго взрослым людям, в собственное жилье, НЕ НА ЦЕПЬ!!!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_42054/eva_0_607fcbf043d11.jpg',339,335,NULL),(310,'Бекки','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Метис','Длинная','Рыжий','22','Хорошее','Собака из приюта','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40432/bekki_0_601ba9e0e556f.jpeg',340,336,NULL),(311,'Ханна','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','25','Хорошее','Москва и МО.\nХанна, 2,5 года, 30 кг и 60 см в холке.\nНастоящая семейная собака!\nЕсли вам нужен верный друг и член семьи, присмотритесь к Ханне! Лучше Ханны не найти компаньона для прогулок, домашних посиделок, почесушек и позитивного общения с классной, большой, ласковой и игривой собакой ?\nОбожает детей, очень ласковая к людям, с кошками и собаками дружит, но постоять за себя сможет, если ее будут обижать.\nПриучена к двухразовому выгулу, в квартире ведёт себя исключительно спокойно.\nЗдорова, привита, обработана от паразитов, стерилизована, есть ветеринарный паспорт.\nПознакомиться с Ханной можно в Москве, м. Молодежная.\nЗвоните! +79160681222','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_26931/khanna_0_5f650d3c8c6ad.jpg',341,337,NULL),(312,'Миниатюрная Эллис','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','13','Хорошее','Всем-всем-всем! Вашему вниманию представляем одну из самых противоречивых наших подопечных - Эллис. Не сочтите за недостатки – речь о только преимуществах!\n\nНапример, при очень нежном отношении к человеку и абсолютном контакте с другими собаками, Эллис явно проявляет охранные качества. При должной дрессировке, уверены, будет претендовать на роль очаровательного сторожа частного дома.\n\nРазмеры у Эллис весьма компактные (всего 15 кг), а энергии за двоих, потому мы мечтаем о комфортном вольере для нашей девчушки, собственной территории, долгих прогулках и играх с самыми лучшими людьми-компаньонами.\n\n \n\nЭллис молода, ей всего 2 года, абсолютно здорова, привита по возрасту и стерилизована. Хозяина только нет…\n\n \n\nПристраивается по договору с возможностью ненавязчивого отслеживания судьбы.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_8197/ellis_1_5b8e722ba7d7c.jpg',342,338,NULL),(313,'Рамзем','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Породистая','Короткая','Белый','15','Есть небольшие проблемы','Очаровательный плюшевый мальчик РАМЗЕС ищет свою СЕМЬЮ \n\nЕму примерно 7 лет. Он добрый, милый, нежный, общительный. По характеру спокойный, уравновешенный, если можно так говорить про бигля?. Сейчас проживает на квартирной передержке с собакой и кошкой. Поведение в квартире может потребовать корректировки. Есть небольшие вопросы по здоровью, поэтому сейчас кушает лечебный корм. Привит, чипирован, кастрирован. Пристраивается по договору, в Москву и Санкт-Петербург только ответственным, терпеливым людям без жилищных проблем, имеющим возможность сделать нашего биглика счастливым.\n\nПривит\nКастрирован \nЧипирован \nЕсть паспорт европейского образца \nК кошкам безразличен, также как и к другим собакам.','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','- не уточнено -','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_37277/ramzem_0_5fb4b65eedf3f.jpeg',343,339,NULL),(314,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',344,340,NULL),(315,'Лютик','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','15','Хорошее','Лютик - душа компании, весельчак и всеобщий любимчик! Если вы гуляли с ним однажды, уверяю, Вам захочется ещё и ещё. Невозможно не влюбиться в эти мягкие ушки и хвостик - бараночку.\nЛютик обожает всех людей без исключения, отлично ладит с детьми и нет зооагрессии . С Лютиком можно и подурачиться, и побегать, но также можно и спокойно посидеть на полянке, рассказать ему какую нибудь историю. Он будет всегда рядом, будет смотреть на Вас влюблённым взглядом и все понимать. Лютик умный пёс, он уже умеет сидеть по команде, прыгать через барьер, а также готов учиться чему-нибудь новому, главное, чтобы человек был рядом.\n\nСамый большой страх Лютика - остаться одному! Он очень переживал, когда его подружку Эльзу пересадили в другой вольер. Остаться без друга сложно, но ещё сложнее Лютику даются прощания с человеком. Он начинает нервничать и плакать, просить вернуться и никогда его больше не оставлять.\nЗа свою не долгую жизнь, Лютик уже познал, что такое предательство со стороны человека. Именно это и повлияло на него, именно это и внушило страх одиночества.\nЛютик подойдёт в семью опытных собаководов (возможно тех, у кого был опыт с хаски)\nЛюбит детей, неоднократно проверено, может подойти в семью, где уже есть собака.\nЛютика отдаём только в квартиру!','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_32223/lyutik_0_5e91f9ad87603.jpeg',345,341,NULL),(316,'Оникс','Ищет дом','Мужской','8 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Длинная','Рыжий','17','Хорошее','Оникс - самое настоящее солнышко! \n\nЭтот яркий и очаровательный песик ещё совсем ребенок. Он просто обожает людей: проводить время с человеком, тискаться, обниматься и изучать новые команды! Оникс никогда не забывает про своего друга - человека! Мальчишка всегда смотрит в глаза, считывает эмоции и всегда радуется прогулкам. В своем юнном возрасте малыш уже знает команды: сидеть, лежать и дай лапу! Но на этом Они не собирается останавливается и с интересом изучает новые команды с опекуном!\n\nНо к сожалению, это золотистое чудо, с таким чудесным характером, проводит свое детство в стенах приюта. Малыш очень любит людей и очень скучает без внимания. Ему приходится делить маленький вольер, еду и воду вместе с другими собаками. Наивные глазки Оникса полны надежды, он верит что совсем скоро к нему придет его человечек, которого он сможет каждый день радовать и изучать этот мир! Приезжайте знакомиться, Оникс очень ждет вас!','Активный','Супер-общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_42308/oniks_0_6092aff865667.jpeg',346,342,NULL),(317,'Росси','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Черный','- не уточнено -','Хорошее','Друзья, очень хочется мальчика Росси пристроить в добрые и любящие руки.\nЕму год. Весёлый и жизнерадостный парень!\nЛабрадор с небольшой примесью.\nЕст всё. К улице приучен. Прививки сделаны. \nГотова устно ответить на все вопросы.\nЗаранее спасибо будущим хозяевам!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_36898/rossi_0_5f64a35825066.jpg',347,343,NULL),(318,'Амур','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Рыжий','25','Хорошее','АМУР\nЗолотистый дворривер с золотым характером!!!\nАмур поклонник активного образа жизни: любит природу, долгие прогулки, бегает как лань, но не убегает, держится рядом с хозяином.\nАмур привит, обработан от паразитов. Ему 5 лет, он прекрасно знает что можно, а что нельзя. Замечательный вариант для взрослых и сознательных людей, которые ценят постоянство и преданность.\nВ отношении человека не агрессивен. Можно абсолютно не беспокоиться, что Амур кого-то укусит. С чужими людьми осторожен, на прогулке предпочтет обойти их стороной.\nЕсть у Амура и маленький косячок. Парень наш заядлый охотник. Так что кошки, куры, кролики с Амуром проживут недолго.\nНо зато он прекрасно уживается с представителями своего вида! Отлично подойдет второй собакой в семью!\nЕсли Вы мечтали о преданном и ласковом друге, если Вы любите отдых на природе и не являетесь заядлым кошатником, то Амур – пес для Вас!\n\nЗвоните и приезжайте знакомиться с нашим плюшевым медвежонком!','Активный','Общительный','Равнодушное','Может проявить агрессию','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_38736/amur_0_5fbad322e0d17.jpg',348,344,NULL),(319,'Симона','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Коричневый','23','Хорошее','Красавица Симона очень ждёт свою семью!\nУмная, спокойная, ненавязчивая и послушная девочка.\nЗнает команды, хорошо ходит на поводке, приучена к улице и дому. Здорова, стерилизована, привита. Возраст около 2.5 лет.\nВес 23 кг.\nЛасковая и преданная собачка, привязана к людям, к одному месту и будет счастлива разделить с Вами одну крышу над головой.\nСобака-компаньон во всех делах, на прогулках, в машине и дома. Красивая, статная, небольшого размера, с красивым окрасом.\nНаходится на частной передержке в М.О., Бронницы.\nОтдаётся по договору ответственного содержания','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_36286/simona_0_5f49262e849bc.jpg',349,345,NULL),(320,'Майна','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','17','Хорошее','Очень красивая и добрая девочка ищет дом','Активный','Общительный','Доброжелательное','Может проявить агрессию','Доброжелательное','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_24606/majna_0_5d7fdd0a60bab.jpeg',350,346,NULL),(321,'Соня','Ищет дом','Женский','6 месяцев','Нет','-не уточнено-','Крупный','Семейная','Породистая','Короткая','Серый','63','Хорошее','Соня, восточно-еврорейская овчарка, возраст 6 месяцев отдаётся в дар.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41660/sonya_0_606564f61d278.jpg',351,347,NULL),(322,'Ника','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','2','Хорошее','Щенок-девочка, возраст 2-3 мес, . Взят с улицы 1.5 недели назад. Осмотрен у ветеринара, 2 раза проглистогонен. Ласковая, игривая.Очень ждет своего хозяина или хозяйку.','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_27746/nika_0_5dc0f2a102b1b.jpg',352,348,NULL),(323,'Петра','Ищет дом','Женский','10 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Черный','16','Хорошее','Петра. Потому что юморная и жизнерадостная собака, да, немного трусишка, но виден-виден потенциал и в улыбке и во взгляде:) \nПетра некрупная собака среди приютских жителей, каких нибудь килограмм 16! Ну чем вам не квартирная собака? \n \nС другой стороны, как бы мы не рекламировали, не расписывали подопечных приюта и не разукрашивали качество фотографий, человек Петры сразу все поймет и примет решение. \nБывает, конечно и на описание смотрят, так мы и тут распишем:) \nЕсли вы … Мы тут запнулись, потому что Петра в любую семью подойдет. И одиноким, и большой семье, и с детьми и с другими животными:) Ну поглядите как ухо одно навострила! \n \nНо скажем так же честно, что Петруня у нас девушка пока еще скромная и вам придется первое время терпеливо почемучку знакомить с городской суетой. Не без этого. \n \nПетре около 9 лет. Да, да - и не скажешь:) Привита, стерилизована, приучена к поводку, рост в холке 45-48 см, ниже колена. Можно абсолютно в любую семью, но с пониманием, что собака из приюта будет привыкать к городскому шуму, ко всему новому, что у нее благодаря вам появится:) \nКристина 8 919 116 06 63 \nЕсли вам не ответили на звонок, пришлите смс со словом \"Петра\"','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Вольер','- не уточнено -','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_29312/petra_0_5e01082c10d13.jpeg',353,349,NULL),(324,'Шакти','Ищет дом','Мужской','9 лет','Нет','-не уточнено-','Крупный','Охранник','Метис','Средняя','Черный','36','Хорошее','Метис немецкой овчарки Шакти, около 8 лет по возрасту –  это эксклюзивный пес. В чем же его эксклюзив? В редком темном окрасе кожи под шерстью. В вокальном даре и желании совершенствоваться в пении. В способности осторожничать и любопытствовать одновременно. В умении быть и сверхрезвым и архиспокойным. В таланте принимать критику и прилежно учиться. В стремлении стать лучше, хотя куда уж лучше! Шакти хорошо ходит на поводке, пока не увидит соплеменников. И тогда устремляется: к сукам - «кадриться», к кобелям…. «поговорить по душам». Кошек не уважает! Шакти дорожит контактом с людьми, любит малышню. Он приятен в общении: ласков, дружелюбен. Жители Москвы и Подмосковья! Приезжайте к нему, полюбуйтесь, познакомьтесь! Вдруг вам понравится мечтающий помогать вам, называться вашим любимцем симпатичный стройный паренек с индийским немужским, зато божественным именем?','Активный','Общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Вольер','- не уточнено -','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_25762/shakti_0_5dbdeef857c18.jpg',354,350,NULL),(325,'Дружок','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','- не уточнено -','Хорошее','Друзья! Помните, как все мы в детстве мечтали о собаке и просили родителей завести мохнатого друга? Уверяли, что уже совсем-совсем готовы к такой ответственности. А самые стойкие еще и демонстрировали эту ответственность – активно принимались убираться в своих комнатах и становились самыми послушными детьми в мире. Незабываемое время… \n\nСейчас самое время вспомнить, и поэтому знакомим вас с нашим Дружком!\n\nДружок - это та самая собака из детства, самый настоящий друг. Веселый, активный, дружелюбный, абсолютно компанейский парень. Тот, кто возьмет к себе Дружка не просто вернется в то волшебное время, когда слова «ипотека», «офис» и «расходы» казались взрослыми и невообразимо скучными. Его новая семья в полной мере ощутит на себе, что такое преданность, дружба и активное времяпровождение. Хотите посмотреть, как могут преобразиться все эти смазанные взрослые будни? «Эй, хозяин, давай наперегонки до того столба?», «а может познакомимся вон с той красоткой в шлейке, а?», «погоди, не нравится мне, как смотрит этот подозрительный чужак, дай-ка и я на него косо гляну», «ха-ха, смотри как разлетаются эти смешные голуби! А давай теперь погоним их вместе». \n\nВ общем всем, кто мечтал в детстве о собаке, посвящается…\n\nДружок, 4 года, 50 см в холке, приучен к поводку, здоров, чипирован, кастрирован, привит.','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_21476/druzhok_0_5ca0aa5e75140.jpg',355,351,NULL),(326,'Кефир','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','25','Хорошее','Милый Кефир мечтает о семье!\n\nКефир - жизнерадостный, позитивный мальчик, обожающий человека и готовый обниматься при каждом удобном случае)\n\nОн тянет мордочку и лапки через решетку вольера, привлекая ваше внимание и начинает улыбаться, когда вы подходите его погладить)\n\nКефир очень любит гулять и веселиться, при этом очаровывая всех вокруг!\nМальчик идеальный компаньон, он подойдёт в любую семью, так как прекрасно найдёт общий язык с детьми, взрослыми, кошками и собаками!\n\nКефирчик учится хорошо ходить на поводке, очень старается и даже когда от эмоций может слегка потянуть, сразу останавливается и смотрит на опекуна трогательными глазками, как будто извиняясь. Мальчик очень ориентирован на людей и во всем старается угодить.\n\nКефир здоров, привит, кастрирован, весит около 25 кг, в холке около 55см, возраст 1,5 года.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_34990/kefir_0_5f0df5b452fa9.jpg',356,352,NULL),(327,'Кики','Ищет дом','Женский','8 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','- не уточнено -','Хорошее','Отдадим в хорошие руки! Была куплена как корги, выросла большая корги! Возраст 8 месяцев, в холке около 60 см., все прививки сделаны по сроку, имеется паспорт. Очень добрая, растет с детьми разных возрастов, к маленьким детям не агрессивна. Прекрасно ладит с кошками. Ест сухой корм proplan в перемешку с мокрым. Уезжаем в командировку, с собой взять не можем. \nПо всем вопросам звоните 89262675557 Екатерина','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_42525/kiki_0_60a665a7595e6.jpg',357,353,NULL),(328,'Барни','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Длинная','Серый','19','Хорошее','Барни очень ласковый и нежный пеёс. Полностью ориентирован на человека. Ладит с другими собаками и кошками.Любит детей\nБарни 3 года, вес 19 кг. Отдаём по договору надёжным людям\nПришлю на Вотсап видео\n8 953 46 57 882 Ольга','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Равнодушное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_30659/barni_0_5e43fb668fed4.jpg',358,354,NULL),(329,'Трюфель','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Серый','18','Хорошее','Ищет дом самый невероятный хаски не как хаски!\nПриглядитесь к нему, Трюфель метис хаски, гораздо более спокойный и немного меньше размером чем его собратья)\nСкорее всего его выкинули в Таширово или просто не искали. Он больше месяца жил на улице около одного и того же дома, и никто его не нашел.\nСейчас парень ищет новый дом!\n✅Молод и хорошо обучаем (меньше года!)\n✅Кастрирован,\n✅Привит\n✅Чипирован\n✅Адекватен к детям, собакам и кошкам\n\n➡Отдается строго не на цепь, охранными качествами не обладает и гулять должен строго на поводке или на участке с глухим высоким забором. Помним, что это не самая привязанная к месту жительства порода .\n➡Отдается по договору ответственного содержания животного, с ненавязчивым отслеживанием судьбы.\n➡ Привезём в новый дом сами, не беда, если у вас нет машины.\nА познакомиться можно в районе Плесенского, на передержке.\n\nЭтот невероятный нос запал вам в душу?\nПишите в вотсап и задавайте вопросы, мы не кусаемся!','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35772/tryufel_0_5f3024dea86aa.jpg',359,355,NULL),(330,'Хилари','Ищет дом','Женский','10 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Коричневый','20','Хорошее','Хилари - спокойная и неторопливая умная девочка. Несмотря на свой почтенный возраст, Хил с интересом изучает новые места на прогулке, с дружелюбием относится к собакам и к людям. Хилари с удовольствием составит компанию на небольших и недолгих прогулках. Хилари ищет хозяина, готового уделить ей немного тепла и скромный теплый уголок.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Вольер','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_33229/khilari_0_5ebe97cc3d721.jpg',360,356,NULL),(331,'Трой','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Палевый','- не уточнено -','Хорошее','Он немного стесняется незнакомых людей, но при должном внимании станет самым настоящим другом для своей семьи. Не охранник и не лидер, он тот, кто разделит с вами ваши радости и печали и ничего не попросит взамен.\n\nОбладатель длинной теплой шерсти и задорного характера. Любит принимать снежные ванны и заныривать с головой в снег. Отлично ладит с другими животными, полностью лишен агрессии. Любит длительные прогулки, живо интересуется всем вокруг. Обязательно вас встретит у дверей веселым лаем и с радостью пойдет на прогулку.','Спокойный','Сдержанный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40582/troj_0_6023d4c81b55e.jpg',361,357,NULL),(332,'Бэлла','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Средняя','Белый','10','Хорошее','Здорова, стерилизована. \nХорошо ладит со всеми животными.\nПриучена к двухразовому выгулу. \nОчень нежная и послушная девочка. \nОтдаётся даром взрослым ответственным людям без жилищных проблем Москва или','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_29276/bella_0_5dffd1d594fca.jpeg',362,358,NULL),(333,'Вита','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','17','Хорошее','Москва, МО и другие города. В добрые и ответственные руки тёмный шоколад-Вита! Ей 12 месяцев, полностью привита, ветпаспорт имеется. Будет средних размеров, поэтому ей идеально подойдёт квартирное содержание. Кушает сухой корм, при желании можно перейти на натуральное питание. \nВита - обоятельная малышка с трогательным взглядом. «Мамина конфета», с очень сладкой носопыркой для поцелуев. Собака-нежность и сплошная любовь, абсолютно ориентирована на человека. Активная (-дольше всех обожает носиться по выгулу) и очень хвостовилючая)). Эта милая трепетная мордашка обожает тепло, ласку и почесушки, идеальный компаньон; настоящая семейная собака. Она немного стеснительна и в каких-то случаях полагается на хвостатых братьев и сестричек, отлично впишется в семью с другими животными, в том числе и кошками. Девчушка сообразительная, с легкостью обучается чему-то новому. Вита 100% готовое к дому дитё, поэтому скорее звоните и забирайте этот сладость ДОМОЙ! Отдадим самым лучшим людям и только по большой любви.\nОтдаётся по договору совершеннолетним людям, с дальнейшим отслеживанием судьбы, в квартиру, дом, не в вольер и строго не на цепь.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_25282/vita_0_5d55882623a1b.jpg',363,359,NULL),(334,'Бирон','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Палевый','32','Хорошее','В добрые руки очаровательный мини-танчик Бироша! Мальчишка, несмотря на свои компактные размеры, достаточно сильный, выносливый и активный парень!бМожет вполне прилично тянуть поводок, но достаточно успешно отвлекается на команды и угощение! Бирон умный и очень сообразительный мальчишка, которому требуются занятия и воспитание, как показывает практика, легко обучаем и послушен. Ещё Бироша большой любитель всевозможных шин!) Шины - это наше всё!!! Без шины и гуляние не гуляние!!! Тянет только до поля, делает все свои дела и на шину. Ни на кого внимания не обращает, 10 минут занимается своей находкой, потом спокойно гуляет и всё с любопытством вынюхивает. Хороший пес, добрый и спокойный. Только глазки грустные, когда ведёшь его с прогулки... Конечно, ему не хочется обратно в вольер идти, 9 месяцев прожить в новой семье, а потом обратно в приют... Это самое страшное дня наших собак(( Приезжайте к Бирону, он будет очень рад вниманию и весёлым играм!) Кастрирован, привит, имеет ветеринарный паспорт, отдается бесплатно по договору ответственного содержания. Присутствует зооагрессия, поэтому пристраивается единственным животным.','Активный','Общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_33123/biron_1_5eb86892d3970.jpeg',364,360,NULL),(335,'Власта','Ищет дом','Женский','3 года','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','24','Хорошее','В добрые руки пристраивается любвиобильная Власта!\nВласта - это пример того насколько собаки отличаются от людей. Они никогда не помнят зла, их сердце всегда открыто для любви и преданности к человеку, даже если этого мы не заслуживаем. Несмотря на все тяготы, которые ей пришлось пережить от своего хозяина, Власта очень человекоориентированная собака, неутомимая целовательно-обнимательная малышка. Она никого не оставляет равнодушным) Эту трогательную маленькую пушинку хочется схватить на ручки и больше никогда не отпускать! Во время прогулки она активная и любознательная, умеет играть с игрушками, любит всё исследовать и разнюхивать, но при этом достаточно комфортно гуляет на поводке. Власта вполне дружелюбна как с собаками, так и с кошками. Отлично подойдет в семью с детьми и для людей без опыта содержания собак. Власта стерилизована, привита, полностью здорова, имеет ветеринарный паспорт, отдаётся бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_32231/vlasta_0_60a75f16e60a5.jpeg',365,361,NULL),(336,'Лютик','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Черный','15','Хорошее','Лютик - душа компании, весельчак и всеобщий любимчик! Если вы гуляли с ним однажды, уверяю, Вам захочется ещё и ещё. Невозможно не влюбиться в эти мягкие ушки и хвостик - бараночку.\nЛютик обожает всех людей без исключения, отлично ладит с детьми и нет зооагрессии . С Лютиком можно и подурачиться, и побегать, но также можно и спокойно посидеть на полянке, рассказать ему какую нибудь историю. Он будет всегда рядом, будет смотреть на Вас влюблённым взглядом и все понимать. Лютик умный пёс, он уже умеет сидеть по команде, прыгать через барьер, а также готов учиться чему-нибудь новому, главное, чтобы человек был рядом.\n\nСамый большой страх Лютика - остаться одному! Он очень переживал, когда его подружку Эльзу пересадили в другой вольер. Остаться без друга сложно, но ещё сложнее Лютику даются прощания с человеком. Он начинает нервничать и плакать, просить вернуться и никогда его больше не оставлять.\nЗа свою не долгую жизнь, Лютик уже познал, что такое предательство со стороны человека. Именно это и повлияло на него, именно это и внушило страх одиночества.\nЛютик подойдёт в семью опытных собаководов (возможно тех, у кого был опыт с хаски)\nЛюбит детей, неоднократно проверено, может подойти в семью, где уже есть собака.\nЛютика отдаём только в квартиру!','Активный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_32223/lyutik_0_5e91f9ad87603.jpeg',366,362,NULL),(337,'Астра','Ищет дом','Женский','7 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','32','Хорошее','Не собака, а человек перед нами☝? И, пожалуй, в ее резюме мы не сможем найти даже малюсенький нюансик. Если только, конечно, вы не ищите себе собаку до 6 кг. \nАстра сильная, рослая, молодая собака. Уже позади дурашливость и познание мира через зубы. Хотя нет, дурашливость осталась :) Но такая милая... Вот на мосю взгляните. Человек-ребенок-собака перед нами! \n\nИ самые ее главные качества - это дружелюбие, верность, любовь и обаятельная нежность. Астру обязательно в семью к детям. Ей будет самое оно в детской комнате, когда паровозики по ней ездят, самолеты взлетаю и автомобили паркуются :) \n\nПоверьте, мы все за честность, мы за то, чтобы каждая наша собака из приюта уехала не просто в новую семью, а уехала туда, где будет комфортно всем сторонам. Мы часто слышим от людей, которые взяли у нас подопечного из приюта, что как они могли так глупо ошибаться? Ведь это же самые идеальные собаки! \n\nЕсли вы ищите просто друга, добрую, ласковую собаку, то позвоните Астрочке, пожалуйста...\nПривита, стерилизована, ИДЕАЛЬНО ходит на поводке. Можно в семью вторым питомцем, можно в семью с детьми и не бояться оставлять их наедине с Астрой. \nВерная, смышленая, добрая Астра:','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_27295/astra_0_5dabf629139a1.jpg',367,363,NULL),(338,'Жасмин','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','28','Хорошее','Знакомьтесь -это Жасмин.\nЭта прекрасная, замечательная девочка так давно ждет своих родителей, что мы уже не знаем, к каким приемам прибегнуть, как о ней рассказать, как ее описать, чтобы она получила шанс хотя бы на знакомство с семьей.\nК сожалению фото не передает ту энергию и харизму, которая томится в вольере нашего приюта. Жася необычайно ласковая и нежная собака, отлично ходит на поводке, позитивная и игривая. Она очень нуждается в человеке, поэтому не хочет делить любовь и редкое внимание с конкурентами. Она умеет любить и ценить, она готова генерировать за пятерых собак то счастье, что эти животные умеют дарить.\nПросто приезжайте к ней в гости и вы сами все увидите.\nЖасмин здорова, стерилизована, молода (3,5 года)\nТатьяна 8929 567-52-42','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_35505/zhasmin_0_5f23e98816299.jpg',368,364,NULL),(339,'Бублик','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Охранник','Беспородная','Короткая','Рыжий','12','Хорошее','Бублик отличный охранник для частного дома.\nИгривый, верный, добрый мальчик. Ему 2-3 года.\nБыл спасен с улицы с переломаной лапой. \nНа время реабилитации его взяли на передержку, а сейчас ему нужен постоянный дом и любящий, ответственный хозяин','Активный','Сдержанный','Равнодушное','Доброжелательное','Доброжелательное','Вольер','- не уточнено -','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_37713/bublik_0_5f8830ac6c347.jpg',369,365,NULL),(340,'Гита','Ищет дом','Женский','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','Очаровашка Гита. Она настолько обаятельна, что перед ней трудно устоять. А её мелкие шалости, которыми она славится ещё со щенячьих времён, лишь вызывают улыбку. Волонтёры приюта любят вспоминать, как проказница Гита, будучи совсем маленькой, пробралась из щенятника в кормовую и с триумфом в глазах за обе щёки уплетала корм. \nГита настолько человекоориентированная собака, что без ощущения его рядом нашей девочке просто невозможно. Ей жизненно необходим тот, кому она в любую минуту может рассказать о своей преданности и любви, обнять, поцеловать или просто прижаться и почувствовать тепло человеческого тела. Гита готова на любой цирковой трюк при встрече с человеком, лишь бы привлечь к себе внимание и вы взяли её на прогулку. Ей четыре года. Это отличный возраст для собаки. Гита знает, как вести себя на прогулке и легко подстроится под ваш ритм жизни. Гиточке нужна семья. Собака, которая настолько любит человека, просто не может так долго находиться в приюте. Загляните в глаза Гиты: «Мама, я тебя так давно жду. Скорее уже приезжай за мною».','Спокойный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_33970/gita_0_5ee2aa38ea2ce.jpg',370,366,NULL),(341,'Лурдес','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Палевый','18','Хорошее','Если бы у собак был свой кинематограф, то Лурдес играла бы Лару Крофт, расхитительницу человеческих сердец! Ее внешность притягивает: мягкая, гибкая походка, проницательный взгляд и гордая осанка. И это лишь вершина айсберга – за ней скрывается безграничная любовь к миру и особенно, человеку. Лурдес очень тактильная, ласковая и способная собака. Она отличный дипломат и компаньон, поэтому впишется в любую – самую лучшую – семью;) Лур игрива, внимательна и активна, как главная героиня Вашего любимого приключенческого фильма. Сокровище больше не может ждать, влюбляйтесь и забирайте!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_27120/lurdes_0_5da707f3c9571.jpg',371,367,NULL),(342,'Симка','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','- не уточнено -','Хорошее','Симка, 1,5 года.\nСобака-удивляка: любит внезапно задуматься над тем, что увидела, даже если это просто птичка или велосипед. Симка не любит шума, толпы и суеты, по природе она неторопливая, спокойная. Дистанцию сокращает постепенно, знакомым доверяет безоговорочно, ласковая, но не навязчивая. На поводке ходит хорошо, с остановками, чтобы удивиться. Отдается в квартиру/дом по договору ответственного содержания, с возможностью ненавязчивого отслеживания судьбы. Находится в Зеленоградском муниципальном приюте.','Спокойный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_21227/simka_0_5d9b012c45a17.jpg',372,368,NULL),(343,'Бублик','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Белый','17','Хорошее','Ищет дом молодой, активный парень Бублик.\nЕму не более 3 лет.\nЗамечательно ладит с людьми, любит детей.\nПрибился к стае собак в сентябре 2018, очевидно, что до этого был домашним, его просто предали.\nВ стае отношения не сложились, нападали сородичи . Было принято решение отдать Бублика на передержку, т.к в стае ему не выжить.\nВот уже пол года он живет на платной передержке, но это временное жилище, а ему просто необходима семья.\nОбучен командам, приучен к выгулу, туалет строго на улице. Идеально подойдёт для жизни как в частном доме (строго не будка, не цепь), так и в квартире.\nПривит, здоров, отработан от всех паразитов.\nОн замечательный пёс, приезжайте знакомиться, я уверена, что он не оставит вас равнодушными! Он очень ждёт.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_26831/bublik_0_5d9b2c1c5744a.jpg',373,369,NULL),(344,'Гретта','Ищет дом','Женский','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','19','Хорошее','г.Ногинск МО. \nОчень умная  девочка Гретта 1,5 года от роду ищет добрые руки! \nСобачка замечательная, умная, добрая, адекватная, без агрессии, знает команды \"Сидеть\" и \"Лежать\", отличная охранница. \nОчень похоже, что бывшедомашняя, знает место, не боится заходить в будку. \nСейчас живет на территории предприятия. \nСтерилизована, обработана от паразитов.\nЕсли Вы решили завести собаку, обратите, пожалуйста, свое внимание на эту девочку, возможно, это Ваш самый преданный друг на долгие годы.\nТел.  Елена','Спокойный','Общительный','Равнодушное','Может проявить агрессию','Доброжелательное','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_30251/gretta_0_5e3044b980c17.jpg',374,370,NULL),(345,'Варя','Ищет дом','Женский','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','15','Хорошее','Варя - скромная и нежная девочка  остро нуждается в своей семье. Рост 45 см. Умная, уравновешенная, сообразительная и послушная. Будет лучшей подружкой всем членам семьи и питомцам. Варя  рассудительная, очень легко обучается, любознательная. Играть, конечно, тоже любит, но без фанатизма и гиперактивности - всё в меру. Очень обаятельная девочка. Варя очень ценит общество человека. Будет очень преданным и верным другом. К выгулу приучена . Здорова, привита, стерилизована. Есть паспорт. Кушает натуралку и консервы. Отдаётся по договору добрым и ответственным людям.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_8498/varya_0_5d49ef385ba60.jpg',375,371,NULL),(346,'Юла','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Черный','19','Хорошее','Юля (Юла) ❤ У вас есть дети и большая активная семья? или может быть, совсем наоборот, жизнь ваша затянулась болотной ряской и потеряла краски? Тогда Юлечка – как раз для вас, ваша новая подружка, ваш счастливый билетик в новую жизнь, жизнь, полную невероятных красок, впечатлений и открытий??  Юля – сгусток живой энергии, перпетум мобиле, вечный праздник? Юркая, живая, озорная, шустрая, любознательная, безбашенная, как все щенки?‍♂ Ей интересно все вокруг, поэтому ей надо все успеть: понюхать, попробовать, побежать, поцеловать, обнять всех и подставить свое белое очаровательное пузико всем, потому что в нее невозможно не влюбиться сразу, с первого взгляда. Так что «Держите меня семеро!». Иначе…, а иначе просто приезжайте знакомиться с Юлечкой, Юлей, Юлой❤ Ей всего 6 месяцев, вырастет небольшого квартирного размера, до колена. Привита, здорова. Москва, ближайшее метро Пражская или Аннино.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_30274/yula_0_5e3111528b7b0.jpg',376,372,NULL),(347,'Роксана','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','10','Хорошее','Доброе утро, друзья ❤! Мы к Вам с предложением, от которого невозможно отказаться. Совершенно бесплатно и в добрые руки отдается Голубоглазая красавица Роксана. Девочка обладает завораживающим взглядом, веселым характером и потрясающей харизмой!  Девочке около 3-х лет, совершенно адекватная, здоровая, стерилизована, приучена к поводку и очень активная! Только вот пока совсем одинокая ?. Кто готов поменять её судьбу? Кто готов обогреть и показать счастливую жизнь? Роксана - это воплощение красоты, любви и неординарности! Кому такую красоту? ?','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_13516/roksana_0_5d3ab2cd3dfc8.jpeg',377,373,NULL),(348,'Ачер','Ищет дом','Мужской','7 месяцев','Нет','-не уточнено-','Средний','Семейная','Метис','Длинная','Черный','10','Есть небольшие проблемы','Пристраиваю щенка метис немецкой овчарки родился 17.08.2020 года без документов желательно на дачный участок или на охрану территории, знает команды сидеть, лежать, дай лапу. К ошеннику  прирученный, отдам вместе с шлейкой и с поводком. Оппетит у него отменный. Пристраиваю с связи и-за работы. Хорошо уживается с домашными животными. Ачер ну прям как мишка плюшевый будет верным и преданным пёселем, можно в дом где проживает семья с детишками старше 10 лет, к малышам не сдоверием может напугать ребёнка своим громким лаем, а так он очень добрый и няшный которого можно пожмякать сколько угодно, желательно в добрые рукки и любищию семью где у него будет еда и лакомства, ласка и забота','Активный','Сдержанный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41146/acher_0_6043d19cd348e.jpg',378,374,NULL),(349,'Вита','Ищет дом','Женский','7 месяцев','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Белый','3','Хорошее','Ищу дом и заботу для Виталины, спокойная и смышленная девочка.\nОбработана, привита, есть паспорт.\nГладкошерстная, подойдет для жизни в квартире.\nВырастет небольшой, ниже колена, до 12 кг.\n\nДоставлю по Краснодару и всему КРАЮ!','Спокойный','Общительный','Доброжелательное','Доброжелательное','Равнодушное','Квартира','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_39065/vita_0_5fcc0f7ecaf4e.jpg',379,375,NULL),(350,'Айна','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Палевый','13','Хорошее','Маленькая Айна ищет добрые руки. Айна - метис джек-рассел-терьера, была спасена волонтерами. \n1 год.\nРост в холке 41 см, вес 12 кг.\nСтерилизована.\nУ Айны очень добрый характер. Она неконфликтная, активный, любознательная. Айна готова к жизни в семье.\nК поводку и выгулу приучена. Активная, любит людей. Ласковая. Умеет играть.','Спокойный','Общительный','Равнодушное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_40791/ajna_0_602e7deedfbc9.jpeg',380,376,NULL),(351,'Честер','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','25','Хорошее','Очаровательный красавец-брюнет в ожидании напарника по жизни коротает время в нашем приюте. Обладает задористым весёлым темпераментом, с новыми людьми слегка застенчив. Станет вам замечательным другом и надёжным членом семьи!\nЧестер мальчик умный и очень чуткий к людям. В приюте живёт с детства, любимец волонтёров и почётный участник каждого выгула??. Он замечательный молодой пёс, которому очень-очень нужны хозяева! \nПарнишке 3 года, 56 см в холке, он привит и кастрирован. Ему очень бы хотелось стать чьим-то другом и заиметь свой уютный уголок.\nЕсли вы хотите познакомиться с этим замечательным псом, то не теряйте времени, а скорее заполняйте анкету\n...','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41410/chester_0_605460e52fa8e.jpg',381,377,NULL),(352,'Шериф','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','40','Хорошее','Красавец-добряк Шериф давно мечтает найти семью!!!\n\nШерифу 5 лет, он крупный и красивый пес! Мальчик очень ласковый, компанейский и послушный. Отлично знает поводок и слушается безупречно! По размеру - большой и плюшевый мишка, с которым хочется лежать в обнимку и смотреть телевизор дома)\n\nПо характеру - спокойный, уравновешенный, очень ценит общение с человеком и будет самой преданной собакой. Шериф - настоящее сокровище! Приезжайте и познакомьтесь с ним. \nМальчику 5 лет, он здоров, привит, кастрирован, отлично ходит на поводке!','Спокойный','Общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_24652/sherif_0_5d362d5f961ca.jpg',382,378,NULL),(353,'Бурёнка','Ищет дом','Женский','5 лет','Да','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Белый','- не уточнено -','Хорошее','Бурёнка в меру активная и ласковая собака, отсутствие одной лапки никак ей не мешает в жизни, она точно так же, как и остальные собаки бегает и играет. Она ненавязчива к людям, но любопытна к окружающему миру, прогулки для неё это самое любимое занятие. Вместо активных игр она выберет прогулки по парку. С остальными представителями «собачьих» она нейтральна, любит пообнюхиваться при встрече. На прогулке изучает местность, к прохожим людям равнодушна. К незнакомым людям привыкает постепенно, ей нужно время, чтобы познакомиться и доверять им. Бурёнка готова обучаться базовым командам, ориентирована на человека и лакомства.\nЭто собака для людей, ведущих спокойный образ жизни, которые выезжают на дачу и на природу, для тех, кто будет ценить ее такой, какая она есть, а у неё чудесный характер. Может быть второй и последующей собакой в семье, к детям относится хорошо.','Спокойный','Супер-общительный','Доброжелательное','- не уточнено -','Равнодушное','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_33739/burjonka_0_5ed795a043ace.jpg',383,379,NULL),(354,'Юкос','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Рыжий','21','Хорошее','Юкос- роскошный, молодой, воспитанный, благородный паренек. Метис овчарки. Юкос обладатель необычного медового окраса  и красивого, соболиного хвоста. Стоячие ушки и темная морда делает его несомненно красавцем!  Мальчику около года. \nСмышленый,  послушный,  ласковый, настрящий друг и компантон! Понимает человека с полуслова.\nИгры, прогулки, обнимашки  с человеком любимое занятие паренька, жаль, что в приюте это крайне редко. Юкос собака, которая несомненно  должна жить в семье! \nМальчик  легко приспособиться к новым условиям проживания в квартире. Юкос привит, кастрирован, здоров.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_40671/yukos_1_6027720c4d105.jpg',384,380,NULL),(355,'Амая','Ищет дом','Женский','11 месяцев','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','10','Хорошее','Амая - самый настоящий май: нежная как цветущая сирень, ласковая как первый теплый ветерок и чудесная как восход на безоблачном небе. В силу своего малого возраста, она очень активная девочка, готова бежать за хозяином хоть на край света и быть неутомимым спутником в любых начинаниях. Её милые ушки, мягкая, нежная щенячья шерстка, так и манят затискать, обнять и никуда не отпускать этого милого ребёнка. Порадовать ее совсем не сложно, а довольный танцующий хвостик будет верным подтверждением её намерений. «Амая – гулять!» - и вы погружаетесь в ее радостные объятия и теплые поцелуи. Ее чистая душа всегда рада принять кучу ласки, поиграть в догонялки и готова в ответ дарить любовь хозяину, который возможно уже читает этот текст. Приезжайте скорее знакомится с Амаей и в вашем сердце навсегда поселится тепло майского солнца.','Активный','Общительный','Доброжелательное','Доброжелательное','Равнодушное','Вольер','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_38505/amaya_0_5faec0f6af856.jpg',385,381,NULL),(356,'Ромул','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Рыжий','20','Хорошее','Ромке год с небольшим, а он ведёт себя как будто уже седина в голову. Шучу. Просто степенный пирожочек. Там где все носятся, сломя голову, он найдёт уютное место присесть, а лучше прилечь и думать о жизни, читать истории по запахам. Он конечно, станет прекрасным компаньонам, которые за размеренный ритм прогулки, ведь жизнь слишком прекрасна, чтобы торопиться. Ромул чуть-чуть боится незнакомых собак и может залечь, но проработав его уверенность, вы увидите, что он как лучик солнца будет носиться со своими друзьями, не забыв оглянуться на вас во время игры. \nЕщё он - чистюля, лужу он предпочтёт обойти. Он идеален для путешествий, потому что просто будет ехать без притязаний на руль. Очень хороший, очень кому-то повезёт.','Спокойный','Общительный','Равнодушное','Равнодушное','Равнодушное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_37369/romul_0_5f79ec99b5458.jpg',386,382,NULL),(357,'Чейз','Ищет дом','Мужской','4 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Коричневый','25','Хорошее','Красавчик Чейз мечтает о семье!\n\nУ мальчика совершенно очаровательный характер! Он очень добрый, ласковый и трогательный. Чейз обожает проводить время с людьми и на прогулках совмещает изучение новых мест с обязательной порцией внимания в объятиях человека.\n\nЧейз прекрасно ладит с детьми, другими собаками и уверены, что с кошками тоже не будет проблем. Он чудесный искренний мальчик, которому ну очень нужно домой!\n\nЧейзу 3 года, он здоров, привит, кастрирован, хорошо ходит на поводке, с удовольствием вычесывается, даёт лапу и влюблённо смотрит в глаза))\n\nЗвоните и приезжайте знакомиться!','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_25413/chejz_0_5d5bd642a3c78.jpg',387,383,NULL),(358,'Того','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Серый','10','Хорошее','Трёхлетний бородач Того, ищет себе компаньона для самых интересных прогулок и приключений. Того невообразимо фотогеничный, самые шикарные селфи только с ним! Ласковый, прыгучий и в меру игривый. Любвеобильный красавчик, любящий гулять в любой компании и всегда за любой движ. Ему не хватает своего человека, так как только с ним он сможет быть собой и полностью раскрыться. Того целовательный и обнимательный парень, будет отличным другом для всей вашей семьи и самым лучшим напарником для детей.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_41252/togo_0_604a857e7dd25.jpeg',388,384,NULL),(359,'Норд','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Средний','Семейная','Породистая','Средняя','Серый','7','Хорошее','Ищет дом и любящих хозяев Хаска Норд. Веселый , активный , ласковый к людям. С собаками дружит , но умеет за себя постоять. Здоров , привит, кастрирован , хорошо гуляет на поводке , знает машину. Хаски ездовые собаки, поэтому нуждается в активном выгуле.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Равнодушное','Квартира','Да','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_39372/nord_0_5fdcab48bbc66.jpeg',389,385,NULL),(360,'Норд','Ищет дом','Мужской','10 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','4','Хорошее','Лучезарный щенок очень мечтает скорее оказаться домашним и любимым. Малышу около двух месяцев, обработан от паразитов и готовится к первой прививки. Кушает сухой корм.','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_36070/nord_0_5f3e55fd11e9d.jpeg',390,386,NULL),(361,'Малышка','Ищет дом','Женский','3 месяца','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Коричневый','8','Есть небольшие проблемы','Двухмесячная малышка ищет новый дом. Нет возможности оставить у себя. Ласковая, нуждается в помощи ветеринара. Т.к. маленький возраст, можно всему обучить, характер спокойный, любознательная.','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_41052/malyshka_0_603f8b180dd9b.jpg',391,387,NULL),(362,'Черныш','Ищет дом','Мужской','10 месяцев','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','4','Хорошее','Прекрасный щенок Черныш в дар!\nМосква и МО.\nЕму 2,5 месяца. Гладкошерстный щенок, похожий на лабрадора. Вырастет некрупным, по колено.\nЧерныш очень активный и дружелюбный маленький пес. При моем появлении так виляет хвостиком, что кажется, хвост оторвется. Целыми днями готов играть и скакать. На то он и щенок! Когда вырастет, будем верным другом и защитником, чувствуется ум.\nСо здоровьем проблем нет.\nПриезжайте знакомиться с щеночком!\n89859509360 Марина(есть ватсап).','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_37065/chernysh_0_5f6c6c166aca0.jpg',392,388,NULL),(363,'Гелла','Ищет дом','Женский','1 год','Нет','-не уточнено-','Средний','Семейная','Метис','Короткая','Рыжий','- не уточнено -','Хорошее','Красотка Гелла, кажется, прячет в себе небольшой атомный реактор.  Она игривая, импульсивная, быстро принимающая решения — и в добавок ко всему — лидер стаи. Гелла — просто идеальное отражение современной женщины — уверенной и яркой.\nНо, как всегда бывает, за сильным и немного жестким характером прячется нежность и ранимость — так произошло и с Геллой. В стае она — несдержанная и решительная, но с людьми — зависимая и доверчивая. Гелла полностью полагается на человека и надеется найти того, кто полюбит ее именно такой. А она в свою очередь, обещает разнообразить серые будни и стать вашим рыжим лучиком солнца.','Активный','Общительный','Доброжелательное','- не уточнено -','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_33017/gella_0_6023d11cd61fe.jpg',393,389,NULL),(364,'Норд','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Серый','20','Хорошее','Норд - пес ниже среднего размера. При этом он выглядит очень уверенно. Его стоячие ушки и хвост всегда на чеку.\n2 года, на прогулках активный. С человеком общается отлично, готов со всеми подружиться!\nЕсли вы активный позитивный, то забирайте нашего Норда на тёплую лежанку!\nПривит, кастрирован.','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_42341/nord_0_60942639e61b3.jpg',394,390,NULL),(365,'Пальма','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','Пальма - современная молодая особа с активной жизненной позицией. Молода, красива и умна, инициативна и позитивна. Энергичная и веселая, компанейская и абсолютно надежная собака. Пальма хороша собой, девчонка с особенной харизмой и обаянием, есть в ней какое-то неуловимое очарование: умилительная мордашка, чудный мокрый нос, бровки \"домиком\", выразительные глаза коньячного оттенка с внимательным выражением. Возраст: 2 года. Здорова, привита, стерилизована. Размер средний (50 см в холке, 25 кг). Приучена к поводку и выгулу. Ладит с другими собаками. Познакомиться с девочкой можно в МО, ближайшее м. Кунцевская.','Активный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_8307/palma_0_595493c423ef1.jpg',395,391,NULL),(366,'Рута','Ищет дом','Женский','1 год','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','35','Хорошее','Большая красавица РУТА не так давно пришла к воротам приюта. Внимательно осмотрелась и, как водится, решила остаться.\nСобака - роскошный лайнер или баржа. РУТА крупная, рост около 70см в холке. Цифры на весах нервничали и все-таки остановились на значении 39,8кг. Редкая штучка. Возраст около 1 года.\nЗадумчива. О неизвестном нам, невесёлом прошлом или же о будущем...? Никогда не торопится. Всегда внимательно слушает, многое понимает. И будто подсказывает, как именно с ней лучше: погладить по макушке или почесать за ухом, как обнять) Сама задаёт мерность нашему общему шагу, держится рядом на идеально-комфортном расстоянии. Исключительная мягкость в повадках.\nО многих подопечных мы готовы сказать подобное, но РУТА .... изумительно-родная сразу. Присядешь, раскроешь ладони навстречу, и ее голова верно неспешно расположилась так, что отпустить невозможно. Спокойно и хорошо.\nА РУТА сама была бы счастлива замереть в тёплых объятиях своего человека. Только бы найти... достучаться.... долететь ее фотографиям до нужного сердца...\nВы можете в любое время приехать в приют познакомиться с РУТОЙ. Звоните.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_40943/ruta_0_6037ece0af735.jpg',396,392,NULL),(367,'Дилли','Ищет дом','Женский','4 года','Нет','-не уточнено-','Средний','Семейная','Породистая','Короткая','Белый','26','Хорошее','В добрые руки пристраивается чудесная девочка Дилли! Возраст - 4 года.\nДилли - шикарнейшая собака❤️ Помимо безупречной красоты она обладает железнобетонной психикой. Явной агрессии ни к собакам, ни к кошкам нет. Но не со всеми собаками готова дружить, поэтому прежде чем брать её второй собакой в семью, девочку предварительно нужно знакомить с Вашей собакой. Видно, что она росла в любви и заботе, и новой семье останется лишь пожинать плоды хорошего воспитания. Попадание в приют не вызвало у этой пухляшки никакого стресса. Дилли активна, весела и готова общаться с каждым, кто обратит на неё внимание))) Эта обояшка очень социальна и общительна - готова стать душой любой компании и сердцем любящей семьи ❤Без внимания она очень скучает, прям не хочет идти в свой вольер((( Кстати эта кнопа обладает очень компактным размером. Где же вы самые лучшие мамы и папы для девочки?! Дилли стерилизована, привита, имеет ветеринарный паспорт, отдается бесплатно по договору ответственного содержания, людям старше 25 лет, без материальных и жилищных проблем, в Москву или МО. Если малышка запала Вам в душу, то звоните нам и приезжайте к ней знакомиться!)','Активный','Общительный','Доброжелательное','Доброжелательное','Может проявить агрессию','Квартира','Да','Да','Да','Частный приют','https://podberi-sobaku.ru/uploads/pes_39579/dilli_0_603dfb3febcd6.jpeg',397,393,NULL),(368,'Мила','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','20','Хорошее','Мила ищет дом!\nМожет её необыкновенный взгляд запал Вам в душу?\n\nМила добрая и ласковая собака.\nНе потеряла веру в людей и любит общаться.\n\nМиле 1 год, ладит с сородичами, дружит с котиками.\nПриучена к выгулу. Быстро всему учиться, заниматься с ней одно удовольствие.\nМожно в семью с другими животными и детьми.\nСтерилизована, здорова.\n\nЖдёт свою добрую и надёжную семью на домашней передержке (г.Москва/Реутов).\nВы можете приехать и познакомиться с Милой!','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_30307/mila_0_5e32c786581bf.jpg',398,394,NULL),(369,'Лана','Ищет дом','Женский','2 года','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Черный','19','Хорошее','Лана метис овчарки 7-ми месяцев. Здорова, привита, стерилизована. Приучена к 4-х разовому выгулу. Вырастет средней собакой  примерно 55 см в холке.\nПознакомиться с Ланой можно недалеко от м. Славянский бульвар','Спокойный','Общительный','- не уточнено -','Доброжелательное','Доброжелательное','Квартира','Да','Да','- не уточнено -','Передержка','https://podberi-sobaku.ru/uploads/pes_25694/lana_0_5d67cd57a5fd2.jpg',399,395,NULL),(370,'Скай','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Крупный','Семейная','Беспородная','Короткая','Черный','- не уточнено -','Хорошее','В силах ли мечта дворняги затронуть людские души?\n\nВы видели что-нибудь милее, чем взгляд Ская? Будто маленький ребенок, который просит игрушку и посидеть на ручках у мамы. Скай - озорной подросток, ему хочется постоянно бегать, прыгать на своего человека, приглашая принять участие в веселой игре. Он любит уткнуться своим мокрым носом человеку в волосы и мечтать о чем-то своём. Скай освоил премудрости жизни в мегаполисе, дружелюбен к собратьям и чтобы не заскучать знает несколько трюков и он готов обучаться дальше!\nСкай - ребёнок, который познает мир, открывает новые горизонты и загадывает вновь одно желание, глядя на белые, такие неприступные, облака. Насладиться детством , а не воевать каждый день за право жить','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','- не уточнено -','Да','- не уточнено -','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39799/skaj_0_60392d5a1bff3.jpg',400,396,NULL),(371,'Никос','Ищет дом','Мужской','9 месяцев','Нет','-не уточнено-','Средний','Семейная','Метис','Средняя','Серый','5','Хорошее','Никос , 2,5 месяца . Обработан от паразитов . По результатам анализов здоров. Очень ласковый и славный малыш .','Активный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Загородный дом','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_37595/nikos_0_5f81da8615cdd.jpeg',401,397,NULL),(372,'Сэм','Ищет дом','Мужской','3 года','Нет','-не уточнено-','Крупный','Семейная','Метис','Короткая','Серый','32','Хорошее','СЭМ.\nХороший пес с красивым экстерьером.\nНемного насторожен поначалу. Уверен, что раньше люди его сильно обижали. Присматривается, оценивает. \nНо когда понимает, что ты друг, становится ласковым и игривым. Преображается на глазах.\nКрасивый. Крупная голова, крепкое тело. Сильный.\nЛюдей, тех, которым доверяет, обожает. Любит вкусняшки, прогулки и всякую возню. Становится игривым и озорным.\nС собаками по-разному. Вначале не очень подпускает, но потом готов играть.\nХороший охранник. Защищает своих и территорию. Но делает это без агрессии, а достойно и уверенно, потому что так надо.\nМожет жить и в квартире, и в доме.\nБудет замечательным другом и компаньоном.','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Равнодушное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_34073/sem_0_5ee63824d1d6d.jpg',402,398,NULL),(373,'Волчок','Ищет дом','Мужской','2 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Серый','25','Хорошее','В начале мая 2019 Волчок и шестеро его братьев и сестер были спасены от неминуемой смерти в заваленной камнями яме. Волчку сейчас 14 мес, любознательный и веселый подросток. 24кг, в холке по колено. Волчок обработан, привит, кастрирован и готов к скорейшему  переезду домой :)','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_23266/volchok_0_5dcc6e0a62654.jpeg',403,399,NULL),(374,'Кира','Ищет дом','Женский','6 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Черный','75','Хорошее','\"А это кто к нам в гости?\" – как будто спрашивает наша красавица Кира. Каждый ваш визит для неё - настоящий праздник, ведь её сосиской не корми – дай пообниматься! Такую нежную и задушевную подругу, как Кира, можно только поискать – звоните скорее, чтобы с ней познакомиться!','Активный','Супер-общительный','Доброжелательное','Может проявить агрессию','Может проявить агрессию','Квартира','- не уточнено -','Да','- не уточнено -','Частный приют','https://podberi-sobaku.ru/uploads/pes_33947/kira_0_5ee211b909016.jpg',404,400,NULL),(375,'Робби','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Коричневый','3','Нет','Маленький медвежонок ищет своих маму и папу! Ласкавая,  игривая с очень интересным тигровым окрасом. Ее родители собаки совсем небольшого размера,. Девочка живёт на стройке на улице, ее братья и сестры к сожалению уже погибли, т.к. это очень опасное место((( нужно срочно забирать малышку домой','Активный','Общительный','- не уточнено -','- не уточнено -','Доброжелательное','Квартира','Нет','Нет','Нет','Передержка','https://podberi-sobaku.ru/uploads/pes_30669/robbi_0_5e442e022f4ef.jpg',405,401,NULL),(376,'Ульяша','Ищет дом','Женский','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Средняя','Белый','15','Хорошее','Ульяша ✨ ⠀ Смешной кабачок с умными и трогательными глазками❤️ Ранимая девочка,  всего опасается. Мы не знаем, что пришлось пережить этой девочке, но когда она пугается-прижимается к земле и замирает?  Ладит с другими животными, людям доверяет,  но будто ожидает какого-то подвоха. Ульяша не крупная, ниже колена? Возраст примерно 3 года. Привита, стерильна и готова стать домашней❤️ ⠀ Ульяша #домашний_ульяша участвует во флешмобе #песнасчастье2020','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_30272/ulyasha_0_5e310f1b43256.jpg',406,402,NULL),(377,'Ярик','Ищет дом','Мужской','1 год','Нет','-не уточнено-','Крупный','Охранник','Метис','Короткая','Коричневый','40','Хорошее','Ярик, проставлены все прививки, кастрирован, питается сухим кормом, крупный около 40 кг. 1 год и 5 месяцев, воспитанный, команды схватывает на лету, очень умный. Только в хорошие руки в частный дом, для охраны.','Активный','Сдержанный','Равнодушное','Равнодушное','Может проявить агрессию','Вольер','Да','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_36582/yarik_0_5f5781cb8679f.jpg',407,403,NULL),(378,'Моника','Ищет дом','Женский','3 года','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','18','Хорошее','Кроткая и тихая собака. Нежная, добродушная, ласковая девочка. Искусно стреляет многозначительными взглядами, выманивая ласку и вкусняшки. При грамотном воспитании станет чудесной и сообразительной собакой-компаньоном.\nОчень человекоориентирована и с большой долей уверенности можно сказать, что Монька не будет против соседей котиков и уж точно не ввяжется в драку с сородичем. \nДевочке 3 года., стерилизована.\nМоника среднего размера, здорова, и готова открыть свое сердце человеку, на которого можно положить лапу, когда становится страшно, и вместе с ним открыть такой интересный мир. \n8(985)440-31-21 Лариса\n8(926)471-17-10 Светлана','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Передержка','https://podberi-sobaku.ru/uploads/pes_35320/monika_0_5f1ad517aebb0.jpg',408,404,NULL),(379,'Шанель','Ищет дом','Женский','5 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Средняя','Черный','23','Хорошее','Шанель - красавица, похожая на маленькую овчарочку! Совсем молоденькая, ей около 4-х лет. В холке - около 50 см. Стерилизована. Сейчас живет в приюте. Ребенок, просто совсем еще ребенок. Милый, трогательный, ранимый, жизнерадостный ребенок. Шанель отлично ладит с другими собаками. Очень ориентирована на человека. Подойдет в семью с детьми, а также второй собакой в дом. Звоните! Территориально - м.\"Выхино\".','Спокойный','Общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30766/shanel_0_5e47d2e32cc50.jpg',409,405,NULL),(380,'Дюна','Ищет дом','Женский','4 года','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Серый','18','Хорошее','Вот такая красавица и умница сейчас Срочно ищет новый дом. Мы назвали ее Дюна. Ей около  3лет. В холке - около 50 см. Стерилизована . Очень ориентирована на человека, ласковая, позитивная, общительная девочка. С другими собаками ладит, на поводке не тянет. Дюна - небольшая собачка она отлично впишется в любую квартиру! Очень послушная. Вот такая эта девочка! Звоните и приезжайте с ней знакомиться! Территориально - м. \"Царицыно\".','Спокойный','Супер-общительный','Доброжелательное','Доброжелательное','Доброжелательное','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_30780/dyuna_0_5e47fff65ebd8.jpg',410,406,NULL),(381,'Бабася','Ищет дом','Женский','11 лет','Нет','-не уточнено-','Небольшой','Семейная','Метис','Короткая','Рыжий','15','Хорошее','Необыкновенная девочка Бабася ищет дом!❤ \nБабася -умняга и красавица, очень спокойная и строгая девушка? \nКогда-то давно Бабася была домашней, поэтому знает основные команды, умеет ходить на поводке, внимательно слушает человека. \nК собакам весьма избирательна, к кошкам относится спокойно. \n\nУ Бабса явно имеются родственники среди бультерьеров? \nВообще, Бабас -совершенно потрясающая собака, несмотря на серьезный вид, она очень ласковая, любит, когда ей чешут пузцо, а уже как она любит поееестььььь? а какие у нее ушкииии, ну,совершенно неповторимые!!! \n\nБабасе примерно  10 лет, она очень компактная, не больше 40 см в холке, здорова, стерилизована. \nДевчуля ждет именно Вас в приюте в Бирюлево  \n\n\n#надобрать_бабася','Активный','Супер-общительный','Доброжелательное','Равнодушное','Может проявить агрессию','Квартира','Нет','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_16938/babasya_0_5f22656f3c244.jpg',411,407,NULL),(382,'Дина','Ищет дом','Женский','1 год','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Палевый','7','Хорошее','Дина-девочка,привита,стерилизована.Возраст 11 месяцев.Очень добрая,ласковая.Рост 45 см. Находится в Кожуховском приюте. Ждёт и надеется.','Спокойный','Общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_39885/dina_0_5ffdfcf2ee3c2.jpeg',412,408,NULL),(383,'Буч','Ищет дом','Мужской','6 лет','Нет','-не уточнено-','Средний','Семейная','Беспородная','Короткая','Рыжий','25','Хорошее','Предлагаем взять в семью этого песика. Зовут его Буч. Пес очень умный , ласковый и общительный. В то же время он отличный Друг! На поводке ходит отлично, слушается человека. Буч был раньше домашним, но его вернули, т.к. пес не охранял дом. Да он не охранник, но может кому то нужен просто Друг? \nПес кастрирован, привит. Сейчас ему 5,5 года. Приезжайте за другом! \nТелефон для связи 8 960 524 57 57 Эльвира','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Нет','Частный приют','https://podberi-sobaku.ru/uploads/pes_14299/buch_0_5f64dc0097130.jpg',413,409,NULL),(384,'Астерикс','Ищет дом','Мужской','5 лет','Нет','-не уточнено-','Небольшой','Семейная','Беспородная','Короткая','Коричневый','15','Хорошее','Вы когда-нибудь смотрели фильм «Астерикс и Обеликс»? У Вас есть невероятная возможность познакомиться с одним из главных героев этого фильма!\nАстерикс - молодой и не высокий мальчишка пяти лет. Чтобы он уже к Вам привязался, всего лишь нужно почесать его пузико или дать вкусняшку, ведь путь к сердцу мужчины проходит через его желудок, не правда ли?)\nАстерикс очень активный и контактный пёс. Обниматься, прыгать, ласкаться, сидеть на ручках или просто составить компанию и смотреть на красивый закат - это все про него. Со своими сородичами ему общаться тоже легко, особенно с девчонками. С парнями, правда, может и поспорить из-за лидерских позиций :)\nАстерикс один из тех собак, которые умеют ездить в машине, но пока не с кем, но ведь эта проблема решаема! \nОн уже полностью готов к переезду в свою новую и любящую семью. \nОн кастрирован, чипирован, есть собственный паспорт.\nМожет спокойно отправляться домой с условием ненавязчивого отслеживания судьбы по договору об ответственном содержании. \nСейчас живет в приюте для собак в Щербинке (ЮЗАО, Москва), откуда вы можете совершенно бесплатно забрать в добрые руки собаку.','Активный','Супер-общительный','Доброжелательное','Равнодушное','Доброжелательное','Квартира','Да','Да','Да','Муниципальный приют','https://podberi-sobaku.ru/uploads/pes_36927/asteriks_0_5f6655eee148d.jpg',414,410,NULL);
